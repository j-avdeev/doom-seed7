(********************************************************************)
(*  doom3_seed7_cinematic.s7                                       *)
(*                                                                  *)
(*  Focused Doom 3 / id Tech 4 cinematic/video subsystem probe for *)
(*  Seed7. It reads user-owned pk4 archives, catalogs RoQ/video     *)
(*  assets, resolves map and GUI cinematic references, and emits a  *)
(*  deterministic playback/readiness contract. No commercial data   *)
(*  is bundled.                                                     *)
(********************************************************************)

$ include "seed7_05.s7i";
$ include "osfiles.s7i";
$ include "zip.s7i";

const string: DEFAULT_DATA_PATH is ".";
const string: DEFAULT_BASE_DIR is "base";
const string: DEFAULT_START_MAP is "game/mars_city1";
const integer: CINEMATIC_FRAME_MSEC is 33;

const type: cinematicConfig is new struct
    var string: dataPath is DEFAULT_DATA_PATH;
    var string: basePath is "";
    var string: startMap is DEFAULT_START_MAP;
    var boolean: showHelp is FALSE;
  end struct;

const type: cinematicStats is new struct
    var integer: pk4Archives is 0;
    var string: requestedMapPath is "";
    var boolean: requestedMapFound is FALSE;
    var integer: videoAssets is 0;
    var integer: roqAssets is 0;
    var integer: guiAssets is 0;
    var integer: guiVideoRefs is 0;
    var integer: resolvedGuiVideoRefs is 0;
    var integer: missingGuiVideoRefs is 0;
    var integer: mapEntities is 0;
    var integer: mapVideoRefs is 0;
    var integer: resolvedMapVideoRefs is 0;
    var integer: missingMapVideoRefs is 0;
    var integer: roqHeadersParsed is 0;
    var integer: roqHeaderFallbacks is 0;
    var integer: runtimeCinematics is 0;
    var integer: runtimeGuiCinematics is 0;
    var integer: runtimeWorldCinematics is 0;
    var integer: runtimeFallbackFrames is 0;
    var string: firstVideoAsset is "";
    var string: firstGuiAsset is "";
    var string: firstGuiVideoRef is "";
    var string: firstMapVideoRef is "";
    var string: firstRuntimeCinematic is "";
    var string: firstPlaybackPlan is "";
    var array string: videoAssetPaths is 0 times "";
  end struct;

const proc: logInfo (in string: msg) is func
  begin
    writeln("[cinematic] " <& msg);
  end func;

const proc: logError (in string: msg) is func
  begin
    writeln("[cinematic-error] " <& msg);
  end func;

const func string: joinPath (in string: leftPath, in string: rightPath) is func
  result
    var string: joined is "";
  begin
    if leftPath = "" then
      joined := rightPath;
    elsif endsWith(leftPath, "/") or endsWith(leftPath, "\\") then
      joined := leftPath <& rightPath;
    else
      joined := leftPath <& "/" <& rightPath;
    end if;
  end func;

const func boolean: isPk4Name (in string: fileName) is
    return endsWith(lower(fileName), ".pk4");

const func string: normalizedAssetPath (in string: filePath) is
    return replace(lower(filePath), "\\", "/");

const func string: mapNameToAssetPath (in string: mapName) is func
  result
    var string: assetPath is "";
  begin
    assetPath := normalizedAssetPath(mapName);
    if not startsWith(assetPath, "maps/") then
      assetPath := "maps/" <& assetPath;
    end if;
    if not endsWith(assetPath, ".map") then
      assetPath &:= ".map";
    end if;
  end func;

const func boolean: containsString (in array string: values,
    in string: value) is func
  result
    var boolean: found is FALSE;
  local
    var string: current is "";
  begin
    for current range values do
      if current = value then
        found := TRUE;
      end if;
    end for;
  end func;

const proc: appendUnique (inout array string: values, in string: value) is func
  begin
    if value <> "" and not containsString(values, value) then
      values &:= value;
    end if;
  end func;

const func string: cleanedToken (in string: token) is func
  result
    var string: clean is "";
  local
    var integer: idx is 1;
    var char: ch is ' ';
  begin
    clean := trim(token);
    while idx <= length(clean) do
      ch := clean[idx];
      if ch = '"' or ch = '(' or ch = ')' or ch = '{' or ch = '}' or
          ch = ',' or ch = ';' then
        clean := clean[.. pred(idx)] & clean[succ(idx) ..];
      else
        incr(idx);
      end if;
    end while;
  end func;

const func boolean: isVideoAsset (in string: path) is func
  result
    var boolean: isVideo is FALSE;
  local
    var string: lowerPath is "";
  begin
    lowerPath := normalizedAssetPath(path);
    isVideo := endsWith(lowerPath, ".roq") or endsWith(lowerPath, ".cin") or
        endsWith(lowerPath, ".ivf");
  end func;

const func string: quotedValueAfter (in string: content, in string: keyName,
    in integer: startPos) is func
  result
    var string: value is "";
  local
    var string: keyText is "";
    var integer: keyPos is 0;
    var integer: keyEnd is 0;
    var integer: valueStart is 0;
    var integer: valueEnd is 0;
  begin
    keyText := "\"" <& keyName <& "\"";
    keyPos := pos(lower(content), lower(keyText), startPos);
    if keyPos <> 0 then
      keyEnd := pos(content, "\"", succ(keyPos));
      if keyEnd <> 0 then
        valueStart := pos(content, "\"", succ(keyEnd));
        if valueStart <> 0 then
          valueEnd := pos(content, "\"", succ(valueStart));
          if valueEnd <> 0 then
            value := content[succ(valueStart) .. pred(valueEnd)];
          end if;
        end if;
      end if;
    end if;
  end func;

const func string: firstVideoRefInText (in string: content) is func
  result
    var string: videoRef is "";
  local
    var string: normalizedText is "";
    var array string: tokens is 0 times "";
    var string: token is "";
  begin
    normalizedText := replace(content, "\n", " ");
    normalizedText := replace(normalizedText, "\r", " ");
    normalizedText := replace(normalizedText, "\t", " ");
    tokens := noEmptyStrings(split(normalizedText, ' '));
    for token range tokens do
      if videoRef = "" then
        token := normalizedAssetPath(cleanedToken(token));
        if isVideoAsset(token) then
          videoRef := token;
        end if;
      end if;
    end for;
  end func;

const proc: inspectVideoContent (inout cinematicStats: stats,
    in string: path, in string: content) is func
  local
    var string: normalizedPath is "";
  begin
    normalizedPath := normalizedAssetPath(path);
    stats.videoAssets +:= 1;
    appendUnique(stats.videoAssetPaths, normalizedPath);
    if endsWith(normalizedPath, ".roq") then
      stats.roqAssets +:= 1;
      if length(content) >= 4 and content[.. 4] = "RoQ!" then
        stats.roqHeadersParsed +:= 1;
      else
        stats.roqHeaderFallbacks +:= 1;
      end if;
    end if;
    if stats.firstVideoAsset = "" then
      stats.firstVideoAsset := normalizedPath;
    end if;
  end func;

const proc: inspectGuiContent (inout cinematicStats: stats,
    in string: path, in string: content) is func
  local
    var string: videoRef is "";
  begin
    stats.guiAssets +:= 1;
    if stats.firstGuiAsset = "" then
      stats.firstGuiAsset := normalizedAssetPath(path);
    end if;
    videoRef := firstVideoRefInText(content);
    if videoRef <> "" then
      stats.guiVideoRefs +:= 1;
      if stats.firstGuiVideoRef = "" then
        stats.firstGuiVideoRef := videoRef;
      end if;
      if containsString(stats.videoAssetPaths, videoRef) then
        stats.resolvedGuiVideoRefs +:= 1;
      else
        stats.missingGuiVideoRefs +:= 1;
      end if;
    end if;
  end func;

const proc: inspectMapContent (inout cinematicStats: stats,
    in string: content) is func
  local
    var integer: searchPos is 1;
    var integer: classPos is 0;
    var string: videoRef is "";
  begin
    stats.requestedMapFound := TRUE;
    classPos := pos(lower(content), "\"classname\"", searchPos);
    while classPos <> 0 do
      stats.mapEntities +:= 1;
      searchPos := classPos + length("\"classname\"");
      classPos := pos(lower(content), "\"classname\"", searchPos);
    end while;
    videoRef := normalizedAssetPath(quotedValueAfter(content, "cinematic", 1));
    if videoRef = "" then
      videoRef := firstVideoRefInText(content);
    end if;
    if videoRef <> "" then
      stats.mapVideoRefs +:= 1;
      if stats.firstMapVideoRef = "" then
        stats.firstMapVideoRef := videoRef;
      end if;
      if containsString(stats.videoAssetPaths, videoRef) then
        stats.resolvedMapVideoRefs +:= 1;
      else
        stats.missingMapVideoRefs +:= 1;
      end if;
    end if;
  end func;

const proc: deriveRuntimeCinematics (inout cinematicStats: stats) is func
  begin
    if stats.resolvedGuiVideoRefs <> 0 or stats.resolvedMapVideoRefs <> 0 then
      stats.runtimeGuiCinematics := stats.resolvedGuiVideoRefs;
      stats.runtimeWorldCinematics := stats.resolvedMapVideoRefs;
      stats.runtimeCinematics := stats.runtimeGuiCinematics +
          stats.runtimeWorldCinematics;
      if stats.roqHeadersParsed = 0 and stats.runtimeCinematics <> 0 then
        stats.runtimeFallbackFrames := 1;
      end if;
      if stats.firstGuiVideoRef <> "" then
        stats.firstRuntimeCinematic := "gui>" <& stats.firstGuiVideoRef;
      else
        stats.firstRuntimeCinematic := "world>" <& stats.firstMapVideoRef;
      end if;
      stats.firstPlaybackPlan := "open>decode@0ms>frame@" <&
          str(CINEMATIC_FRAME_MSEC) <& "ms>loop";
    end if;
  end func;

const func array string: findPk4Archives (in string: basePath) is func
  result
    var array string: pk4Files is 0 times "";
  local
    var array string: names is 0 times "";
    var string: name is "";
  begin
    if fileType(basePath) = FILE_DIR then
      names := readDir(basePath);
      for name range names do
        if isPk4Name(name) and fileType(joinPath(basePath, name)) = FILE_REGULAR then
          pk4Files &:= joinPath(basePath, name);
        end if;
      end for;
    end if;
  end func;

const proc: scanArchive (inout cinematicStats: stats,
    in string: pk4File) is func
  local
    var fileSys: zipFs is fileSys.value;
    var array string: paths is 0 times "";
    var string: path is "";
    var string: normalizedPath is "";
  begin
    zipFs := openZip(pk4File);
    if zipFs = fileSys.value then
      logError("Could not open pk4 archive: " <& pk4File);
    else
      paths := sort(readDir(zipFs, RECURSIVE));
      for path range paths do
        normalizedPath := normalizedAssetPath(path);
        if isVideoAsset(normalizedPath) then
          inspectVideoContent(stats, path, getFile(zipFs, path));
        end if;
      end for;
      for path range paths do
        normalizedPath := normalizedAssetPath(path);
        if endsWith(normalizedPath, ".gui") then
          inspectGuiContent(stats, path, getFile(zipFs, path));
        elsif normalizedPath = stats.requestedMapPath then
          inspectMapContent(stats, getFile(zipFs, path));
        end if;
      end for;
      close(zipFs);
    end if;
  end func;

const proc: parseArgs (inout cinematicConfig: config) is func
  local
    var array string: args is 0 times "";
    var integer: argIdx is 1;
  begin
    args := argv(PROGRAM);
    while argIdx <= length(args) do
      if args[argIdx] = "--help" or args[argIdx] = "-h" then
        config.showHelp := TRUE;
      elsif args[argIdx] = "--doom3_data_path" and argIdx < length(args) then
        incr(argIdx);
        config.dataPath := convDosPath(args[argIdx]);
      elsif args[argIdx] = "--doom3_base_path" and argIdx < length(args) then
        incr(argIdx);
        config.basePath := convDosPath(args[argIdx]);
      elsif args[argIdx] = "--doom3_start_map" and argIdx < length(args) then
        incr(argIdx);
        config.startMap := args[argIdx];
      elsif args[argIdx] = "+map" and argIdx < length(args) then
        incr(argIdx);
        config.startMap := args[argIdx];
      elsif args[argIdx] = "+set" and argIdx + 2 <= length(args) then
        if args[argIdx + 1] = "fs_basepath" then
          config.dataPath := convDosPath(args[argIdx + 2]);
        elsif args[argIdx + 1] = "fs_game" then
          config.basePath := convDosPath(args[argIdx + 2]);
        end if;
        argIdx +:= 2;
      end if;
      incr(argIdx);
    end while;
    if config.basePath = "" then
      config.basePath := joinPath(config.dataPath, DEFAULT_BASE_DIR);
    end if;
  end func;

const proc: showUsage is func
  begin
    writeln("Usage:");
    writeln("  s7 doom3_seed7_cinematic.s7 --doom3_data_path <doom3-root>");
    writeln("  s7 doom3_seed7_cinematic.s7 +set fs_basepath <doom3-root> +map <map>");
    writeln("");
    writeln("Scans user-owned Doom 3 pk4 files for cinematic/video readiness.");
  end func;

const proc: printStats (in cinematicStats: stats) is func
  begin
    logInfo("pk4_archives=" <& stats.pk4Archives);
    logInfo("requested_map=" <& stats.requestedMapPath);
    logInfo("requested_map_found=" <& stats.requestedMapFound);
    logInfo("cinematic_assets videos=" <& stats.videoAssets <&
        " roq=" <& stats.roqAssets <& " gui_assets=" <& stats.guiAssets);
    logInfo("cinematic_headers roq_parsed=" <& stats.roqHeadersParsed <&
        " fallback=" <& stats.roqHeaderFallbacks);
    logInfo("cinematic_gui refs=" <& stats.guiVideoRefs <&
        " resolved=" <& stats.resolvedGuiVideoRefs <& " missing=" <&
        stats.missingGuiVideoRefs);
    logInfo("cinematic_map entities=" <& stats.mapEntities <&
        " refs=" <& stats.mapVideoRefs <& " resolved=" <&
        stats.resolvedMapVideoRefs <& " missing=" <&
        stats.missingMapVideoRefs);
    logInfo("runtime_cinematics total=" <& stats.runtimeCinematics <&
        " gui=" <& stats.runtimeGuiCinematics <& " world=" <&
        stats.runtimeWorldCinematics <& " fallback_frames=" <&
        stats.runtimeFallbackFrames);
    if stats.firstVideoAsset <> "" then
      logInfo("first_video_asset=" <& stats.firstVideoAsset);
    end if;
    if stats.firstGuiAsset <> "" then
      logInfo("first_cinematic_gui_asset=" <& stats.firstGuiAsset);
    end if;
    if stats.firstGuiVideoRef <> "" then
      logInfo("first_gui_video_ref=" <& stats.firstGuiVideoRef);
    end if;
    if stats.firstMapVideoRef <> "" then
      logInfo("first_map_video_ref=" <& stats.firstMapVideoRef);
    end if;
    if stats.firstRuntimeCinematic <> "" then
      logInfo("first_runtime_cinematic=" <& stats.firstRuntimeCinematic);
      logInfo("first_cinematic_playback=" <& stats.firstPlaybackPlan);
    end if;
    logInfo("cinematic_probe_ready=" <& (stats.pk4Archives <> 0 and
        stats.requestedMapFound and stats.videoAssets <> 0 and
        stats.resolvedGuiVideoRefs <> 0 and stats.resolvedMapVideoRefs <> 0 and
        stats.runtimeCinematics <> 0));
  end func;

const proc: main is func
  local
    var cinematicConfig: config is cinematicConfig.value;
    var cinematicStats: stats is cinematicStats.value;
    var array string: pk4Files is 0 times "";
    var string: pk4File is "";
  begin
    parseArgs(config);
    if config.showHelp then
      showUsage;
    else
      stats.requestedMapPath := mapNameToAssetPath(config.startMap);
      if fileType(config.basePath) <> FILE_DIR then
        logError("Doom 3 base directory not found: " <& config.basePath);
      else
        pk4Files := sort(findPk4Archives(config.basePath));
        stats.pk4Archives := length(pk4Files);
        if length(pk4Files) = 0 then
          logError("No .pk4 archives found in: " <& config.basePath);
        else
          for pk4File range pk4Files do
            scanArchive(stats, pk4File);
          end for;
          deriveRuntimeCinematics(stats);
          printStats(stats);
        end if;
      end if;
    end if;
  end func;
