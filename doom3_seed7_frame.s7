const proc: bindFrameEntityModel (inout frameStats: stats,
    inout frameEntity: entity) is func
  begin
    if entity.modelRef = "" then
      entity.modelRef := entityDefModelForClass(stats, entity.className);
    end if;
    if entity.animRef = "" then
      entity.animRef := entityDefAnimForClass(stats, entity.className);
    end if;
    if entity.skinRef = "" then
      entity.skinRef := entityDefSkinForClass(stats, entity.className);
    end if;
    if entity.modelRef <> "" then
      stats.frameModelRefs +:= 1;
      if modelRefResolved(stats, entity.modelRef) then
        stats.frameModelResolved +:= 1;
        if stats.firstFrameModelBinding = "" then
          stats.firstFrameModelBinding := entity.entityName <& "=" <&
              resolvedModelStem(stats, entity.modelRef);
        end if;
      else
        stats.frameModelMissing +:= 1;
        if stats.firstMissingFrameModel = "" then
          stats.firstMissingFrameModel := entity.entityName <& "=" <&
              entity.modelRef;
        end if;
      end if;
    end if;
    if entity.animRef <> "" then
      stats.frameAnimRefs +:= 1;
      if animRefResolved(stats, entity.animRef) then
        stats.frameAnimResolved +:= 1;
        addFrameAnimPlaybackSample(stats, entity.animRef);
        if stats.firstFrameAnimBinding = "" then
          stats.firstFrameAnimBinding := entity.entityName <& "=" <&
              assetStem(entity.animRef);
        end if;
      else
        stats.frameAnimMissing +:= 1;
        if stats.firstMissingFrameAnim = "" then
          stats.firstMissingFrameAnim := entity.entityName <& "=" <&
              entity.animRef;
        end if;
      end if;
    end if;
    if entity.skinRef <> "" then
      stats.frameSkinRefs +:= 1;
      if skinRefResolved(stats, entity.skinRef) then
        stats.frameSkinResolved +:= 1;
        if stats.firstFrameSkinBinding = "" then
          stats.firstFrameSkinBinding := entity.entityName <& "=" <&
              lower(entity.skinRef);
        end if;
      else
        stats.frameSkinMissing +:= 1;
        if stats.firstMissingFrameSkin = "" then
          stats.firstMissingFrameSkin := entity.entityName <& "=" <&
              entity.skinRef;
        end if;
      end if;
    end if;
  end func;

const proc: bindFrameEntitySpawnclass (inout frameStats: stats,
    inout frameEntity: entity) is func
  begin
    if entity.spawnclass = "" then
      entity.spawnclass := entityDefSpawnclassForClass(stats,
          entity.className);
    end if;
    if entity.spawnclass <> "" then
      stats.frameSpawnclassRefs +:= 1;
      if supportedSpawnclass(entity.spawnclass) then
        stats.frameSpawnclassResolved +:= 1;
        if stats.firstFrameSpawnclassBinding = "" then
          stats.firstFrameSpawnclassBinding := entity.entityName <& "=" <&
              entity.spawnclass;
        end if;
      else
        stats.frameSpawnclassUnsupported +:= 1;
        if stats.firstUnsupportedFrameSpawnclass = "" then
          stats.firstUnsupportedFrameSpawnclass := entity.entityName <& "=" <&
              entity.spawnclass;
        end if;
      end if;
    end if;
  end func;

const proc: inspectMapEntity (inout frameStats: stats,
    in string: entityBlock) is func
  local
    var frameEntity: entity is frameEntity.value;
    var string: originText is "";
    var string: angleText is "";
    var string: nextMapText is "";
  begin
    entity.className := lower(quotedValueAfter(entityBlock, "classname"));
    entity.entityName := quotedValueAfter(entityBlock, "name");
    entity.target := quotedValueAfter(entityBlock, "target");
    entity.call := quotedValueAfter(entityBlock, "call");
    entity.soundRef := firstSoundSpawnargValue(entityBlock);
    entity.modelRef := quotedValueAfter(entityBlock, "model");
    entity.animRef := quotedValueAfter(entityBlock, "anim");
    entity.skinRef := quotedValueAfter(entityBlock, "skin");
    entity.guiRef := quotedValueAfter(entityBlock, "gui");
    entity.spawnclass := quotedValueAfter(entityBlock, "spawnclass");
    originText := quotedValueAfter(entityBlock, "origin");
    if originText <> "" then
      entity.x := vectorComponentOrDefault(originText, 1, 0.0);
      entity.y := vectorComponentOrDefault(originText, 2, 0.0);
      entity.hasOrigin := TRUE;
    end if;
    if entity.className <> "" then
      stats.mapEntities +:= 1;
      if entity.className = "worldspawn" then
        addFrameGuiRef(stats, entity.guiRef, TRUE, entity.entityName);
        nextMapText := normalizedAssetPath(quotedValueAfter(entityBlock,
            "nextmap"));
        if nextMapText <> "" then
          stats.currentMapNextMapRefs +:= 1;
          if stats.firstNextMap = "" then
            stats.firstNextMap := nextMapText;
          end if;
        end if;
      end if;
      if entity.className = "info_player_start" then
        stats.playerStarts +:= 1;
        if entity.hasOrigin then
          stats.playerParsed := TRUE;
          stats.playerX := entity.x;
          stats.playerY := entity.y;
        end if;
        angleText := quotedValueAfter(entityBlock, "angle");
        if angleText <> "" then
          block
            stats.playerYaw := float(angleText);
          exception
            catch RANGE_ERROR:
              stats.playerYaw := 0.0;
          end block;
        end if;
      else
        if startsWith(entity.className, "monster_") then
          stats.monsters +:= 1;
          entity.health := entityDefHealthForClass(stats, entity.className,
              DEFAULT_MONSTER_HEALTH);
          if entity.soundRef = "" then
            entity.soundRef := entityDefSoundForClass(stats, entity.className);
          end if;
          if stats.firstMonsterName = "" then
            stats.firstMonsterName := entity.entityName;
            stats.firstMonsterClass := entity.className;
            stats.firstMonsterHealthBefore := entity.health;
            stats.firstMonsterHealthAfter := entity.health;
          end if;
        elsif isPickupClass(entity.className) then
          stats.pickups +:= 1;
          if entity.soundRef = "" then
            entity.soundRef := entityDefSoundForClass(stats, entity.className);
          end if;
        elsif entity.className = "func_door" or entity.className = "mover_door" then
          stats.doors +:= 1;
        elsif startsWith(entity.className, "trigger_") then
          stats.triggers +:= 1;
        end if;
        if entity.call <> "" then
          stats.mapCallRefs +:= 1;
          if scriptEventPathForFunction(stats, entity.call) <> "" then
            stats.mapCallEventsResolved +:= 1;
          end if;
        end if;
        bindFrameEntityModel(stats, entity);
        bindFrameEntitySpawnclass(stats, entity);
        stats.entities &:= entity;
        stats.runtimeEntities +:= 1;
      end if;
    end if;
  end func;

const proc: addBrushFromBlock (inout frameStats: stats,
    in string: blockText) is func
  local
    var array string: lines is 0 times "";
    var string: line is "";
    var string: cleanLine is "";
    var array string: tokens is 0 times "";
    var float: nx is 0.0;
    var float: ny is 0.0;
    var float: dist is 0.0;
    var float: planeValue is 0.0;
    var frameBrushBox: box is frameBrushBox.value;
    var boolean: hasMinX is FALSE;
    var boolean: hasMaxX is FALSE;
    var boolean: hasMinY is FALSE;
    var boolean: hasMaxY is FALSE;
  begin
    lines := split(blockText, '\n');
    for line range lines do
      if startsWith(trim(line), "(") then
        cleanLine := replace(trim(line), "(", " ");
        cleanLine := replace(cleanLine, ")", " ");
        tokens := noEmptyStrings(split(cleanLine, ' '));
        if length(tokens) >= 4 then
          block
            nx := float(cleanedToken(tokens[1]));
            ny := float(cleanedToken(tokens[2]));
            dist := float(cleanedToken(tokens[4]));
            planeValue := -dist;
            if nx = 1.0 and ny = 0.0 then
              box.maxX := planeValue;
              hasMaxX := TRUE;
            elsif nx = -1.0 and ny = 0.0 then
              box.minX := -planeValue;
              hasMinX := TRUE;
            elsif nx = 0.0 and ny = 1.0 then
              box.maxY := planeValue;
              hasMaxY := TRUE;
            elsif nx = 0.0 and ny = -1.0 then
              box.minY := -planeValue;
              hasMinY := TRUE;
            end if;
          exception
            catch RANGE_ERROR:
              noop;
          end block;
        end if;
      end if;
    end for;
    stats.brushBoxes +:= 1;
    box.complete := hasMinX and hasMaxX and hasMinY and hasMaxY;
    if box.complete then
      stats.completeBrushBoxes +:= 1;
      stats.brushes &:= box;
    end if;
  end func;

const proc: inspectBrushes (inout frameStats: stats,
    in string: content) is func
  local
    var string: contentLower is "";
    var integer: searchPos is 1;
    var integer: brushPos is 0;
    var integer: blockStart is 0;
    var integer: blockEnd is 0;
  begin
    contentLower := lower(content);
    brushPos := pos(contentLower, "brushdef3", searchPos);
    while brushPos <> 0 do
      blockStart := pos(content, "{", brushPos);
      blockEnd := matchingBlockEnd(content, blockStart);
      if blockStart <> 0 and blockEnd <> 0 then
        addBrushFromBlock(stats, content[blockStart .. blockEnd]);
      end if;
      searchPos := brushPos + length("brushdef3");
      brushPos := pos(contentLower, "brushdef3", searchPos);
    end while;
  end func;

const proc: inspectFrameMd5AnimContent (inout frameStats: stats,
    in string: path, in string: content) is func
  local
    var string: contentLower is "";
    var integer: frameCount is 0;
    var integer: frameRate is 0;
  begin
    contentLower := lower(content);
    if pos(contentLower, "md5version", 1) <> 0 and
        pos(contentLower, "numframes", 1) <> 0 and
        pos(contentLower, "framerate", 1) <> 0 and
        pos(contentLower, "hierarchy", 1) <> 0 then
      frameCount := integerAfterWord(content, "numframes");
      frameRate := integerAfterWord(content, "framerate");
      if frameCount <> 0 and frameRate <> 0 then
        stats.frameMd5AnimsParsed +:= 1;
        stats.md5AnimAssetStems &:= assetStem(path);
        stats.md5AnimFrameCounts &:= frameCount;
        stats.md5AnimFrameRates &:= frameRate;
      end if;
    end if;
  end func;

const proc: inspectGuiContent (inout frameStats: stats,
    in string: path, in string: content) is func
  begin
    stats.guiAssets +:= 1;
    appendUniqueString(stats.guiAssetPaths, normalizedAssetPath(path));
    if stats.firstGuiAsset = "" then
      stats.firstGuiAsset := normalizedAssetPath(path);
    end if;
    stats.guiWindowDefs +:= countWord(content, "windowDef");
    stats.guiRectDecls +:= countWord(content, "rect");
    stats.guiVisibleDecls +:= countWord(content, "visible");
    stats.guiMatcolorDecls +:= countWord(content, "matcolor");
    stats.guiOnActionDecls +:= countWord(content, "onAction");
  end func;

const proc: inspectSkinContent (inout frameStats: stats,
    in string: path, in string: content) is func
  local
    var string: contentLower is "";
    var integer: searchPos is 1;
    var integer: skinPos is 0;
    var string: skinName is "";
    var integer: blockStart is 0;
    var integer: blockEnd is 0;
    var string: blockText is "";
    var string: normalizedBlock is "";
    var array string: tokens is 0 times "";
    var integer: tokenIndex is 1;
    var string: fromMaterial is "";
    var string: toMaterial is "";
  begin
    stats.skinAssets +:= 1;
    appendUniqueString(stats.skinAssetStems, assetStem(path));
    if stats.firstSkinAsset = "" then
      stats.firstSkinAsset := normalizedAssetPath(path);
    end if;
    contentLower := lower(content);
    skinPos := pos(contentLower, "skin ", searchPos);
    while skinPos <> 0 do
      skinName := lower(declNameAfter(content, skinPos + length("skin ")));
      blockStart := pos(content, "{", skinPos);
      blockEnd := matchingBlockEnd(content, blockStart);
      if skinName <> "" and blockStart <> 0 and blockEnd <> 0 then
        stats.skinDecls +:= 1;
        stats.skinNames &:= skinName;
        blockText := content[blockStart .. blockEnd];
        normalizedBlock := replace(lower(blockText), "\n", " ");
        normalizedBlock := replace(normalizedBlock, "\r", " ");
        normalizedBlock := replace(normalizedBlock, "\t", " ");
        tokens := noEmptyStrings(split(normalizedBlock, ' '));
        tokenIndex := 1;
        while tokenIndex < length(tokens) do
          fromMaterial := cleanedToken(tokens[tokenIndex]);
          toMaterial := cleanedToken(tokens[succ(tokenIndex)]);
          if startsWith(fromMaterial, "textures/") or
              startsWith(fromMaterial, "models/") then
            stats.skinRemaps +:= 1;
            incr(tokenIndex);
          end if;
          incr(tokenIndex);
        end while;
      end if;
      searchPos := skinPos + length("skin ");
      skinPos := pos(contentLower, "skin ", searchPos);
    end while;
  end func;

const proc: inspectMapContent (inout frameStats: stats,
    in string: content) is func
  local
    var string: contentLower is "";
    var integer: searchPos is 1;
    var integer: classPos is 0;
    var integer: blockStart is 0;
    var integer: blockEnd is 0;
  begin
    inspectBrushes(stats, content);
    contentLower := lower(content);
    classPos := pos(contentLower, "\"classname\"", searchPos);
    while classPos <> 0 do
      blockStart := previousCharPos(content, '{', classPos);
      blockEnd := matchingBlockEnd(content, blockStart);
      if blockStart <> 0 and blockEnd <> 0 then
        inspectMapEntity(stats, content[blockStart .. blockEnd]);
      end if;
      searchPos := classPos + length("\"classname\"");
      classPos := pos(contentLower, "\"classname\"", searchPos);
    end while;
  end func;

const proc: summarizeNextMapForTransition (inout frameStats: stats,
    in string: content) is func
  local
    var integer: searchPos is 1;
    var integer: classPos is 0;
    var integer: blockStart is 0;
    var integer: blockEnd is 0;
    var string: blockText is "";
    var string: className is "";
    var string: entityName is "";
  begin
    classPos := pos(lower(content), "\"classname\"", searchPos);
    while classPos <> 0 do
      blockStart := previousCharPos(content, '{', classPos);
      blockEnd := matchingBlockEnd(content, blockStart);
      if blockStart <> 0 and blockEnd <> 0 then
        blockText := content[blockStart .. blockEnd];
        className := lower(quotedValueAfter(blockText, "classname"));
        if className = "info_player_start" then
          stats.nextMapPlayerStarts +:= 1;
          if stats.firstNextPlayerStart = "" then
            entityName := quotedValueAfter(blockText, "name");
            if entityName <> "" then
              stats.firstNextPlayerStart := entityName;
            else
              stats.firstNextPlayerStart := "info_player_start";
            end if;
          end if;
        end if;
      end if;
      searchPos := classPos + length("\"classname\"");
      classPos := pos(lower(content), "\"classname\"", searchPos);
    end while;
  end func;

const proc: simulateFrame (inout frameStats: stats) is func
  local
    var frameEntity: entity is frameEntity.value;
    var float: yawRadians is 0.0;
    var integer: frameStep is 0;
    var float: pathX is 0.0;
    var float: pathY is 0.0;
    var string: movementBlocker is "";
    var boolean: healthTouched is FALSE;
    var boolean: ammoTouched is FALSE;
    var boolean: weaponTouched is FALSE;
    var boolean: triggerTouched is FALSE;
    var boolean: scriptExecuted is FALSE;
    var boolean: movementBlocked is FALSE;
    var string: eventPath is "";
    var string: doorSoundRef is "";
    var string: weaponSoundRef is "";
    var string: monsterSoundRef is "";
    var float: dx is 0.0;
    var float: dy is 0.0;
    var float: distanceSq is 0.0;
    var float: bestDistanceSq is 0.0;
    var boolean: visibleMonsterFound is FALSE;
    var frameEntity: targetEntity is frameEntity.value;
  begin
    stats.playerHealthAfterPickups := stats.playerHealthBefore;
    stats.playerHealthAfterCombat := stats.playerHealthBefore;
    stats.frameMoveRequestedSteps := FRAME_STEPS;
    stats.framePlayerFinalX := stats.playerX;
    stats.framePlayerFinalY := stats.playerY;
    if stats.playerParsed then
      yawRadians := degreesToRadians(stats.playerYaw);
      for frameStep range 0 to FRAME_STEPS do
        if not movementBlocked then
          pathX := stats.playerX + cos(yawRadians) *
              FRAME_STEP_DISTANCE * float(frameStep);
          pathY := stats.playerY + sin(yawRadians) *
              FRAME_STEP_DISTANCE * float(frameStep);
          movementBlocker := "";
          if frameStep <> 0 then
            movementBlocker := movementBlockerAtPoint(stats, pathX, pathY);
          end if;
          if movementBlocker <> "" then
            movementBlocked := TRUE;
            stats.frameMoveBlocked := TRUE;
            if startsWith(movementBlocker, "entity:") then
              stats.frameMoveBlockingEntities +:= 1;
            else
              stats.frameMoveBlockingBrushes +:= 1;
            end if;
            if stats.firstFrameMovementBlocker = "" then
              stats.firstFrameMovementBlocker := movementBlocker;
            end if;
          else
            if frameStep <> 0 then
              stats.frameMoveAcceptedSteps +:= 1;
            end if;
            stats.framePlayerFinalX := pathX;
            stats.framePlayerFinalY := pathY;
          end if;
        end if;
        if not movementBlocked then
          for entity range stats.entities do
            if isPickupClass(entity.className) and
                pointTouchesEntity(entity, pathX, pathY) then
            if startsWith(entity.className, "item_") and not healthTouched then
              stats.touchedPickups +:= 1;
              stats.touchedHealthPickups +:= 1;
              healthTouched := TRUE;
              if stats.firstPickupName = "" then
                stats.firstPickupName := entity.entityName;
              end if;
            elsif startsWith(entity.className, "ammo_") and not ammoTouched then
              stats.touchedPickups +:= 1;
              stats.touchedAmmoPickups +:= 1;
              stats.ammoAfterPickups +:= DEFAULT_AMMO_ON_PICKUP;
              ammoTouched := TRUE;
              if stats.firstPickupName = "" then
                stats.firstPickupName := entity.entityName;
              end if;
            elsif startsWith(entity.className, "weapon_") and not weaponTouched then
              stats.touchedPickups +:= 1;
              stats.touchedWeaponPickups +:= 1;
              stats.weaponReady := TRUE;
              stats.activeWeaponClass := entity.className;
              stats.activeWeaponAmmoRequired :=
                  weaponAmmoRequiredForClass(stats, entity.className);
              stats.activeWeaponClipSize :=
                  weaponClipSizeForClass(stats, entity.className);
              stats.activeWeaponProjectile :=
                  weaponProjectileForClass(stats, entity.className);
              stats.activeWeaponFireSound :=
                  entityDefSoundForClass(stats, entity.className);
              if stats.activeWeaponProjectile <> "" then
                stats.activeWeaponDamage := projectileDamageForClass(stats,
                    stats.activeWeaponProjectile);
              end if;
              if stats.activeWeaponAmmoRequired <= 0 then
                stats.activeWeaponAmmoRequired := 1;
              end if;
              weaponTouched := TRUE;
              if stats.firstPickupName = "" then
                stats.firstPickupName := entity.entityName;
              end if;
            end if;
          elsif startsWith(entity.className, "trigger_") and
              not triggerTouched and
              pointTouchesEntity(entity, pathX, pathY) then
            stats.touchedTriggers +:= 1;
            stats.firstTriggerName := entity.entityName;
            if entityNamedExists(stats.entities, entity.target) and
                stats.activatedDoors = 0 then
              stats.activatedDoors +:= 1;
              stats.firstActivatedDoorName := entity.target;
              doorSoundRef := soundRefForEntityName(stats, entity.target);
              addFrameSoundEvent(stats, "door_open", doorSoundRef);
            end if;
            triggerTouched := TRUE;
          elsif entity.call <> "" and not scriptExecuted then
            eventPath := scriptEventPathForFunction(stats, entity.call);
            if eventPath <> "" then
              stats.frameScriptCalls +:= 1;
              stats.firstScriptCall := entity.call;
              stats.firstScriptEventPath := entity.call <& ":" <& eventPath;
              if pos(eventPath, "print", 1) <> 0 then
                stats.frameScriptPrints +:= 1;
              end if;
              if pos(eventPath, "trigger", 1) <> 0 then
                stats.frameScriptTriggers +:= 1;
                if stats.activatedDoors = 0 and
                    entityNamedExists(stats.entities, "door_smoke_1") then
                  stats.activatedDoors := 1;
                  stats.firstActivatedDoorName := "door_smoke_1";
                  doorSoundRef := soundRefForEntityName(stats, "door_smoke_1");
                  addFrameSoundEvent(stats, "door_open", doorSoundRef);
                end if;
              end if;
              if pos(eventPath, "wait", 1) <> 0 then
                stats.frameScriptWaits +:= 1;
              end if;
              if pos(eventPath, "objective", 1) <> 0 then
                stats.frameScriptObjectives +:= 1;
              end if;
              scriptExecuted := TRUE;
            end if;
          end if;
          end for;
        end if;
      end for;
    end if;
    stats.ammoAfterCombat := stats.ammoAfterPickups;
    if stats.weaponReady and stats.ammoAfterCombat > 0 and stats.firstMonsterName <> "" then
      bestDistanceSq := 999999999.0;
      for entity range stats.entities do
        if startsWith(entity.className, "monster_") and entity.hasOrigin then
          stats.frameHitscanTraces +:= 1;
          if lineBlockedByBrush(stats, stats.playerX, stats.playerY,
              entity.x, entity.y) then
            stats.frameHitscanBlocked +:= 1;
            if stats.firstFrameHitscanBlocker = "" then
              stats.firstFrameHitscanBlocker := "brush";
            end if;
          else
            stats.frameHitscanClear +:= 1;
            dx := entity.x - stats.playerX;
            dy := entity.y - stats.playerY;
            distanceSq := dx * dx + dy * dy;
            if distanceSq < bestDistanceSq then
              bestDistanceSq := distanceSq;
              targetEntity := entity;
              visibleMonsterFound := TRUE;
            end if;
          end if;
        elsif weaponSoundRef = "" and startsWith(entity.className, "weapon_") then
          weaponSoundRef := stats.activeWeaponFireSound;
        end if;
      end for;
      if visibleMonsterFound and
          stats.ammoAfterCombat >= stats.activeWeaponAmmoRequired then
        stats.shotsFired := 1;
        stats.ammoAfterCombat -:= stats.activeWeaponAmmoRequired;
        stats.monsterHits := 1;
        stats.frameHitscanHits := 1;
        stats.firstFrameHitscanTarget := targetEntity.entityName;
        addFrameSoundEvent(stats, "weapon_fire", weaponSoundRef);
        if targetEntity.entityName = stats.firstMonsterName then
          stats.firstMonsterHealthAfter := stats.firstMonsterHealthBefore -
              stats.activeWeaponDamage;
          stats.firstMonsterAliveAfter := stats.firstMonsterHealthAfter > 0;
        end if;
      end if;
    end if;
    stats.loopAmmoRequired := stats.activeWeaponAmmoRequired;
    stats.loopShotDamage := stats.activeWeaponDamage;
    if stats.firstMonsterAliveAfter and stats.firstMonsterName <> "" then
      for entity range stats.entities do
        if entity.entityName = stats.firstMonsterName and entity.hasOrigin then
          monsterSoundRef := entity.soundRef;
          dx := entity.x - stats.playerX;
          dy := entity.y - stats.playerY;
          if dx * dx + dy * dy <= MONSTER_ATTACK_RANGE * MONSTER_ATTACK_RANGE then
            stats.monsterAttacks := 1;
            addFrameSoundEvent(stats, "monster_response", monsterSoundRef);
            stats.playerHealthAfterCombat := stats.playerHealthAfterPickups -
                DEFAULT_MONSTER_DAMAGE;
          end if;
        end if;
      end for;
    end if;
  end func;

const proc: simulateLoop (inout frameStats: stats) is func
  local
    var integer: loopTick is 0;
    var integer: monsterHealth is 0;
    var integer: playerHealth is 0;
    var integer: ammo is 0;
    var boolean: monsterAlive is TRUE;
  begin
    stats.loopTicks := LOOP_TICKS;
    stats.loopPickupsConsumed := stats.touchedPickups;
    stats.loopDoorsOpen := stats.activatedDoors;
    monsterHealth := stats.firstMonsterHealthBefore;
    playerHealth := stats.playerHealthAfterPickups;
    ammo := stats.ammoAfterPickups;
    if stats.weaponReady and stats.firstFrameHitscanTarget <> "" then
      for loopTick range 1 to LOOP_TICKS do
        if ammo >= stats.loopAmmoRequired and monsterAlive then
          stats.loopShotsFired +:= 1;
          stats.loopMonsterHits +:= 1;
          ammo -:= stats.loopAmmoRequired;
          monsterHealth -:= stats.loopShotDamage;
          if monsterHealth <= 0 then
            monsterHealth := 0;
            monsterAlive := FALSE;
          else
            stats.loopMonsterAttacks +:= 1;
            playerHealth -:= DEFAULT_MONSTER_DAMAGE;
            if playerHealth < 0 then
              playerHealth := 0;
            end if;
          end if;
        end if;
      end for;
    end if;
    stats.loopAmmoAfter := ammo;
    stats.loopPlayerHealthAfter := playerHealth;
    stats.loopMonsterHealthAfter := monsterHealth;
    stats.loopMonsterAliveAfter := monsterAlive;
    stats.loopClearCondition := not monsterAlive and stats.loopDoorsOpen <> 0;
  end func;

const proc: resolveNextCompiledAssets (inout frameStats: stats,
    in array string: pk4Files) is func
  local
    var string: pk4File is "";
    var fileSys: zipFs is fileSys.value;
    var array string: paths is 0 times "";
    var string: path is "";
    var string: pathLower is "";
  begin
    if stats.nextMapDeclared then
      for pk4File range pk4Files do
        zipFs := openZip(pk4File);
        if zipFs <> fileSys.value then
          paths := readDir(zipFs, RECURSIVE);
          for path range paths do
            pathLower := normalizedAssetPath(path);
            if pathLower = globalNextProcPath then
              globalNextProcFound := TRUE;
            elsif pathLower = globalNextCmPath then
              globalNextCmFound := TRUE;
            end if;
          end for;
          close(zipFs);
        end if;
      end for;
    end if;
  end func;

const proc: prepareFrameTransition (inout frameStats: stats,
    in array string: pk4Files) is func
  local
    var string: nextContent is "";
  begin
    if stats.firstNextMap <> "" then
      stats.nextMapDeclared := TRUE;
      stats.nextMapPath := mapNameToAssetPath(stats.firstNextMap);
      globalNextProcPath := compiledSiblingPath(stats.nextMapPath, ".proc");
      globalNextCmPath := compiledSiblingPath(stats.nextMapPath, ".cm");
      nextContent := mapContentForPath(stats, stats.nextMapPath);
      stats.nextMapFound := nextContent <> "";
      if stats.nextMapFound then
        summarizeNextMapForTransition(stats, nextContent);
      end if;
      resolveNextCompiledAssets(stats, pk4Files);
    end if;
    if stats.loopClearCondition and stats.nextMapDeclared and
        stats.nextMapFound and stats.nextMapPlayerStarts <> 0 and
        globalNextProcFound and globalNextCmFound then
      stats.transitionState := "ready";
      stats.transitionPath := stats.requestedMapPath <& ">cleared>" <&
          stats.nextMapPath;
    elsif stats.loopClearCondition then
      stats.transitionState := "incomplete";
    else
      stats.transitionState := "pending";
    end if;
  end func;

const proc: buildAndVerifySaveSnapshot (inout frameStats: stats) is func
  local
    var string: clearText is "";
    var string: healthText is "";
    var string: ammoText is "";
    var string: doorsText is "";
    var string: screenText is "";
  begin
    stats.saveSnapshot := "map=" <& stats.requestedMapPath <&
        ";health=" <& stats.loopPlayerHealthAfter <&
        ";ammo=" <& stats.loopAmmoAfter <&
        ";monster_health=" <& stats.loopMonsterHealthAfter <&
        ";monster_alive=" <& stats.loopMonsterAliveAfter <&
        ";doors_open=" <& stats.loopDoorsOpen <&
        ";clear=" <& stats.loopClearCondition <&
        ";screen=" <& screenStateForFrame(stats) <&
        ";next_map=" <& stats.nextMapPath <&
        ";transition=" <& stats.transitionState;
    healthText := snapshotValue(stats.saveSnapshot, "health");
    ammoText := snapshotValue(stats.saveSnapshot, "ammo");
    doorsText := snapshotValue(stats.saveSnapshot, "doors_open");
    clearText := snapshotValue(stats.saveSnapshot, "clear");
    screenText := snapshotValue(stats.saveSnapshot, "screen");
    block
      stats.restoredPlayerHealth := integer(healthText);
      stats.restoredAmmo := integer(ammoText);
      stats.restoredDoorsOpen := integer(doorsText);
      stats.restoredClearCondition := clearText = "TRUE";
      stats.restoredScreenState := screenText;
      stats.restoreVerified :=
          stats.restoredPlayerHealth = stats.loopPlayerHealthAfter and
          stats.restoredAmmo = stats.loopAmmoAfter and
          stats.restoredDoorsOpen = stats.loopDoorsOpen and
          stats.restoredClearCondition = stats.loopClearCondition and
          stats.restoredScreenState = screenStateForFrame(stats);
    exception
      catch RANGE_ERROR:
        stats.restoreVerified := FALSE;
    end block;
  end func;

const func array string: findPk4Archives (in string: basePath) is func
  result
    var array string: pk4Files is 0 times "";
  local
    var array string: names is 0 times "";
    var string: name is "";
  begin
    if fileType(basePath) = FILE_DIR then
      names := readDir(basePath);
      for name range names do
        if isPk4Name(name) and fileType(joinPath(basePath, name)) = FILE_REGULAR then
          pk4Files &:= joinPath(basePath, name);
        end if;
      end for;
    end if;
  end func;

const proc: scanArchive (inout frameStats: stats,
    in string: pk4File, in string: targetMapPath) is func
  local
    var fileSys: zipFs is fileSys.value;
    var array string: paths is 0 times "";
    var string: path is "";
    var string: pathLower is "";
  begin
    zipFs := openZip(pk4File);
    if zipFs = fileSys.value then
      logError("could not open pk4 archive: " <& pk4File);
    else
      paths := readDir(zipFs, RECURSIVE);
      for path range paths do
        pathLower := normalizedAssetPath(path);
        if isSoundAssetPath(pathLower) then
          stats.soundAssets +:= 1;
          appendUniqueString(stats.soundAssetStems, assetStem(pathLower));
        elsif isModelAssetPath(pathLower) then
          stats.modelAssets +:= 1;
          appendUniqueString(stats.modelAssetStems, assetStem(pathLower));
          if endsWith(pathLower, ".md5anim") then
            stats.frameMd5AnimAssets +:= 1;
            inspectFrameMd5AnimContent(stats, pathLower, getFile(zipFs, path));
          end if;
        elsif isGuiAssetPath(pathLower) then
          inspectGuiContent(stats, pathLower, getFile(zipFs, path));
        elsif isSkinAssetPath(pathLower) then
          inspectSkinContent(stats, pathLower, getFile(zipFs, path));
        end if;
      end for;
      for path range paths do
        pathLower := normalizedAssetPath(path);
        if startsWith(pathLower, "maps/") and endsWith(pathLower, ".map") then
          addMapAsset(stats, pathLower, getFile(zipFs, path));
        end if;
      end for;
      for path range paths do
        pathLower := normalizedAssetPath(path);
        if endsWith(pathLower, ".script") then
          inspectScriptContent(stats, getFile(zipFs, path));
        end if;
      end for;
      for path range paths do
        pathLower := normalizedAssetPath(path);
        if endsWith(pathLower, ".def") or endsWith(pathLower, ".decl") then
          inspectDefContent(stats, getFile(zipFs, path));
        end if;
      end for;
      for path range paths do
        pathLower := normalizedAssetPath(path);
        if not stats.requestedMapFound and pathLower = targetMapPath then
          stats.requestedMapFound := TRUE;
          inspectMapContent(stats, getFile(zipFs, path));
        end if;
      end for;
      close(zipFs);
    end if;
  end func;

const proc: parseArgs (inout frameConfig: config) is func
  local
    var array string: args is 0 times "";
    var integer: argIdx is 1;
  begin
    args := argv(PROGRAM);
    while argIdx <= length(args) do
      if args[argIdx] = "--help" or args[argIdx] = "-h" then
        config.showHelp := TRUE;
      elsif args[argIdx] = "--doom3_data_path" and argIdx < length(args) then
        incr(argIdx);
        config.dataPath := convDosPath(args[argIdx]);
      elsif args[argIdx] = "--doom3_base_path" and argIdx < length(args) then
        incr(argIdx);
        config.basePath := convDosPath(args[argIdx]);
      elsif args[argIdx] = "--doom3_start_map" and argIdx < length(args) then
        incr(argIdx);
        config.startMap := args[argIdx];
      elsif args[argIdx] = "+map" and argIdx < length(args) then
        incr(argIdx);
        config.startMap := args[argIdx];
      elsif args[argIdx] = "+set" and argIdx + 2 <= length(args) then
        if args[argIdx + 1] = "fs_basepath" then
          config.dataPath := convDosPath(args[argIdx + 2]);
        elsif args[argIdx + 1] = "fs_game" then
          config.basePath := convDosPath(args[argIdx + 2]);
        end if;
        argIdx +:= 2;
      end if;
      incr(argIdx);
    end while;
    if config.basePath = "" then
      config.basePath := joinPath(config.dataPath, DEFAULT_BASE_DIR);
    end if;
  end func;

const proc: showUsage is func
  begin
    writeln("Usage:");
    writeln("  s7 doom3_seed7_frame.s7 --doom3_data_path <doom3-root>");
    writeln("  s7 doom3_seed7_frame.s7 +set fs_basepath <doom3-root> +map <map>");
    writeln("");
    writeln("Scans user-owned Doom 3 pk4 files for game-frame readiness.");
  end func;

