(********************************************************************)
(*  doom3_seed7_frame.s7                                            *)
(*                                                                  *)
(*  Focused Doom 3 / id Tech 4 gameplay-frame probe for Seed7.      *)
(*  It loads user-owned pk4 archives, builds a small selected-map    *)
(*  runtime entity set, then simulates one deterministic frame path  *)
(*  with pickups, trigger/door activation, weapon fire, and monster  *)
(*  retaliation. No commercial data is bundled.                      *)
(********************************************************************)

$ include "seed7_05.s7i";
$ include "osfiles.s7i";
$ include "zip.s7i";
$ include "math.s7i";

