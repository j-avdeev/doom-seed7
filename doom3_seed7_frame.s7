          stats.firstMonsterHealthBefore);
      logInfo("first_monster_health_after=" <& stats.firstMonsterHealthAfter);
      logInfo("first_monster_alive_after=" <& stats.firstMonsterAliveAfter);
    end if;
    logInfo("frame_probe_ready=" <& (stats.requestedMapFound and
        stats.playerParsed and stats.weaponReady and stats.ammoAfterPickups > 0 and
        stats.firstMonsterName <> "" and stats.activatedDoors <> 0 and
        stats.frameScriptCalls <> 0 and stats.frameScriptObjectives <> 0 and
        stats.frameSoundEvents <> 0 and stats.frameSoundMissing = 0 and
        stats.frameModelResolved <> 0 and stats.frameModelMissing = 0 and
        stats.frameAnimResolved <> 0 and stats.frameAnimMissing = 0 and
        stats.frameAnimPlaybackSamples <> 0 and
        stats.frameAnimInterpolationSamples <> 0 and
        stats.skinDecls <> 0 and stats.skinRemaps <> 0 and
        stats.frameSkinResolved <> 0 and stats.frameSkinMissing = 0 and
        stats.entityDefSpawnclassValues <> 0 and
        stats.frameSpawnclassResolved <> 0 and
        stats.frameSpawnclassUnsupported = 0 and
        stats.guiAssets <> 0 and stats.guiWindowDefs <> 0 and
        stats.entityDefGuiResolved <> 0 and stats.mapGuiResolved <> 0 and
        stats.runtimeHudBindings <> 0 and stats.entityDefGuiMissing = 0 and
        stats.mapGuiMissing = 0 and
        stats.frameMoveAcceptedSteps <> 0 and stats.frameMoveBlocked and
        stats.frameHitscanHits <> 0 and stats.loopClearCondition and
        stats.transitionState = "ready" and
        stats.restoreVerified));
  end func;

const proc: main is func
  local
    var frameConfig: config is frameConfig.value;
    var frameStats: stats is frameStats.value;
    var array string: pk4Files is 0 times "";
    var string: pk4File is "";
  begin
    parseArgs(config);
    if config.showHelp then
      showUsage;
    else
      stats.requestedMapPath := mapNameToAssetPath(config.startMap);
      globalNextProcPath := "";
      globalNextCmPath := "";
      globalNextProcFound := FALSE;
      globalNextCmFound := FALSE;
      if fileType(config.basePath) <> FILE_DIR then
        logError("Doom 3 base directory not found: " <& config.basePath);
      else
        pk4Files := sort(findPk4Archives(config.basePath));
        stats.pk4Archives := length(pk4Files);
        if length(pk4Files) = 0 then
          logError("No .pk4 archives found in: " <& config.basePath);
        else
          for pk4File range pk4Files do
            scanArchive(stats, pk4File, stats.requestedMapPath);
          end for;
          simulateFrame(stats);
          simulateLoop(stats);
          prepareFrameTransition(stats, pk4Files);
          buildAndVerifySaveSnapshot(stats);
          printStats(stats);
        end if;
      end if;
    end if;
  end func;
