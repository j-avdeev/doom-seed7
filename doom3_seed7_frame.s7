const integer: DEFAULT_SHOT_DAMAGE is 25;
const integer: DEFAULT_MONSTER_DAMAGE is 12;
const float: TOUCH_RADIUS is 32.0;
const float: MONSTER_ATTACK_RANGE is 80.0;
const float: FRAME_STEP_DISTANCE is 16.0;
const integer: TRACE_STEPS is 32;
const integer: FRAME_STEPS is 4;
const integer: LOOP_TICKS is 6;
const integer: HUD_BAR_BLOCKS is 10;
const integer: ENTITY_DEF_INHERIT_LIMIT is 8;

