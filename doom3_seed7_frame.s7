const proc: logInfo (in string: msg) is func
  begin
    writeln("[frame] " <& msg);
  end func;

const proc: logError (in string: msg) is func
  begin
    writeln("[frame-error] " <& msg);
  end func;

const func string: hudBar (in integer: value, in integer: maxValue) is func
  result
    var string: bar is "";
  local
    var integer: filled is 0;
    var integer: idx is 1;
  begin
    if maxValue > 0 then
      filled := value * HUD_BAR_BLOCKS div maxValue;
    end if;
    if filled < 0 then
      filled := 0;
    elsif filled > HUD_BAR_BLOCKS then
      filled := HUD_BAR_BLOCKS;
    end if;
    for idx range 1 to HUD_BAR_BLOCKS do
      if idx <= filled then
        bar &:= "#";
      else
        bar &:= ".";
      end if;
    end for;
  end func;

const func string: screenStateForFrame (in frameStats: stats) is func
  result
    var string: state is "";
  begin
    if stats.loopPlayerHealthAfter <= 0 then
      state := "dead";
    elsif stats.loopClearCondition then
      state := "cleared";
    else
      state := "playing";
    end if;
  end func;

const func string: snapshotValue (in string: snapshot,
    in string: keyName) is func
  result
    var string: value is "";
  local
    var string: keyText is "";
    var integer: keyPos is 0;
    var integer: valueStart is 0;
    var integer: valueEnd is 0;
  begin
    keyText := keyName <& "=";
    keyPos := pos(snapshot, keyText, 1);
    if keyPos <> 0 then
      valueStart := keyPos + length(keyText);
      valueEnd := pos(snapshot, ";", valueStart);
      if valueEnd = 0 then
        valueEnd := succ(length(snapshot));
      end if;
      value := snapshot[valueStart .. pred(valueEnd)];
    end if;
  end func;

const func string: joinPath (in string: leftPath, in string: rightPath) is func
  result
    var string: joined is "";
  begin
    if leftPath = "" then
      joined := rightPath;
    elsif endsWith(leftPath, "/") or endsWith(leftPath, "\\") then
      joined := leftPath <& rightPath;
    else
      joined := leftPath <& "/" <& rightPath;
    end if;
  end func;

const func boolean: isPk4Name (in string: fileName) is
    return endsWith(lower(fileName), ".pk4");

const func string: normalizedAssetPath (in string: filePath) is
    return replace(lower(filePath), "\\", "/");

const func string: assetStem (in string: filePath) is func
  result
    var string: stem is "";
  local
    var string: path is "";
    var integer: dotPos is 0;
  begin
    path := normalizedAssetPath(filePath);
    dotPos := rpos(path, ".");
    if dotPos <> 0 then
      stem := path[.. pred(dotPos)];
    else
      stem := path;
    end if;
  end func;

const func boolean: isSoundAssetPath (in string: path) is func
  result
    var boolean: isSound is FALSE;
  local
    var string: lowerPath is "";
  begin
    lowerPath := normalizedAssetPath(path);
    isSound := startsWith(lowerPath, "sound/") and
        (endsWith(lowerPath, ".wav") or endsWith(lowerPath, ".ogg"));
  end func;

const func boolean: isModelAssetPath (in string: path) is func
  result
    var boolean: isModel is FALSE;
  local
    var string: lowerPath is "";
  begin
    lowerPath := normalizedAssetPath(path);
    isModel := startsWith(lowerPath, "models/") and
        (endsWith(lowerPath, ".md5mesh") or endsWith(lowerPath, ".md5anim") or
        endsWith(lowerPath, ".lwo") or endsWith(lowerPath, ".ase"));
  end func;

const func boolean: isGuiAssetPath (in string: path) is func
  result
    var boolean: isGui is FALSE;
  begin
    isGui := endsWith(normalizedAssetPath(path), ".gui");
  end func;

const func boolean: isSkinAssetPath (in string: path) is func
  result
    var boolean: isSkin is FALSE;
  begin
    isSkin := endsWith(normalizedAssetPath(path), ".skin");
  end func;

const func string: mapNameToAssetPath (in string: mapName) is func
  result
    var string: assetPath is "";
  begin
    assetPath := normalizedAssetPath(mapName);
    if not startsWith(assetPath, "maps/") then
      assetPath := "maps/" <& assetPath;
    end if;
    if not endsWith(assetPath, ".map") then
      assetPath &:= ".map";
    end if;
  end func;

const func string: compiledSiblingPath (in string: mapPath,
    in string: suffix) is func
  result
    var string: siblingPath is "";
  begin
    if endsWith(mapPath, ".map") then
      siblingPath := mapPath[.. length(mapPath) - 4] <& suffix;
    else
      siblingPath := mapPath <& suffix;
    end if;
  end func;

const func string: quotedValueAfter (in string: content, in string: keyName) is func
  result
    var string: value is "";
  local
    var string: keyText is "";
    var integer: keyPos is 0;
    var integer: keyEnd is 0;
    var integer: valueStart is 0;
    var integer: valueEnd is 0;
  begin
    keyText := "\"" <& keyName <& "\"";
    keyPos := pos(lower(content), lower(keyText), 1);
    if keyPos <> 0 then
      keyEnd := pos(content, "\"", succ(keyPos));
      if keyEnd <> 0 then
        valueStart := pos(content, "\"", succ(keyEnd));
        if valueStart <> 0 then
          valueEnd := pos(content, "\"", succ(valueStart));
          if valueEnd <> 0 then
            value := content[succ(valueStart) .. pred(valueEnd)];
          end if;
        end if;
      end if;
    end if;
  end func;

const func string: cleanedToken (in string: token) is func
  result
    var string: clean is "";
  local
    var integer: idx is 1;
    var char: ch is ' ';
  begin
    clean := token;
    while idx <= length(clean) do
      ch := clean[idx];
      if ch = '"' or ch = '(' or ch = ')' or ch = '{' or ch = '}' or
          ch = ',' or ch = ';' or ch = ':' then
        clean := clean[.. pred(idx)] & clean[succ(idx) ..];
      else
        incr(idx);
      end if;
    end while;
  end func;

const func string: declNameAfter (in string: content, in integer: startPos) is func
  result
    var string: declName is "";
  local
    var integer: idx is 0;
    var char: ch is ' ';
  begin
    idx := startPos;
    while idx <= length(content) and declName = "" do
      ch := content[idx];
      if ch <> ' ' and ch <> '\t' and ch <> '\n' and ch <> '\r' then
        while idx <= length(content) and content[idx] <> ' ' and
            content[idx] <> '\t' and content[idx] <> '\n' and
            content[idx] <> '\r' and content[idx] <> '{' do
          declName &:= content[idx];
          incr(idx);
        end while;
      end if;
      incr(idx);
    end while;
  end func;

const func string: valueAfterWord (in string: content,
    in string: keyName) is func
  result
    var string: value is "";
  local
    var string: normalizedContent is "";
    var array string: tokens is 0 times "";
    var integer: tokenIndex is 1;
  begin
    normalizedContent := replace(content, "\n", " ");
    normalizedContent := replace(normalizedContent, "\r", " ");
    normalizedContent := replace(normalizedContent, "\t", " ");
    tokens := noEmptyStrings(split(normalizedContent, ' '));
    while tokenIndex < length(tokens) and value = "" do
      if lower(cleanedToken(tokens[tokenIndex])) = lower(keyName) then
        value := cleanedToken(tokens[succ(tokenIndex)]);
      end if;
      incr(tokenIndex);
    end while;
  end func;

const func integer: integerAfterWord (in string: content,
    in string: keyName) is func
  result
    var integer: value is 0;
  local
    var string: normalizedContent is "";
    var array string: tokens is 0 times "";
    var integer: tokenIndex is 1;
    var string: token is "";
  begin
    normalizedContent := replace(lower(content), "\n", " ");
    normalizedContent := replace(normalizedContent, "\r", " ");
    normalizedContent := replace(normalizedContent, "\t", " ");
    tokens := noEmptyStrings(split(normalizedContent, ' '));
    while tokenIndex < length(tokens) and value = 0 do
      if cleanedToken(tokens[tokenIndex]) = lower(keyName) then
        token := cleanedToken(tokens[succ(tokenIndex)]);
        block
          value := integer(token);
        exception
          catch RANGE_ERROR:
            value := 0;
        end block;
      end if;
      incr(tokenIndex);
    end while;
  end func;

const func integer: countWord (in string: content, in string: word) is func
  result
    var integer: count is 0;
  local
    var integer: searchPos is 1;
    var integer: foundPos is 0;
    var string: lowerContent is "";
    var string: lowerWord is "";
  begin
    lowerContent := lower(content);
    lowerWord := lower(word);
    foundPos := pos(lowerContent, lowerWord, searchPos);
    while foundPos <> 0 do
      incr(count);
      searchPos := foundPos + length(lowerWord);
      foundPos := pos(lowerContent, lowerWord, searchPos);
    end while;
  end func;

const func integer: previousCharPos (in string: content, in char: needle,
    in integer: startPos) is func
  result
    var integer: foundPos is 0;
  local
    var integer: idx is 0;
  begin
    idx := startPos;
    while idx >= 1 and foundPos = 0 do
      if content[idx] = needle then
        foundPos := idx;
      end if;
      decr(idx);
    end while;
  end func;

const func integer: matchingBlockEnd (in string: content,
    in integer: blockStart) is func
  result
    var integer: blockEnd is 0;
  local
    var integer: idx is 0;
    var integer: depth is 0;
  begin
    if blockStart <> 0 then
      idx := blockStart;
      while idx <= length(content) and blockEnd = 0 do
        if content[idx] = '{' then
          incr(depth);
        elsif content[idx] = '}' then
          decr(depth);
          if depth = 0 then
            blockEnd := idx;
          end if;
        end if;
        incr(idx);
      end while;
    end if;
  end func;

const func float: vectorComponentOrDefault (
    in string: vectorText, in integer: componentIndex,
    in float: defaultValue) is func
  result
    var float: component is 0.0;
  local
    var array string: parts is 0 times "";
  begin
    component := defaultValue;
    parts := noEmptyStrings(split(vectorText, ' '));
    if length(parts) >= componentIndex then
      block
        component := float(parts[componentIndex]);
      exception
        catch RANGE_ERROR:
          component := defaultValue;
      end block;
    end if;
  end func;

const func float: degreesToRadians (in float: degrees) is
    return degrees * 3.14159265358979323846 / 180.0;

const func boolean: pointTouchesEntity (in frameEntity: entity,
    in float: x, in float: y) is func
  result
    var boolean: touches is FALSE;
  local
    var float: dx is 0.0;
    var float: dy is 0.0;
  begin
    if entity.hasOrigin then
      dx := entity.x - x;
      dy := entity.y - y;
      touches := dx * dx + dy * dy <= TOUCH_RADIUS * TOUCH_RADIUS;
    end if;
  end func;

const func boolean: pointInBrush (in frameBrushBox: box,
    in float: x, in float: y) is func
  result
    var boolean: inside is FALSE;
  begin
    inside := box.complete and x >= box.minX and x <= box.maxX and
        y >= box.minY and y <= box.maxY;
  end func;

const func boolean: lineBlockedByBrush (in frameStats: stats,
    in float: startX, in float: startY, in float: endX, in float: endY) is func
  result
    var boolean: blocked is FALSE;
  local
    var integer: traceStep is 0;
    var float: t is 0.0;
    var float: x is 0.0;
    var float: y is 0.0;
    var frameBrushBox: box is frameBrushBox.value;
  begin
    for traceStep range 1 to TRACE_STEPS do
      t := float(traceStep) / float(TRACE_STEPS);
      x := startX + (endX - startX) * t;
      y := startY + (endY - startY) * t;
      for box range stats.brushes do
        if pointInBrush(box, x, y) then
          blocked := TRUE;
        end if;
      end for;
    end for;
  end func;

const func string: movementBlockerAtPoint (in frameStats: stats,
    in float: x, in float: y) is func
  result
    var string: blocker is "";
  local
    var frameBrushBox: box is frameBrushBox.value;
    var frameEntity: entity is frameEntity.value;
  begin
    for box range stats.brushes do
      if blocker = "" and pointInBrush(box, x, y) then
        blocker := "brush";
      end if;
    end for;
    for entity range stats.entities do
      if blocker = "" and entity.hasOrigin and
          (entity.className = "func_static" or
          entity.className = "func_door" or
          entity.className = "mover_door" or
          startsWith(entity.className, "monster_")) and
          pointTouchesEntity(entity, x, y) then
        blocker := "entity:" <& entity.entityName;
      end if;
    end for;
  end func;

const func boolean: isPickupClass (in string: className) is func
  result
    var boolean: pickup is FALSE;
  begin
    pickup := startsWith(className, "item_") or
        startsWith(className, "ammo_") or startsWith(className, "weapon_");
  end func;

const func boolean: supportedSpawnclass (in string: spawnclass) is func
  result
    var boolean: supported is FALSE;
  local
    var string: normalized is "";
  begin
    normalized := lower(spawnclass);
    supported := normalized = "idai" or normalized = "iditem" or
        normalized = "iditempowerup" or normalized = "idweapon" or
        normalized = "idprojectile" or normalized = "iddoor" or
        normalized = "idmover";
  end func;

const func boolean: entityNamedExists (in array frameEntity: entities,
    in string: entityName) is func
  result
    var boolean: found is FALSE;
  local
    var frameEntity: entity is frameEntity.value;
  begin
    for entity range entities do
      if entity.entityName = entityName then
        found := TRUE;
      end if;
    end for;
  end func;

const func boolean: containsString (in array string: values,
    in string: value) is func
  result
    var boolean: found is FALSE;
  local
    var string: current is "";
  begin
    for current range values do
      if current = value then
        found := TRUE;
      end if;
    end for;
  end func;

const proc: appendUniqueString (inout array string: values,
    in string: value) is func
  begin
    if value <> "" and not containsString(values, value) then
      values &:= value;
    end if;
  end func;

const proc: addMapAsset (inout frameStats: stats,
    in string: mapPath, in string: content) is func
  local
    var integer: idx is 1;
    var boolean: stored is FALSE;
  begin
    stats.mapAssets +:= 1;
    while idx <= length(stats.mapPaths) and not stored do
      if stats.mapPaths[idx] = mapPath then
        stats.mapContents[idx] := content;
        stored := TRUE;
      end if;
      incr(idx);
    end while;
    if not stored then
      stats.mapPaths &:= mapPath;
      stats.mapContents &:= content;
    end if;
    stats.uniqueMapAssets := length(stats.mapPaths);
  end func;

const func string: mapContentForPath (in frameStats: stats,
    in string: mapPath) is func
  result
    var string: content is "";
  local
    var integer: idx is 1;
  begin
    while idx <= length(stats.mapPaths) and content = "" do
      if stats.mapPaths[idx] = mapPath then
        content := stats.mapContents[idx];
      end if;
      incr(idx);
    end while;
  end func;

const func string: meshStemForModelDef (in frameStats: stats,
    in string: modelName) is func
  result
    var string: meshStem is "";
  local
    var integer: modelIndex is 1;
  begin
    while modelIndex <= length(stats.modelDefNames) and meshStem = "" do
      if stats.modelDefNames[modelIndex] = lower(modelName) and
          modelIndex <= length(stats.modelDefMeshStems) then
        meshStem := stats.modelDefMeshStems[modelIndex];
      end if;
      incr(modelIndex);
    end while;
  end func;

const func string: resolvedModelStem (in frameStats: stats,
    in string: modelRef) is func
  result
    var string: stem is "";
  begin
    if endsWith(lower(modelRef), ".md5mesh") or endsWith(lower(modelRef), ".lwo") or
        endsWith(lower(modelRef), ".ase") then
      stem := assetStem(modelRef);
    else
      stem := meshStemForModelDef(stats, modelRef);
    end if;
  end func;

const func boolean: modelRefResolved (in frameStats: stats,
    in string: modelRef) is func
  result
    var boolean: resolved is FALSE;
  local
    var string: stem is "";
  begin
    stem := resolvedModelStem(stats, modelRef);
    resolved := stem <> "" and containsString(stats.modelAssetStems, stem);
  end func;

const func boolean: animRefResolved (in frameStats: stats,
    in string: animRef) is func
  result
    var boolean: resolved is FALSE;
  begin
    resolved := endsWith(lower(animRef), ".md5anim") and
        containsString(stats.modelAssetStems, assetStem(animRef));
  end func;

const func boolean: skinRefResolved (in frameStats: stats,
    in string: skinRef) is func
  result
    var boolean: resolved is FALSE;
  begin
    resolved := skinRef <> "" and
        (containsString(stats.skinNames, lower(skinRef)) or
        containsString(stats.skinAssetStems, assetStem(skinRef)));
  end func;

const func string: normalizedGuiRef (in string: guiRef) is func
  result
    var string: normalized is "";
  begin
    normalized := normalizedAssetPath(guiRef);
  end func;

const func boolean: guiRefResolved (in frameStats: stats,
    in string: guiRef) is func
  result
    var boolean: resolved is FALSE;
  begin
    resolved := guiRef <> "" and
        containsString(stats.guiAssetPaths, normalizedGuiRef(guiRef));
  end func;

const proc: addFrameGuiRef (inout frameStats: stats,
    in string: guiRef, in boolean: mapRef, in string: ownerName) is func
  local
    var string: normalizedRef is "";
  begin
    normalizedRef := normalizedGuiRef(guiRef);
    if normalizedRef <> "" then
      if mapRef then
        stats.mapGuiRefs +:= 1;
      else
        stats.entityDefGuiRefs +:= 1;
      end if;
      if guiRefResolved(stats, normalizedRef) then
        if mapRef then
          stats.mapGuiResolved +:= 1;
          stats.runtimeGuiSurfaces +:= 1;
          if startsWith(normalizedRef, "guis/hud") then
            stats.runtimeHudBindings +:= 1;
          end if;
          if stats.firstFrameGuiBinding = "" then
            stats.firstFrameGuiBinding := ownerName <& "=" <& normalizedRef;
          end if;
        else
          stats.entityDefGuiResolved +:= 1;
        end if;
      else
        if mapRef then
          stats.mapGuiMissing +:= 1;
        else
          stats.entityDefGuiMissing +:= 1;
        end if;
        if stats.firstMissingFrameGui = "" then
          stats.firstMissingFrameGui := normalizedRef;
        end if;
      end if;
    end if;
  end func;

const proc: addFrameAnimPlaybackSample (inout frameStats: stats,
    in string: animRef) is func
  local
    var string: animStem is "";
    var integer: idx is 1;
    var integer: frameCount is 0;
    var integer: frameRate is 0;
    var integer: sampleFrame is 0;
    var integer: nextFrame is 0;
    var integer: frameMillis is 0;
    var integer: sampleMillis is 0;
    var integer: blendPercent is 0;
  begin
    animStem := assetStem(animRef);
    while idx <= length(stats.md5AnimAssetStems) and frameCount = 0 do
      if stats.md5AnimAssetStems[idx] = animStem then
        frameCount := stats.md5AnimFrameCounts[idx];
        frameRate := stats.md5AnimFrameRates[idx];
      end if;
      incr(idx);
    end while;
    if frameCount <> 0 and frameRate <> 0 then
      sampleFrame := (frameRate * 75 div 1000) rem frameCount;
      nextFrame := (sampleFrame + 1) rem frameCount;
      frameMillis := 1000 div frameRate;
      if frameMillis <> 0 then
        sampleMillis := 75 rem frameMillis;
        blendPercent := sampleMillis * 100 div frameMillis;
      end if;
      stats.frameAnimPlaybackSamples +:= 1;
      stats.frameAnimInterpolationSamples +:= 1;
      if stats.frameAnimPlaybackSamples = 1 then
        stats.firstFrameAnimSampleFrame := sampleFrame;
        stats.firstFrameAnimNextFrame := nextFrame;
        stats.firstFrameAnimBlendPercent := blendPercent;
      end if;
    end if;
  end func;

const func string: soundRefForEntityName (in frameStats: stats,
    in string: entityName) is func
  result
    var string: soundRef is "";
  local
    var frameEntity: entity is frameEntity.value;
  begin
    for entity range stats.entities do
      if soundRef = "" and entity.entityName = entityName then
        soundRef := entity.soundRef;
      end if;
    end for;
  end func;

const func string: scriptEventPathForFunction (in frameStats: stats,
    in string: functionName) is func
  result
    var string: eventPath is "";
  local
    var integer: idx is 1;
  begin
    while idx <= length(stats.scriptEventFunctionNames) and eventPath = "" do
      if stats.scriptEventFunctionNames[idx] = lower(functionName) then
        eventPath := stats.scriptEventPaths[idx];
      end if;
      incr(idx);
    end while;
  end func;

const func string: eventPathForFunctionBody (in string: functionBody) is func
  result
    var string: eventPath is "";
  local
    var string: bodyLower is "";
  begin
    bodyLower := lower(functionBody);
    if pos(bodyLower, "sys.", 1) <> 0 then
      eventPath &:= "print";
    end if;
    if pos(bodyLower, "trigger", 1) <> 0 or pos(bodyLower, "activate", 1) <> 0 then
      if eventPath <> "" then
        eventPath &:= ">";
      end if;
      eventPath &:= "trigger";
    end if;
    if pos(bodyLower, "wait", 1) <> 0 then
      if eventPath <> "" then
        eventPath &:= ">";
      end if;
      eventPath &:= "wait";
    end if;
    if pos(bodyLower, "objective_complete", 1) <> 0 or
        pos(bodyLower, "completeobjective", 1) <> 0 then
      if eventPath <> "" then
        eventPath &:= ">";
      end if;
      eventPath &:= "objective";
    end if;
  end func;

const func string: firstSoundSpawnargValue (in string: blockText) is func
  result
    var string: value is "";
  local
    var string: lowerBlock is "";
    var integer: searchPos is 1;
    var integer: keyPos is 0;
    var integer: keyStart is 0;
    var integer: keyEnd is 0;
    var string: keyName is "";
  begin
    lowerBlock := lower(blockText);
    keyPos := pos(lowerBlock, "\"snd_", searchPos);
    if keyPos <> 0 then
      keyStart := succ(keyPos);
      keyEnd := pos(blockText, "\"", keyStart);
      if keyEnd <> 0 then
        keyName := blockText[keyStart .. pred(keyEnd)];
        value := quotedValueAfter(blockText, keyName);
      end if;
    end if;
  end func;

const func integer: intSpawnargOrZero (in string: entityBlock,
    in string: keyName) is func
  result
    var integer: number is 0;
  local
    var string: text is "";
  begin
    text := quotedValueAfter(entityBlock, keyName);
    if text <> "" then
      block
        number := integer(text);
      exception
        catch RANGE_ERROR:
          number := 0;
      end block;
    end if;
  end func;

const func boolean: soundRefResolved (in frameStats: stats,
    in string: soundRef) is func
  result
    var boolean: resolved is FALSE;
  begin
    resolved := soundRef <> "" and
        containsString(stats.soundAssetStems, assetStem(soundRef));
  end func;

const proc: addFrameSoundEvent (inout frameStats: stats,
    in string: eventName, in string: soundRef) is func
  local
    var string: eventRef is "";
  begin
    if soundRef <> "" then
      eventRef := eventName <& "=" <& soundRef;
      if not containsString(stats.frameSoundEventsByRef, eventRef) then
        stats.frameSoundCandidates +:= 1;
        stats.frameSoundEvents +:= 1;
        stats.frameSoundEventsByRef &:= eventRef;
        if soundRefResolved(stats, soundRef) then
          stats.frameSoundResolved +:= 1;
        else
          stats.frameSoundMissing +:= 1;
          if stats.firstMissingFrameSound = "" then
            stats.firstMissingFrameSound := eventRef;
          end if;
        end if;
        if stats.firstFrameSoundEvent = "" then
          stats.firstFrameSoundEvent := eventRef;
        end if;
        if eventName = "door_open" then
          stats.frameDoorSoundEvents +:= 1;
        elsif eventName = "weapon_fire" then
          stats.frameWeaponSoundEvents +:= 1;
        elsif eventName = "monster_response" then
          stats.frameMonsterSoundEvents +:= 1;
        end if;
      end if;
    end if;
  end func;

const proc: addEntityDefInfo (inout frameStats: stats,
    in string: className, in string: entityBlock) is func
  local
    var string: healthText is "";
    var integer: healthValue is 0;
    var string: parentName is "";
    var string: soundRef is "";
    var string: modelRef is "";
    var string: animRef is "";
    var string: skinRef is "";
    var string: guiRef is "";
    var string: spawnclass is "";
    var integer: ammoRequired is 0;
    var integer: clipSize is 0;
    var string: projectileName is "";
    var integer: projectileDamage is 0;
  begin
    stats.entityDefs +:= 1;
    stats.entityDefNames &:= lower(className);
    healthText := quotedValueAfter(entityBlock, "health");
    if healthText <> "" then
      block
        healthValue := integer(healthText);
        stats.entityDefHealthValues +:= 1;
      exception
        catch RANGE_ERROR:
          healthValue := 0;
      end block;
    end if;
    parentName := lower(quotedValueAfter(entityBlock, "inherit"));
    if parentName <> "" then
      stats.entityDefInheritValues +:= 1;
    end if;
    soundRef := firstSoundSpawnargValue(entityBlock);
    modelRef := quotedValueAfter(entityBlock, "model");
    animRef := quotedValueAfter(entityBlock, "anim");
    skinRef := quotedValueAfter(entityBlock, "skin");
    guiRef := quotedValueAfter(entityBlock, "gui");
    spawnclass := quotedValueAfter(entityBlock, "spawnclass");
    if spawnclass <> "" then
      stats.entityDefSpawnclassValues +:= 1;
    end if;
    addFrameGuiRef(stats, guiRef, FALSE, "");
    if startsWith(lower(className), "weapon_") then
      stats.weaponDefs +:= 1;
      ammoRequired := intSpawnargOrZero(entityBlock, "ammoRequired");
      if ammoRequired <> 0 then
        stats.weaponAmmoRequiredValues +:= 1;
      end if;
      clipSize := intSpawnargOrZero(entityBlock, "clipSize");
      if clipSize <> 0 then
        stats.weaponClipSizeValues +:= 1;
      end if;
      projectileName := lower(quotedValueAfter(entityBlock, "def_projectile"));
      if projectileName <> "" then
        stats.weaponProjectileRefs +:= 1;
      end if;
      if quotedValueAfter(entityBlock, "snd_fire") <> "" then
        stats.weaponFireSoundRefs +:= 1;
      end if;
    elsif startsWith(lower(className), "projectile_") then
      stats.projectileDefs +:= 1;
      projectileDamage := intSpawnargOrZero(entityBlock, "damage");
      if projectileDamage <> 0 then
        stats.projectileDamageValues +:= 1;
      end if;
    end if;
    stats.entityDefHealthValuesByIndex &:= healthValue;
    stats.entityDefParents &:= parentName;
    stats.entityDefSoundValuesByIndex &:= soundRef;
    stats.entityDefModelValuesByIndex &:= modelRef;
    stats.entityDefAnimValuesByIndex &:= animRef;
    stats.entityDefSkinValuesByIndex &:= skinRef;
    stats.entityDefGuiValuesByIndex &:= guiRef;
    stats.entityDefSpawnclassValuesByIndex &:= spawnclass;
    stats.entityDefWeaponAmmoRequiredByIndex &:= ammoRequired;
    stats.entityDefWeaponClipSizeByIndex &:= clipSize;
    stats.entityDefWeaponProjectileByIndex &:= projectileName;
    stats.entityDefProjectileDamageByIndex &:= projectileDamage;
  end func;

const proc: inspectDefContent (inout frameStats: stats,
    in string: content) is func
  local
    var string: contentLower is "";
    var integer: searchPos is 1;
    var integer: defPos is 0;
    var string: className is "";
    var integer: blockStart is 0;
    var integer: blockEnd is 0;
    var integer: modelPos is 0;
    var string: modelName is "";
    var string: meshStem is "";
  begin
    contentLower := lower(content);
    modelPos := pos(contentLower, "model ", searchPos);
    while modelPos <> 0 do
      modelName := lower(declNameAfter(content, modelPos + length("model ")));
      blockStart := pos(content, "{", modelPos);
      blockEnd := matchingBlockEnd(content, blockStart);
      if modelName <> "" and blockStart <> 0 and blockEnd <> 0 and
          (modelPos = 1 or content[pred(modelPos)] <> '"') then
        meshStem := assetStem(valueAfterWord(content[blockStart .. blockEnd],
            "mesh"));
        stats.modelDefs +:= 1;
        stats.modelDefNames &:= modelName;
        stats.modelDefMeshStems &:= meshStem;
        if meshStem <> "" then
          stats.modelDefMeshValues +:= 1;
        end if;
      end if;
      searchPos := modelPos + length("model ");
      modelPos := pos(contentLower, "model ", searchPos);
    end while;
    searchPos := 1;
    defPos := pos(contentLower, "entitydef ", searchPos);
    while defPos <> 0 do
      className := lower(declNameAfter(content, defPos + length("entitydef ")));
      blockStart := pos(content, "{", defPos);
      blockEnd := matchingBlockEnd(content, blockStart);
      if className <> "" and blockStart <> 0 and blockEnd <> 0 then
        addEntityDefInfo(stats, className, content[blockStart .. blockEnd]);
      end if;
      searchPos := defPos + length("entitydef ");
      defPos := pos(contentLower, "entitydef ", searchPos);
    end while;
  end func;

const proc: inspectScriptContent (inout frameStats: stats,
    in string: content) is func
  local
    var string: contentLower is "";
    var integer: searchPos is 1;
    var integer: voidPos is 0;
    var integer: nameStart is 0;
    var integer: nameEnd is 0;
    var integer: blockStart is 0;
    var integer: blockEnd is 0;
    var integer: semicolonPos is 0;
    var string: functionName is "";
    var string: eventPath is "";
    var string: functionBody is "";
  begin
    stats.scriptFiles +:= 1;
    contentLower := lower(content);
    voidPos := pos(contentLower, "void ", searchPos);
    while voidPos <> 0 do
      nameStart := voidPos + length("void ");
      while nameStart <= length(content) and
          (content[nameStart] = ' ' or content[nameStart] = '\t' or
          content[nameStart] = '\n' or content[nameStart] = '\r') do
        incr(nameStart);
      end while;
      nameEnd := nameStart;
      while nameEnd <= length(content) and content[nameEnd] <> ' ' and
          content[nameEnd] <> '\t' and content[nameEnd] <> '\n' and
          content[nameEnd] <> '\r' and content[nameEnd] <> '(' do
        incr(nameEnd);
      end while;
      functionName := cleanedToken(content[nameStart .. pred(nameEnd)]);
      blockStart := pos(content, "{", nameEnd);
      semicolonPos := pos(content, ";", nameEnd);
      if functionName <> "" and blockStart <> 0 and
          (semicolonPos = 0 or blockStart < semicolonPos) then
        blockEnd := matchingBlockEnd(content, blockStart);
        if blockEnd <> 0 then
          functionBody := content[blockStart .. blockEnd];
          eventPath := eventPathForFunctionBody(functionBody);
          if eventPath <> "" then
            stats.scriptEventFunctions +:= 1;
            stats.scriptEventFunctionNames &:= lower(functionName);
            stats.scriptEventPaths &:= eventPath;
          end if;
          searchPos := succ(blockEnd);
        else
          searchPos := nameEnd;
        end if;
      else
        searchPos := nameEnd;
      end if;
      voidPos := pos(contentLower, "void ", searchPos);
    end while;
  end func;

const func integer: entityDefHealthForClass (
    in frameStats: stats, in string: className,
    in integer: defaultHealth) is func
  result
    var integer: health is 0;
  local
    var string: currentClass is "";
    var integer: inheritDepth is 0;
    var integer: defIndex is 1;
    var boolean: found is FALSE;
  begin
    health := defaultHealth;
    currentClass := lower(className);
    while currentClass <> "" and inheritDepth < ENTITY_DEF_INHERIT_LIMIT and
        not found do
      defIndex := 1;
      while defIndex <= length(stats.entityDefNames) and not found do
        if stats.entityDefNames[defIndex] = currentClass then
          if stats.entityDefHealthValuesByIndex[defIndex] <> 0 then
            health := stats.entityDefHealthValuesByIndex[defIndex];
            found := TRUE;
          else
            currentClass := stats.entityDefParents[defIndex];
          end if;
        end if;
        incr(defIndex);
      end while;
      incr(inheritDepth);
    end while;
  end func;

