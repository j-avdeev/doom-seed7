          stats.firstFrameMovementBlocker);
    end if;
    if stats.firstNextMap <> "" then
      logInfo("first_frame_next_map=" <& stats.firstNextMap);
    end if;
    if stats.firstNextPlayerStart <> "" then
      logInfo("first_frame_next_player_start=" <& stats.firstNextPlayerStart);
    end if;
    if stats.firstMonsterName <> "" then
      logInfo("first_monster=" <& stats.firstMonsterName);
      logInfo("first_monster_class=" <& stats.firstMonsterClass);
