(********************************************************************)
(*  doom3_seed7_parser.s7                                          *)
(*                                                                  *)
(*  Focused Doom 3 / id Tech 4 text lexer/parser probe for Seed7.  *)
(*  It reads user-owned pk4 archives, tokenizes Doom-style text     *)
(*  formats with comments, quoted strings, braces, and parentheses, *)
(*  then emits a deterministic parser-readiness contract. No        *)
(*  commercial data is bundled.                                     *)
(********************************************************************)

$ include "seed7_05.s7i";
$ include "osfiles.s7i";
$ include "zip.s7i";

const string: DEFAULT_DATA_PATH is ".";
const string: DEFAULT_BASE_DIR is "base";
const string: DEFAULT_START_MAP is "game/mars_city1";

const type: parserConfig is new struct
    var string: dataPath is DEFAULT_DATA_PATH;
    var string: basePath is "";
    var string: startMap is DEFAULT_START_MAP;
    var boolean: showHelp is FALSE;
  end struct;

const type: parserStats is new struct
    var integer: pk4Archives is 0;
    var string: requestedMapPath is "";
    var boolean: requestedMapFound is FALSE;
    var integer: filesTokenized is 0;
    var integer: mapFiles is 0;
    var integer: defFiles is 0;
    var integer: materialFiles is 0;
    var integer: scriptFiles is 0;
    var integer: guiFiles is 0;
    var integer: totalTokens is 0;
    var integer: quotedTokens is 0;
    var integer: wordTokens is 0;
    var integer: braceOpenTokens is 0;
    var integer: braceCloseTokens is 0;
    var integer: parenOpenTokens is 0;
    var integer: parenCloseTokens is 0;
    var integer: lineCommentsSkipped is 0;
    var integer: blockCommentsSkipped is 0;
    var integer: selectedMapEntities is 0;
    var integer: selectedMapKeyValuePairs is 0;
    var integer: selectedMapClassnames is 0;
    var integer: entityDefDecls is 0;
    var integer: materialDecls is 0;
    var integer: scriptFunctions is 0;
    var integer: guiWindowDefs is 0;
    var string: firstTokenizedFile is "";
    var string: firstToken is "";
    var string: firstQuotedToken is "";
    var string: firstMapClassname is "";
    var string: firstMapKeyValue is "";
    var string: firstEntityDefDecl is "";
    var string: firstMaterialDecl is "";
    var string: firstScriptFunction is "";
    var string: firstGuiWindowDef is "";
  end struct;

const proc: logInfo (in string: msg) is func
  begin
    writeln("[parser] " <& msg);
  end func;

const proc: logError (in string: msg) is func
  begin
    writeln("[parser-error] " <& msg);
  end func;

const func string: joinPath (in string: leftPath, in string: rightPath) is func
  result
    var string: joined is "";
  begin
    if leftPath = "" then
      joined := rightPath;
    elsif endsWith(leftPath, "/") or endsWith(leftPath, "\\") then
      joined := leftPath <& rightPath;
    else
      joined := leftPath <& "/" <& rightPath;
    end if;
  end func;

const func boolean: isPk4Name (in string: fileName) is
    return endsWith(lower(fileName), ".pk4");

const func string: normalizedAssetPath (in string: filePath) is
    return replace(lower(filePath), "\\", "/");

const func string: mapNameToAssetPath (in string: mapName) is func
  result
    var string: assetPath is "";
  begin
    assetPath := normalizedAssetPath(mapName);
    if not startsWith(assetPath, "maps/") then
      assetPath := "maps/" <& assetPath;
    end if;
    if not endsWith(assetPath, ".map") then
      assetPath &:= ".map";
    end if;
  end func;

const func boolean: isWhitespace (in char: ch) is
    return ch = ' ' or ch = '\t' or ch = '\n' or ch = '\r';

const func boolean: isSingleTokenChar (in char: ch) is
    return ch = '{' or ch = '}' or ch = '(' or ch = ')';

const proc: appendToken (inout parserStats: stats,
    inout array string: tokens, in string: tokenText,
    in boolean: quoted) is func
  begin
    if tokenText <> "" then
      tokens &:= tokenText;
      stats.totalTokens +:= 1;
      if stats.firstToken = "" then
        stats.firstToken := tokenText;
      end if;
      if quoted then
        stats.quotedTokens +:= 1;
        if stats.firstQuotedToken = "" then
          stats.firstQuotedToken := tokenText;
        end if;
      else
        stats.wordTokens +:= 1;
      end if;
      if tokenText = "{" then
        stats.braceOpenTokens +:= 1;
      elsif tokenText = "}" then
        stats.braceCloseTokens +:= 1;
      elsif tokenText = "(" then
        stats.parenOpenTokens +:= 1;
      elsif tokenText = ")" then
        stats.parenCloseTokens +:= 1;
      end if;
    end if;
  end func;

const func array string: tokenizeDoomText (inout parserStats: stats,
    in string: content) is func
  result
    var array string: tokens is 0 times "";
  local
    var integer: idx is 1;
    var integer: startIdx is 1;
    var string: tokenText is "";
    var char: ch is ' ';
    var char: nextCh is ' ';
  begin
    while idx <= length(content) do
      ch := content[idx];
      if isWhitespace(ch) then
        incr(idx);
      elsif ch = '/' and idx < length(content) then
        nextCh := content[succ(idx)];
        if nextCh = '/' then
          stats.lineCommentsSkipped +:= 1;
          idx +:= 2;
          while idx <= length(content) and content[idx] <> '\n' do
            incr(idx);
          end while;
        elsif nextCh = '*' then
          stats.blockCommentsSkipped +:= 1;
          idx +:= 2;
          while idx < length(content) and not
              (content[idx] = '*' and content[succ(idx)] = '/') do
            incr(idx);
          end while;
          if idx < length(content) then
            idx +:= 2;
          end if;
        else
          startIdx := idx;
          incr(idx);
          while idx <= length(content) and not isWhitespace(content[idx]) and
              not isSingleTokenChar(content[idx]) and content[idx] <> '"' do
            if content[idx] = '/' and idx < length(content) and
                (content[succ(idx)] = '/' or content[succ(idx)] = '*') then
              idx := length(content) + 1;
            else
              incr(idx);
            end if;
          end while;
          tokenText := content[startIdx .. pred(idx)];
          appendToken(stats, tokens, tokenText, FALSE);
        end if;
      elsif ch = '"' then
        incr(idx);
        startIdx := idx;
        while idx <= length(content) and content[idx] <> '"' do
          incr(idx);
        end while;
        if idx > startIdx then
          tokenText := content[startIdx .. pred(idx)];
        else
          tokenText := "";
        end if;
        appendToken(stats, tokens, tokenText, TRUE);
        if idx <= length(content) and content[idx] = '"' then
          incr(idx);
        end if;
      elsif isSingleTokenChar(ch) then
        appendToken(stats, tokens, str(ch), FALSE);
        incr(idx);
      else
        startIdx := idx;
        while idx <= length(content) and not isWhitespace(content[idx]) and
            not isSingleTokenChar(content[idx]) and content[idx] <> '"' do
          if content[idx] = '/' and idx < length(content) and
              (content[succ(idx)] = '/' or content[succ(idx)] = '*') then
            idx := length(content) + 1;
          else
            incr(idx);
          end if;
        end while;
        tokenText := content[startIdx .. pred(idx)];
        appendToken(stats, tokens, tokenText, FALSE);
      end if;
    end while;
  end func;

const proc: parseSelectedMapTokens (inout parserStats: stats,
    in array string: tokens) is func
  local
    var string: tokenText is "";
    var string: pendingKey is "";
    var integer: depth is 0;
  begin
    for tokenText range tokens do
      if tokenText = "{" then
        if depth = 0 then
          stats.selectedMapEntities +:= 1;
          pendingKey := "";
        end if;
        incr(depth);
      elsif tokenText = "}" then
        decr(depth);
        pendingKey := "";
      elsif depth = 1 then
        if pendingKey = "" then
          pendingKey := tokenText;
        else
          stats.selectedMapKeyValuePairs +:= 1;
          if stats.firstMapKeyValue = "" then
            stats.firstMapKeyValue := pendingKey <& "=" <& tokenText;
          end if;
          if pendingKey = "classname" then
            stats.selectedMapClassnames +:= 1;
            if stats.firstMapClassname = "" then
              stats.firstMapClassname := tokenText;
            end if;
          end if;
          pendingKey := "";
        end if;
      end if;
    end for;
  end func;

const proc: parseDefTokens (inout parserStats: stats,
    in array string: tokens) is func
  local
    var integer: idx is 1;
  begin
    while idx <= length(tokens) do
      if tokens[idx] = "entityDef" and idx < length(tokens) then
        stats.entityDefDecls +:= 1;
        if stats.firstEntityDefDecl = "" then
          stats.firstEntityDefDecl := tokens[succ(idx)];
        end if;
      end if;
      incr(idx);
    end while;
  end func;

const proc: parseMaterialTokens (inout parserStats: stats,
    in array string: tokens) is func
  local
    var integer: idx is 1;
    var integer: depth is 0;
  begin
    while idx <= length(tokens) do
      if tokens[idx] = "{" then
        incr(depth);
      elsif tokens[idx] = "}" then
        decr(depth);
      elsif depth = 0 and idx < length(tokens) and tokens[succ(idx)] = "{" then
        stats.materialDecls +:= 1;
        if stats.firstMaterialDecl = "" then
          stats.firstMaterialDecl := tokens[idx];
        end if;
      end if;
      incr(idx);
    end while;
  end func;

const proc: parseScriptTokens (inout parserStats: stats,
    in array string: tokens) is func
  local
    var integer: idx is 1;
  begin
    while idx <= length(tokens) do
      if tokens[idx] = "void" and idx < length(tokens) then
        stats.scriptFunctions +:= 1;
        if stats.firstScriptFunction = "" then
          stats.firstScriptFunction := tokens[succ(idx)];
        end if;
      end if;
      incr(idx);
    end while;
  end func;

const proc: parseGuiTokens (inout parserStats: stats,
    in array string: tokens) is func
  local
    var integer: idx is 1;
  begin
    while idx <= length(tokens) do
      if lower(tokens[idx]) = "windowdef" and idx < length(tokens) then
        stats.guiWindowDefs +:= 1;
        if stats.firstGuiWindowDef = "" then
          stats.firstGuiWindowDef := tokens[succ(idx)];
        end if;
      end if;
      incr(idx);
    end while;
  end func;

const proc: inspectTextFile (inout parserStats: stats,
    in string: path, in string: content) is func
  local
    var string: normalizedPath is "";
    var array string: tokens is 0 times "";
  begin
    normalizedPath := normalizedAssetPath(path);
    tokens := tokenizeDoomText(stats, content);
    if length(tokens) <> 0 then
      stats.filesTokenized +:= 1;
      if stats.firstTokenizedFile = "" then
        stats.firstTokenizedFile := normalizedPath;
      end if;
      if normalizedPath = stats.requestedMapPath then
        stats.mapFiles +:= 1;
        stats.requestedMapFound := TRUE;
        parseSelectedMapTokens(stats, tokens);
      elsif endsWith(normalizedPath, ".def") then
        stats.defFiles +:= 1;
        parseDefTokens(stats, tokens);
      elsif endsWith(normalizedPath, ".mtr") then
        stats.materialFiles +:= 1;
        parseMaterialTokens(stats, tokens);
      elsif endsWith(normalizedPath, ".script") then
        stats.scriptFiles +:= 1;
        parseScriptTokens(stats, tokens);
      elsif endsWith(normalizedPath, ".gui") then
        stats.guiFiles +:= 1;
        parseGuiTokens(stats, tokens);
      end if;
    end if;
  end func;

const func array string: findPk4Archives (in string: basePath) is func
  result
    var array string: pk4Files is 0 times "";
  local
    var array string: names is 0 times "";
    var string: name is "";
  begin
    if fileType(basePath) = FILE_DIR then
      names := readDir(basePath);
      for name range names do
        if isPk4Name(name) and fileType(joinPath(basePath, name)) = FILE_REGULAR then
          pk4Files &:= joinPath(basePath, name);
        end if;
      end for;
    end if;
  end func;

const proc: scanArchive (inout parserStats: stats,
    in string: pk4File) is func
  local
    var fileSys: zipFs is fileSys.value;
    var array string: paths is 0 times "";
    var string: path is "";
    var string: normalizedPath is "";
  begin
    zipFs := openZip(pk4File);
    if zipFs = fileSys.value then
      logError("Could not open pk4 archive: " <& pk4File);
    else
      paths := sort(readDir(zipFs, RECURSIVE));
      for path range paths do
        normalizedPath := normalizedAssetPath(path);
        if normalizedPath = stats.requestedMapPath or
            endsWith(normalizedPath, ".def") or
            endsWith(normalizedPath, ".mtr") or
            endsWith(normalizedPath, ".script") or
            endsWith(normalizedPath, ".gui") then
          inspectTextFile(stats, path, getFile(zipFs, path));
        end if;
      end for;
      close(zipFs);
    end if;
  end func;

const proc: parseArgs (inout parserConfig: config) is func
  local
    var array string: args is 0 times "";
    var integer: argIdx is 1;
  begin
    args := argv(PROGRAM);
    while argIdx <= length(args) do
      if args[argIdx] = "--help" or args[argIdx] = "-h" then
        config.showHelp := TRUE;
      elsif args[argIdx] = "--doom3_data_path" and argIdx < length(args) then
        incr(argIdx);
        config.dataPath := convDosPath(args[argIdx]);
      elsif args[argIdx] = "--doom3_base_path" and argIdx < length(args) then
        incr(argIdx);
        config.basePath := convDosPath(args[argIdx]);
      elsif args[argIdx] = "--doom3_start_map" and argIdx < length(args) then
        incr(argIdx);
        config.startMap := args[argIdx];
      elsif args[argIdx] = "+map" and argIdx < length(args) then
        incr(argIdx);
        config.startMap := args[argIdx];
      elsif args[argIdx] = "+set" and argIdx + 2 <= length(args) then
        if args[argIdx + 1] = "fs_basepath" then
          config.dataPath := convDosPath(args[argIdx + 2]);
        elsif args[argIdx + 1] = "fs_game" then
          config.basePath := convDosPath(args[argIdx + 2]);
        end if;
        argIdx +:= 2;
      end if;
      incr(argIdx);
    end while;
    if config.basePath = "" then
      config.basePath := joinPath(config.dataPath, DEFAULT_BASE_DIR);
    end if;
  end func;

const proc: showUsage is func
  begin
    writeln("Usage:");
    writeln("  s7 doom3_seed7_parser.s7 --doom3_data_path <doom3-root>");
    writeln("  s7 doom3_seed7_parser.s7 +set fs_basepath <doom3-root> +map <map>");
    writeln("");
    writeln("Scans user-owned Doom 3 pk4 files for lexer/parser readiness.");
  end func;

const proc: printStats (in parserStats: stats) is func
  begin
    logInfo("pk4_archives=" <& stats.pk4Archives);
    logInfo("requested_map=" <& stats.requestedMapPath);
    logInfo("requested_map_found=" <& stats.requestedMapFound);
    logInfo("parser_files tokenized=" <& stats.filesTokenized <&
        " maps=" <& stats.mapFiles <& " defs=" <& stats.defFiles <&
        " materials=" <& stats.materialFiles <& " scripts=" <&
        stats.scriptFiles <& " guis=" <& stats.guiFiles);
    logInfo("lexer_tokens total=" <& stats.totalTokens <&
        " quoted=" <& stats.quotedTokens <& " words=" <&
        stats.wordTokens <& " braces=" <& stats.braceOpenTokens <&
        "/" <& stats.braceCloseTokens <& " parens=" <&
        stats.parenOpenTokens <& "/" <& stats.parenCloseTokens);
    logInfo("lexer_comments line=" <& stats.lineCommentsSkipped <&
        " block=" <& stats.blockCommentsSkipped);
    logInfo("parser_map entities=" <& stats.selectedMapEntities <&
        " key_values=" <& stats.selectedMapKeyValuePairs <&
        " classnames=" <& stats.selectedMapClassnames);
    logInfo("parser_decls entityDef=" <& stats.entityDefDecls <&
        " materials=" <& stats.materialDecls);
    logInfo("parser_scripts functions=" <& stats.scriptFunctions <&
        " gui_windows=" <& stats.guiWindowDefs);
    if stats.firstTokenizedFile <> "" then
      logInfo("first_tokenized_file=" <& stats.firstTokenizedFile);
    end if;
    if stats.firstToken <> "" then
      logInfo("first_token=" <& stats.firstToken);
    end if;
    if stats.firstQuotedToken <> "" then
      logInfo("first_quoted_token=" <& stats.firstQuotedToken);
    end if;
    if stats.firstMapClassname <> "" then
      logInfo("first_map_classname=" <& stats.firstMapClassname);
    end if;
    if stats.firstMapKeyValue <> "" then
      logInfo("first_map_key_value=" <& stats.firstMapKeyValue);
    end if;
    if stats.firstEntityDefDecl <> "" then
      logInfo("first_entityDef_decl=" <& stats.firstEntityDefDecl);
    end if;
    if stats.firstMaterialDecl <> "" then
      logInfo("first_material_decl=" <& stats.firstMaterialDecl);
    end if;
    if stats.firstScriptFunction <> "" then
      logInfo("first_script_function=" <& stats.firstScriptFunction);
    end if;
    if stats.firstGuiWindowDef <> "" then
      logInfo("first_gui_windowDef=" <& stats.firstGuiWindowDef);
    end if;
    logInfo("parser_probe_ready=" <& (stats.pk4Archives <> 0 and
        stats.requestedMapFound and stats.totalTokens <> 0 and
        stats.selectedMapEntities <> 0 and stats.selectedMapClassnames <> 0 and
        stats.entityDefDecls <> 0 and stats.materialDecls <> 0 and
        stats.scriptFunctions <> 0 and stats.guiWindowDefs <> 0));
  end func;

const proc: main is func
  local
    var parserConfig: config is parserConfig.value;
    var parserStats: stats is parserStats.value;
    var array string: pk4Files is 0 times "";
    var string: pk4File is "";
  begin
    parseArgs(config);
    if config.showHelp then
      showUsage;
    else
      stats.requestedMapPath := mapNameToAssetPath(config.startMap);
      if fileType(config.basePath) <> FILE_DIR then
        logError("Doom 3 base directory not found: " <& config.basePath);
      else
        pk4Files := sort(findPk4Archives(config.basePath));
        stats.pk4Archives := length(pk4Files);
        if length(pk4Files) = 0 then
          logError("No .pk4 archives found in: " <& config.basePath);
        else
          for pk4File range pk4Files do
            scanArchive(stats, pk4File);
          end for;
          printStats(stats);
        end if;
      end if;
    end if;
  end func;
