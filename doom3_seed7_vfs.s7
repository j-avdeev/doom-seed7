(********************************************************************)
(*  doom3_seed7_vfs.s7                                              *)
(*                                                                  *)
(*  Focused Doom 3 / id Tech 4 virtual-filesystem probe for Seed7.  *)
(*  It validates pk4 mount ordering for user-owned assets.           *)
(********************************************************************)

$ include "seed7_05.s7i";
$ include "osfiles.s7i";
$ include "zip.s7i";

const string: DEFAULT_DATA_PATH is ".";
const string: DEFAULT_BASE_DIR is "base";
const string: DEFAULT_START_MAP is "game/mars_city1";

const type: vfsConfig is new struct
    var string: dataPath is DEFAULT_DATA_PATH;
    var string: basePath is "";
    var string: startMap is DEFAULT_START_MAP;
    var boolean: showHelp is FALSE;
  end struct;

const type: vfsStats is new struct
    var integer: pk4Archives is 0;
    var string: requestedMapPath is "";
    var boolean: requestedMapFound is FALSE;
    var integer: requestedMapCandidates is 0;
    var string: firstMount is "";
    var string: lastMount is "";
    var string: selectedMapArchive is "";
    var string: playerStartOrigin is "";
    var string: playerStartAngle is "";
    var boolean: playerStartParsed is FALSE;
    var float: playerStartX is 0.0;
    var float: playerStartY is 0.0;
    var float: playerStartZ is 0.0;
    var float: playerStartYaw is 0.0;
  end struct;

const proc: logInfo (in string: msg) is func
  begin
    writeln("[vfs] " <& msg);
  end func;

const proc: logError (in string: msg) is func
  begin
    writeln("[vfs-error] " <& msg);
  end func;

const func string: joinPath (in string: leftPath, in string: rightPath) is func
  result
    var string: joined is "";
  begin
    if leftPath = "" then
      joined := rightPath;
    elsif endsWith(leftPath, "/") or endsWith(leftPath, "\\") then
      joined := leftPath <& rightPath;
    else
      joined := leftPath <& "/" <& rightPath;
    end if;
  end func;

const func boolean: isPk4Name (in string: fileName) is
    return endsWith(lower(fileName), ".pk4");

const func string: normalizedAssetPath (in string: filePath) is
    return replace(lower(filePath), "\\", "/");

const func string: mapNameToAssetPath (in string: mapName) is func
  result
    var string: assetPath is "";
  begin
    assetPath := normalizedAssetPath(mapName);
    if not startsWith(assetPath, "maps/") then
      assetPath := "maps/" <& assetPath;
    end if;
    if not endsWith(assetPath, ".map") then
      assetPath &:= ".map";
    end if;
  end func;

const func string: quotedValueAfter (in string: content,
    in string: keyName, in integer: startPos) is func
  result
    var string: value is "";
  local
    var string: keyText is "";
    var integer: keyPos is 0;
    var integer: keyEnd is 0;
    var integer: valueStart is 0;
    var integer: valueEnd is 0;
  begin
    keyText := "\"" <& keyName <& "\"";
    keyPos := pos(lower(content), lower(keyText), startPos);
    if keyPos <> 0 then
      keyEnd := pos(content, "\"", succ(keyPos));
      if keyEnd <> 0 then
        valueStart := pos(content, "\"", succ(keyEnd));
        if valueStart <> 0 then
          valueEnd := pos(content, "\"", succ(valueStart));
          if valueEnd <> 0 then
            value := content[succ(valueStart) .. pred(valueEnd)];
          end if;
        end if;
      end if;
    end if;
  end func;

const proc: parsePlayerStart (inout vfsStats: stats,
    in string: content) is func
  local
    var string: contentLower is "";
    var integer: playerStartPos is 0;
    var array string: originParts is 0 times "";
  begin
    contentLower := lower(content);
    playerStartPos := pos(contentLower, "\"classname\" \"info_player_start\"");
    stats.playerStartOrigin := "";
    stats.playerStartAngle := "";
    stats.playerStartParsed := FALSE;
    if playerStartPos <> 0 then
      stats.playerStartOrigin := quotedValueAfter(content, "origin",
          playerStartPos);
      stats.playerStartAngle := quotedValueAfter(content, "angle",
          playerStartPos);
      originParts := noEmptyStrings(split(trim(stats.playerStartOrigin), ' '));
      if length(originParts) >= 3 then
        block
          stats.playerStartX := float(originParts[1]);
          stats.playerStartY := float(originParts[2]);
          stats.playerStartZ := float(originParts[3]);
          if stats.playerStartAngle <> "" then
            stats.playerStartYaw := float(trim(stats.playerStartAngle));
          else
            stats.playerStartYaw := 0.0;
          end if;
          stats.playerStartParsed := TRUE;
        exception
          catch RANGE_ERROR:
            stats.playerStartParsed := FALSE;
        end block;
      end if;
    end if;
  end func;

const func array string: findPk4Archives (in string: basePath) is func
  result
    var array string: pk4Files is 0 times "";
  local
    var array string: names is 0 times "";
    var string: name is "";
  begin
    if fileType(basePath) = FILE_DIR then
      names := readDir(basePath);
      for name range names do
        if isPk4Name(name) and fileType(joinPath(basePath, name)) = FILE_REGULAR then
          pk4Files &:= joinPath(basePath, name);
        end if;
      end for;
    end if;
  end func;

const proc: scanArchive (inout vfsStats: stats,
    in string: pk4File) is func
  local
    var fileSys: zipFs is fileSys.value;
    var array string: paths is 0 times "";
    var string: path is "";
  begin
    zipFs := openZip(pk4File);
    if zipFs = fileSys.value then
      logError("could not open pk4 archive: " <& pk4File);
    else
      paths := readDir(zipFs, RECURSIVE);
      for path range paths do
        if normalizedAssetPath(path) = stats.requestedMapPath then
          stats.requestedMapFound := TRUE;
          stats.requestedMapCandidates +:= 1;
          stats.selectedMapArchive := pk4File;
          parsePlayerStart(stats, getFile(zipFs, path));
        end if;
      end for;
      close(zipFs);
    end if;
  end func;

const proc: parseArgs (inout vfsConfig: config) is func
  local
    var array string: args is 0 times "";
    var integer: argIdx is 1;
  begin
    args := argv(PROGRAM);
    while argIdx <= length(args) do
      if args[argIdx] = "--help" or args[argIdx] = "-h" then
        config.showHelp := TRUE;
      elsif args[argIdx] = "--doom3_data_path" and argIdx < length(args) then
        incr(argIdx);
        config.dataPath := convDosPath(args[argIdx]);
      elsif args[argIdx] = "--doom3_base_path" and argIdx < length(args) then
        incr(argIdx);
        config.basePath := convDosPath(args[argIdx]);
      elsif args[argIdx] = "--doom3_start_map" and argIdx < length(args) then
        incr(argIdx);
        config.startMap := args[argIdx];
      elsif args[argIdx] = "+map" and argIdx < length(args) then
        incr(argIdx);
        config.startMap := args[argIdx];
      elsif args[argIdx] = "+set" and argIdx + 2 <= length(args) then
        if args[argIdx + 1] = "fs_basepath" then
          config.dataPath := convDosPath(args[argIdx + 2]);
        elsif args[argIdx + 1] = "fs_game" then
          config.basePath := convDosPath(args[argIdx + 2]);
        end if;
        argIdx +:= 2;
      end if;
      incr(argIdx);
    end while;
    if config.basePath = "" then
      config.basePath := joinPath(config.dataPath, DEFAULT_BASE_DIR);
    end if;
  end func;

const proc: showUsage is func
  begin
    writeln("Usage:");
    writeln("  s7 doom3_seed7_vfs.s7 --doom3_data_path <doom3-root>");
    writeln("  s7 doom3_seed7_vfs.s7 +set fs_basepath <doom3-root> +map <map>");
    writeln("");
    writeln("Scans user-owned Doom 3 pk4 files for VFS override readiness.");
  end func;

const proc: printStats (in vfsStats: stats) is func
  begin
    logInfo("pk4_archives=" <& stats.pk4Archives);
    logInfo("requested_map=" <& stats.requestedMapPath);
    logInfo("requested_map_found=" <& stats.requestedMapFound);
    logInfo("requested_map_candidates=" <& stats.requestedMapCandidates);
    if stats.firstMount <> "" then
      logInfo("first_mount=" <& stats.firstMount);
    end if;
    if stats.lastMount <> "" then
      logInfo("last_mount=" <& stats.lastMount);
    end if;
    if stats.selectedMapArchive <> "" then
      logInfo("selected_map_archive=" <& stats.selectedMapArchive);
    end if;
    if stats.playerStartOrigin <> "" then
      logInfo("player_start_origin=" <& stats.playerStartOrigin);
    end if;
    if stats.playerStartAngle <> "" then
      logInfo("player_start_angle=" <& stats.playerStartAngle);
    end if;
    logInfo("player_start_parsed=" <& stats.playerStartParsed);
    if stats.playerStartParsed then
      logInfo("player_spawn_x=" <& stats.playerStartX);
      logInfo("player_spawn_y=" <& stats.playerStartY);
      logInfo("player_spawn_z=" <& stats.playerStartZ);
      logInfo("player_spawn_yaw=" <& stats.playerStartYaw);
    end if;
    logInfo("vfs_override_ready=" <& (stats.pk4Archives <> 0 and
        stats.requestedMapFound and stats.selectedMapArchive = stats.lastMount and
        stats.playerStartParsed));
  end func;

const proc: main is func
  local
    var vfsConfig: config is vfsConfig.value;
    var vfsStats: stats is vfsStats.value;
    var array string: pk4Files is 0 times "";
    var string: pk4File is "";
  begin
    parseArgs(config);
    if config.showHelp then
      showUsage;
    else
      stats.requestedMapPath := mapNameToAssetPath(config.startMap);
      if fileType(config.basePath) <> FILE_DIR then
        logError("Doom 3 base directory not found: " <& config.basePath);
      else
        pk4Files := sort(findPk4Archives(config.basePath));
        stats.pk4Archives := length(pk4Files);
        if length(pk4Files) = 0 then
          logError("No .pk4 archives found in: " <& config.basePath);
        else
          stats.firstMount := pk4Files[1];
          stats.lastMount := pk4Files[length(pk4Files)];
          for pk4File range pk4Files do
            logInfo("mount=" <& pk4File);
            scanArchive(stats, pk4File);
          end for;
          printStats(stats);
        end if;
      end if;
    end if;
  end func;
