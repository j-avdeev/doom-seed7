(********************************************************************)
(*  doom3_seed7.s7   Doom 3 / id Tech 4 Seed7 port foundation       *)
(*                                                                  *)
(*  Stage 1 is an asset/runtime scanner, not a playable renderer.   *)
(*  It never ships commercial Doom 3 data. Point it at a legal       *)
(*  Doom 3 installation that contains base/*.pk4 files.              *)
(********************************************************************)

$ include "seed7_05.s7i";
$ include "osfiles.s7i";
$ include "zip.s7i";
$ include "math.s7i";

