const func string: textureStemForMaterial (in archiveStats: stats,
    in string: materialName) is func
  result
    var string: textureStem is "";
  local
    var integer: bindingIndex is 1;
    var string: normalizedName is "";
  begin
    normalizedName := lower(materialName);
    while bindingIndex <= length(stats.mtrBindingNames) and textureStem = "" do
      if stats.mtrBindingNames[bindingIndex] = normalizedName then
        textureStem := stats.mtrBindingTextureStems[bindingIndex];
      end if;
      incr(bindingIndex);
    end while;
  end func;

const func integer: countRenderSurfaceTextureStatus (in archiveStats: stats,
    in string: statusKind) is func
  result
    var integer: surfaceCount is 0;
  local
    var runtimeRenderSurface: surface is runtimeRenderSurface.value;
    var string: textureStem is "";
  begin
    for surface range stats.runtimeRenderSurfaces do
      if surface.visible then
        textureStem := textureStemForMaterial(stats, surface.materialName);
        if statusKind = "bound" and textureStem <> "" then
          surfaceCount +:= 1;
        elsif statusKind = "available" and textureStem <> "" and
            containsString(stats.imageAssetStems, textureStem) then
          surfaceCount +:= 1;
        elsif statusKind = "missing" and textureStem <> "" and
            not containsString(stats.imageAssetStems, textureStem) then
          surfaceCount +:= 1;
        end if;
      end if;
    end for;
  end func;

const func string: firstRenderSurfaceMaterialTexture (
    in archiveStats: stats) is func
  result
    var string: textureStem is "";
  local
    var runtimeRenderSurface: surface is runtimeRenderSurface.value;
  begin
    for surface range stats.runtimeRenderSurfaces do
      if textureStem = "" and surface.visible then
        textureStem := textureStemForMaterial(stats, surface.materialName);
      end if;
    end for;
  end func;

