const float: PLAYER_SIM_STEP_DISTANCE is 16.0;
const integer: PLAYER_SIM_STEPS is 4;
const integer: DEBUG_RENDER_GRID_SIZE is 16;
const float: DEBUG_RENDER_CELL_SIZE is 32.0;
const float: TRIGGER_TOUCH_RADIUS is 32.0;
const float: RUNTIME_ENTITY_COLLISION_RADIUS is 24.0;
const integer: ENTITY_DEF_INHERIT_LIMIT is 8;

