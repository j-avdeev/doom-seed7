const proc: logInfo (in string: msg) is func
  begin
    writeln("[info] " <& msg);
  end func;

const proc: logWarn (in string: msg) is func
  begin
    writeln("[warn] " <& msg);
  end func;

const proc: logError (in string: msg) is func
  begin
    writeln("[error] " <& msg);
  end func;

const proc: setCvar (inout array cvarRecord: cvars, in string: cvarName,
    in string: cvarValue) is func
  local
    var cvarRecord: cvar is cvarRecord.value;
    var integer: cvarIdx is 1;
    var string: normalizedName is "";
    var boolean: updated is FALSE;
  begin
    normalizedName := lower(cvarName);
    while cvarIdx <= length(cvars) and not updated do
      if cvars[cvarIdx].name = normalizedName then
        cvars[cvarIdx].value := cvarValue;
        updated := TRUE;
      end if;
      incr(cvarIdx);
    end while;
    if not updated and normalizedName <> "" then
      cvar.name := normalizedName;
      cvar.value := cvarValue;
      cvars &:= cvar;
    end if;
  end func;

const func string: cvarValueForName (in array cvarRecord: cvars,
    in string: cvarName) is func
  result
    var string: cvarValue is "";
  local
    var cvarRecord: cvar is cvarRecord.value;
    var string: normalizedName is "";
  begin
    normalizedName := lower(cvarName);
    for cvar range cvars do
      if cvarValue = "" and cvar.name = normalizedName then
        cvarValue := cvar.value;
      end if;
    end for;
  end func;

const func boolean: isRuntimeCoreCvar (in string: cvarName) is func
  result
    var boolean: coreCvar is FALSE;
  begin
    coreCvar := cvarName = "doom3_data_path" or
        cvarName = "doom3_base_path" or cvarName = "doom3_start_map" or
        cvarName = "doom3_render_mode" or cvarName = "doom3_save_path" or
        cvarName = "doom3_config_path" or cvarName = "fs_basepath" or
        cvarName = "fs_game";
  end func;

const func integer: countCustomCvars (in array cvarRecord: cvars) is func
  result
    var integer: customCvars is 0;
  local
    var cvarRecord: cvar is cvarRecord.value;
  begin
    for cvar range cvars do
      if not isRuntimeCoreCvar(cvar.name) then
        customCvars +:= 1;
      end if;
    end for;
  end func;

const func string: firstCustomCvarName (in array cvarRecord: cvars) is func
  result
    var string: cvarName is "";
  local
    var cvarRecord: cvar is cvarRecord.value;
  begin
    for cvar range cvars do
      if cvarName = "" and not isRuntimeCoreCvar(cvar.name) then
        cvarName := cvar.name;
      end if;
    end for;
  end func;

const func string: joinPath (in string: leftPath, in string: rightPath) is func
  result
    var string: path is "";
  begin
    if leftPath = "" or leftPath = "." then
      path := rightPath;
    elsif endsWith(leftPath, "/") or endsWith(leftPath, "\\") then
      path := leftPath & rightPath;
    else
      path := leftPath & "/" & rightPath;
    end if;
  end func;

const func boolean: isPk4Name (in string: fileName) is
  return endsWith(lower(fileName), ".pk4");

const func string: normalizedAssetPath (in string: filePath) is
  return replace(lower(filePath), "\\", "/");

const func string: mapNameToAssetPath (in string: mapName) is func
  result
    var string: mapPath is "";
  begin
    mapPath := normalizedAssetPath(mapName);
    if not startsWith(mapPath, "maps/") then
      mapPath := "maps/" & mapPath;
    end if;
    if not endsWith(mapPath, ".map") then
      mapPath &:= ".map";
    end if;
  end func;

const func string: compiledSiblingPath (in string: mapPath,
    in string: suffix) is func
  result
    var string: sibling is "";
  begin
    sibling := mapPath[.. pred(pred(pred(pred(length(mapPath)))))] <& suffix;
  end func;

const func boolean: hasAnySuffix (in string: filePath, in string: suffix1,
    in string: suffix2, in string: suffix3) is func
  result
    var boolean: matched is FALSE;
  local
    var string: pathLower is "";
  begin
    pathLower := lower(filePath);
    matched := endsWith(pathLower, suffix1) or
        endsWith(pathLower, suffix2) or
        endsWith(pathLower, suffix3);
  end func;

const func boolean: isImageRef (in string: filePath) is
  return hasAnySuffix(filePath, ".tga", ".dds", ".jpg") or
      endsWith(lower(filePath), ".png");

const func boolean: isSoundRef (in string: filePath) is
  return hasAnySuffix(filePath, ".wav", ".ogg", ".mp3");

const func boolean: isModelRef (in string: filePath) is func
  result
    var boolean: modelRef is FALSE;
  local
    var string: pathLower is "";
  begin
    pathLower := lower(filePath);
    modelRef := hasAnySuffix(pathLower, ".lwo", ".ase", ".ma") or
        endsWith(pathLower, ".md5mesh") or endsWith(pathLower, ".md5anim");
  end func;

const func boolean: isTextAssetPath (in string: filePath) is func
  result
    var boolean: isTextAsset is FALSE;
  local
    var string: pathLower is "";
  begin
    pathLower := lower(filePath);
    isTextAsset := endsWith(pathLower, ".decl") or endsWith(pathLower, ".mtr") or
        endsWith(pathLower, ".def") or endsWith(pathLower, ".map") or
        endsWith(pathLower, ".script");
  end func;

const func integer: countOccurrences (in string: content, in string: token) is func
  result
    var integer: count is 0;
  local
    var integer: searchPos is 1;
    var integer: foundPos is 0;
  begin
    foundPos := pos(content, token, searchPos);
    while foundPos <> 0 do
      count +:= 1;
      searchPos := foundPos + length(token);
      foundPos := pos(content, token, searchPos);
    end while;
  end func;

const func integer: countAnyAssetRefs (in string: content, in string: ext1,
    in string: ext2, in string: ext3) is func
  result
    var integer: refs is 0;
  local
    var string: contentLower is "";
  begin
    contentLower := lower(content);
    refs := countOccurrences(contentLower, ext1) +
        countOccurrences(contentLower, ext2) +
        countOccurrences(contentLower, ext3);
  end func;

const func boolean: containsString (in array string: values,
    in string: searched) is func
  result
    var boolean: found is FALSE;
  local
    var string: value is "";
  begin
    for value range values do
      if value = searched then
        found := TRUE;
      end if;
    end for;
  end func;

const proc: appendUnique (inout array string: values, in string: value) is func
  begin
    if value <> "" and not containsString(values, value) then
      values &:= value;
    end if;
  end func;

const func boolean: isTokenEdgeChar (in char: aChar) is func
  result
    var boolean: edgeChar is FALSE;
  begin
    edgeChar := aChar = '"' or aChar = '(' or aChar = ')' or aChar = '{' or
        aChar = '}' or aChar = '[' or aChar = ']' or aChar = ',' or
        aChar = ';';
  end func;

const func string: cleanedToken (in string: token) is func
  result
    var string: cleanToken is "";
  local
    var integer: firstIndex is 1;
    var integer: lastIndex is 0;
  begin
    cleanToken := trim(token);
    firstIndex := 1;
    lastIndex := length(cleanToken);
    while firstIndex <= lastIndex and isTokenEdgeChar(cleanToken[firstIndex]) do
      incr(firstIndex);
    end while;
    while lastIndex >= firstIndex and isTokenEdgeChar(cleanToken[lastIndex]) do
      decr(lastIndex);
    end while;
    if lastIndex >= firstIndex then
      cleanToken := cleanToken[firstIndex .. lastIndex];
    else
      cleanToken := "";
    end if;
  end func;

const func string: assetStem (in string: filePath) is func
  result
    var string: stem is "";
  begin
    stem := normalizedAssetPath(cleanedToken(filePath));
    if endsWith(stem, ".tga") or endsWith(stem, ".dds") or
        endsWith(stem, ".jpg") or endsWith(stem, ".png") or
        endsWith(stem, ".wav") or endsWith(stem, ".ogg") or
        endsWith(stem, ".mp3") or endsWith(stem, ".lwo") or
        endsWith(stem, ".ase") or endsWith(stem, ".ma") then
      stem := stem[.. length(stem) - 4];
    elsif endsWith(stem, ".md5mesh") then
      stem := stem[.. length(stem) - 8];
    elsif endsWith(stem, ".md5anim") then
      stem := stem[.. length(stem) - 8];
    end if;
  end func;

const func boolean: isMaterialName (in string: token) is func
  result
    var boolean: materialName is FALSE;
  local
    var string: tokenLower is "";
  begin
    tokenLower := lower(cleanedToken(token));
    materialName := (startsWith(tokenLower, "textures/") or
        startsWith(tokenLower, "editor/")) and
        not isImageRef(tokenLower) and not isSoundRef(tokenLower);
  end func;

const proc: updateSelectedBounds (inout archiveStats: stats,
    in float: x, in float: y, in float: z) is func
  begin
    if not stats.selectedBoundsValid then
      stats.selectedMinX := x;
      stats.selectedMinY := y;
      stats.selectedMinZ := z;
      stats.selectedMaxX := x;
      stats.selectedMaxY := y;
      stats.selectedMaxZ := z;
      stats.selectedBoundsValid := TRUE;
    else
      if x < stats.selectedMinX then
        stats.selectedMinX := x;
      end if;
      if y < stats.selectedMinY then
        stats.selectedMinY := y;
      end if;
      if z < stats.selectedMinZ then
        stats.selectedMinZ := z;
      end if;
      if x > stats.selectedMaxX then
        stats.selectedMaxX := x;
      end if;
      if y > stats.selectedMaxY then
        stats.selectedMaxY := y;
      end if;
      if z > stats.selectedMaxZ then
        stats.selectedMaxZ := z;
      end if;
    end if;
  end func;

const proc: addOriginToSelectedBounds (inout archiveStats: stats,
    in string: origin) is func
  local
    var array string: originParts is 0 times "";
    var float: x is 0.0;
    var float: y is 0.0;
    var float: z is 0.0;
  begin
    if origin <> "" then
      originParts := noEmptyStrings(split(trim(origin), ' '));
      if length(originParts) >= 3 then
        block
          x := float(originParts[1]);
          y := float(originParts[2]);
          z := float(originParts[3]);
          updateSelectedBounds(stats, x, y, z);
          stats.selectedOriginVectors +:= 1;
        exception
          catch RANGE_ERROR:
            noop;
        end block;
      end if;
    end if;
  end func;

const func boolean: canParseVector3 (in string: vectorText) is func
  result
    var boolean: parsed is FALSE;
  local
    var array string: parts is 0 times "";
    var float: x is 0.0;
    var float: y is 0.0;
    var float: z is 0.0;
  begin
    if vectorText <> "" then
      parts := noEmptyStrings(split(trim(vectorText), ' '));
      if length(parts) >= 3 then
        block
          x := float(parts[1]);
          y := float(parts[2]);
          z := float(parts[3]);
          parsed := TRUE;
        exception
          catch RANGE_ERROR:
            parsed := FALSE;
        end block;
      end if;
    end if;
  end func;

const proc: parseOriginIntoEntity (inout selectedMapEntity: mapEntity) is func
  local
    var array string: parts is 0 times "";
  begin
    mapEntity.hasOrigin := FALSE;
    if mapEntity.originText <> "" then
      parts := noEmptyStrings(split(trim(mapEntity.originText), ' '));
      if length(parts) >= 3 then
        block
          mapEntity.x := float(parts[1]);
          mapEntity.y := float(parts[2]);
          mapEntity.z := float(parts[3]);
          mapEntity.hasOrigin := TRUE;
        exception
          catch RANGE_ERROR:
            mapEntity.hasOrigin := FALSE;
        end block;
      end if;
    end if;
  end func;

const proc: parseAngleIntoEntity (inout selectedMapEntity: mapEntity) is func
  begin
    mapEntity.hasAngle := FALSE;
    if mapEntity.angleText <> "" then
      block
        mapEntity.yaw := float(mapEntity.angleText);
        mapEntity.hasAngle := TRUE;
      exception
        catch RANGE_ERROR:
          mapEntity.hasAngle := FALSE;
      end block;
    end if;
  end func;

const proc: parseHealthIntoEntity (inout selectedMapEntity: mapEntity) is func
  begin
    mapEntity.hasHealth := FALSE;
    if mapEntity.healthText <> "" then
      block
        mapEntity.health := integer(mapEntity.healthText);
        mapEntity.hasHealth := TRUE;
      exception
        catch RANGE_ERROR:
          mapEntity.hasHealth := FALSE;
      end block;
    end if;
  end func;

const func string: quotedValueAfter (in string: content, in string: keyName,
    in integer: startPos) is func
  result
    var string: value is "";
  local
    var string: keyToken is "";
    var integer: keyPos is 0;
    var integer: quoteStart is 0;
    var integer: quoteEnd is 0;
  begin
    keyToken := "\"" & lower(keyName) & "\"";
    keyPos := pos(lower(content), keyToken, startPos);
    if keyPos <> 0 then
      quoteStart := pos(content, "\"", keyPos + length(keyToken));
      if quoteStart <> 0 then
        quoteEnd := pos(content, "\"", succ(quoteStart));
        if quoteEnd <> 0 then
          value := content[succ(quoteStart) .. pred(quoteEnd)];
        end if;
      end if;
    end if;
  end func;

const func string: declNameAfter (in string: content, in integer: startPos) is func
  result
    var string: name is "";
  local
    var integer: nameStart is 0;
    var integer: nameEnd is 0;
    var char: currentChar is ' ';
    var boolean: stillReading is TRUE;
  begin
    nameStart := startPos;
    while nameStart <= length(content) and
        (content[nameStart] = ' ' or content[nameStart] = '\t' or
        content[nameStart] = '\n' or content[nameStart] = '\r') do
      incr(nameStart);
    end while;
    if nameStart <= length(content) then
      if content[nameStart] = '"' then
        nameEnd := pos(content, "\"", succ(nameStart));
        if nameEnd <> 0 then
          name := content[succ(nameStart) .. pred(nameEnd)];
        end if;
      else
        nameEnd := nameStart;
        stillReading := TRUE;
        while nameEnd <= length(content) and stillReading do
          currentChar := content[nameEnd];
          if currentChar = ' ' or currentChar = '\t' or currentChar = '\n' or
              currentChar = '\r' or currentChar = '{' then
            nameEnd := pred(nameEnd);
            stillReading := FALSE;
          else
            incr(nameEnd);
          end if;
        end while;
        if nameEnd > length(content) then
          nameEnd := length(content);
        end if;
        if nameEnd >= nameStart then
          name := content[nameStart .. nameEnd];
        end if;
      end if;
    end if;
  end func;

const func integer: matchingBlockEnd (
    in string: content, in integer: blockStart) is func
  result
    var integer: blockEnd is 0;
  local
    var integer: posIndex is 0;
    var integer: depth is 0;
    var boolean: done is FALSE;
  begin
    if blockStart >= 1 and blockStart <= length(content) and
        content[blockStart] = '{' then
      posIndex := blockStart;
      while posIndex <= length(content) and not done do
        if content[posIndex] = '{' then
          depth +:= 1;
        elsif content[posIndex] = '}' then
          depth -:= 1;
          if depth = 0 then
            blockEnd := posIndex;
            done := TRUE;
          end if;
        end if;
        incr(posIndex);
      end while;
    end if;
  end func;

const func integer: integerQuotedValueAfter (
    in string: content, in string: keyName, in integer: startPos,
    in integer: defaultValue) is func
  result
    var integer: value is 0;
  local
    var string: textValue is "";
  begin
    value := defaultValue;
    textValue := quotedValueAfter(content, keyName, startPos);
    if textValue <> "" then
      block
        value := integer(textValue);
      exception
        catch RANGE_ERROR:
          value := defaultValue;
      end block;
    end if;
  end func;

const func string: quotedValueAfterKeyPrefix (
    in string: content, in string: keyPrefix, in integer: startPos) is func
  result
    var string: value is "";
  local
    var string: contentLower is "";
    var string: prefixLower is "";
    var integer: keyPos is 0;
    var integer: quoteStart is 0;
    var integer: quoteEnd is 0;
    var integer: valueQuoteStart is 0;
    var integer: valueQuoteEnd is 0;
  begin
    contentLower := lower(content);
    prefixLower := "\"" & lower(keyPrefix);
    keyPos := pos(contentLower, prefixLower, startPos);
    while keyPos <> 0 and value = "" do
      quoteStart := keyPos;
      quoteEnd := pos(content, "\"", succ(quoteStart));
      if quoteEnd <> 0 then
        valueQuoteStart := pos(content, "\"", succ(quoteEnd));
        if valueQuoteStart <> 0 then
          valueQuoteEnd := pos(content, "\"", succ(valueQuoteStart));
          if valueQuoteEnd <> 0 then
            value := content[succ(valueQuoteStart) .. pred(valueQuoteEnd)];
          end if;
        end if;
      end if;
      if value = "" then
        keyPos := pos(contentLower, prefixLower, succ(keyPos));
      end if;
    end while;
  end func;

const proc: addEntityDefNames (inout archiveStats: stats,
    in string: content) is func
  local
    var string: contentLower is "";
    var string: entityDefName is "";
    var integer: searchPos is 1;
    var integer: defPos is 0;
  begin
    contentLower := lower(content);
    defPos := pos(contentLower, "entitydef ", searchPos);
    while defPos <> 0 do
      entityDefName := lower(declNameAfter(content, defPos + length("entitydef ")));
      if entityDefName <> "" then
        stats.entityDefNamed +:= 1;
        appendUnique(stats.entityDefNames, entityDefName);
        if stats.firstEntityDef = "" then
          stats.firstEntityDef := entityDefName;
        end if;
      end if;
      searchPos := defPos + length("entitydef ");
      defPos := pos(contentLower, "entitydef ", searchPos);
    end while;
  end func;

const proc: addEntityDefRecords (inout archiveStats: stats,
    in string: content) is func
  local
    var string: contentLower is "";
    var string: entityDefName is "";
    var integer: searchPos is 1;
    var integer: defPos is 0;
    var integer: nameEnd is 0;
    var integer: blockStart is 0;
    var integer: blockEnd is 0;
    var integer: parsedHealth is 0;
    var string: parsedModel is "";
    var string: parsedSound is "";
    var string: parsedParent is "";
    var string: parsedMins is "";
    var string: parsedMaxs is "";
    var entityDefRecord: defRecord is entityDefRecord.value;
  begin
    contentLower := lower(content);
    defPos := pos(contentLower, "entitydef ", searchPos);
    while defPos <> 0 do
      entityDefName := lower(declNameAfter(content, defPos + length("entitydef ")));
      if entityDefName <> "" then
        nameEnd := defPos + length("entitydef ") + length(entityDefName);
        blockStart := pos(content, "{", nameEnd);
        blockEnd := matchingBlockEnd(content, blockStart);
        if blockStart <> 0 and blockEnd <> 0 then
          parsedHealth := integerQuotedValueAfter(content[blockStart .. blockEnd],
              "health", 1, 0);
          parsedModel := quotedValueAfter(content[blockStart .. blockEnd],
              "model", 1);
          parsedSound := quotedValueAfterKeyPrefix(
              content[blockStart .. blockEnd], "snd_", 1);
          parsedParent := lower(quotedValueAfter(content[blockStart .. blockEnd],
              "inherit", 1));
          parsedMins := quotedValueAfter(content[blockStart .. blockEnd],
              "mins", 1);
          parsedMaxs := quotedValueAfter(content[blockStart .. blockEnd],
              "maxs", 1);
          if parsedHealth <> 0 or parsedModel <> "" or parsedSound <> "" or
              parsedParent <> "" or (canParseVector3(parsedMins) and
              canParseVector3(parsedMaxs)) then
            defRecord := entityDefRecord.value;
            defRecord.className := entityDefName;
            if parsedParent <> "" then
              defRecord.hasParent := TRUE;
              defRecord.parentClassName := parsedParent;
              stats.entityDefInheritValues +:= 1;
              if stats.firstEntityDefInheritClass = "" then
                stats.firstEntityDefInheritClass := entityDefName;
              end if;
            end if;
            if parsedHealth <> 0 then
              defRecord.hasHealth := TRUE;
              defRecord.health := parsedHealth;
              stats.entityDefHealthValues +:= 1;
              if stats.firstEntityDefHealthClass = "" then
                stats.firstEntityDefHealthClass := entityDefName;
              end if;
            end if;
            if parsedModel <> "" then
              defRecord.hasModel := TRUE;
              defRecord.model := parsedModel;
              stats.entityDefModelValues +:= 1;
              if stats.firstEntityDefModelClass = "" then
                stats.firstEntityDefModelClass := entityDefName;
              end if;
            end if;
            if parsedSound <> "" then
              defRecord.hasSound := TRUE;
              defRecord.sound := parsedSound;
              stats.entityDefSoundValues +:= 1;
              if stats.firstEntityDefSoundClass = "" then
                stats.firstEntityDefSoundClass := entityDefName;
              end if;
            end if;
            if canParseVector3(parsedMins) and canParseVector3(parsedMaxs) then
              stats.entityDefBoundsValues +:= 1;
              if stats.firstEntityDefBoundsClass = "" then
                stats.firstEntityDefBoundsClass := entityDefName;
              end if;
            end if;
            stats.entityDefRecords &:= defRecord;
          end if;
        end if;
      end if;
      searchPos := defPos + length("entitydef ");
      defPos := pos(contentLower, "entitydef ", searchPos);
    end while;
  end func;

const proc: addMaterialDeclNames (inout archiveStats: stats,
    in string: content) is func
  local
    var array string: lines is 0 times "";
    var string: line is "";
    var string: materialName is "";
  begin
    lines := split(content, '\n');
    for line range lines do
      line := trim(line);
      if line <> "" and not startsWith(line, "//") and isMaterialName(line) then
        materialName := lower(cleanedToken(declNameAfter(line, 1)));
        if isMaterialName(materialName) then
          stats.materialDecls +:= 1;
          appendUnique(stats.materialNames, materialName);
          if stats.firstMaterialDecl = "" then
            stats.firstMaterialDecl := materialName;
          end if;
        end if;
      end if;
    end for;
  end func;

const proc: addMaterialTextureBindings (inout archiveStats: stats,
    in string: content) is func
  local
    var array string: lines is 0 times "";
    var array string: tokens is 0 times "";
    var string: line is "";
    var string: lineLower is "";
    var string: token is "";
    var string: currentMaterial is "";
    var string: textureStem is "";
  begin
    lines := split(content, '\n');
    for line range lines do
      lineLower := lower(trim(line));
      if lineLower <> "" and not startsWith(lineLower, "//") then
        if currentMaterial = "" and isMaterialName(lineLower) then
          currentMaterial := lower(cleanedToken(declNameAfter(lineLower, 1)));
        elsif currentMaterial <> "" then
          tokens := noEmptyStrings(split(lineLower, ' '));
          for token range tokens do
            if textureStem = "" then
              token := cleanedToken(token);
              if isImageRef(token) then
                textureStem := assetStem(token);
              end if;
            end if;
          end for;
          if textureStem <> "" then
            stats.mtrBindingNames &:= currentMaterial;
            stats.mtrBindingTextureStems &:= textureStem;
            stats.materialTextureBindings +:= 1;
            if stats.firstMaterialTextureBinding = "" then
              stats.firstMaterialTextureBinding :=
                  currentMaterial <& "=" <& textureStem;
            end if;
            currentMaterial := "";
            textureStem := "";
          elsif pos(lineLower, "}") <> 0 then
            currentMaterial := "";
          end if;
        end if;
      end if;
    end for;
  end func;

const proc: addMaterialTextureRefs (inout archiveStats: stats,
    in string: content) is func
  local
    var string: normalizedContent is "";
    var array string: tokens is 0 times "";
    var string: token is "";
    var string: textureStem is "";
  begin
    normalizedContent := replace(lower(content), "\n", " ");
    normalizedContent := replace(normalizedContent, "\r", " ");
    normalizedContent := replace(normalizedContent, "\t", " ");
    tokens := noEmptyStrings(split(normalizedContent, ' '));
    for token range tokens do
      token := cleanedToken(token);
      if isImageRef(token) then
        textureStem := assetStem(token);
        if textureStem <> "" then
          stats.materialTextureRefs +:= 1;
          appendUnique(stats.materialTextureStems, textureStem);
          if stats.firstMaterialTextureRef = "" then
            stats.firstMaterialTextureRef := token;
          end if;
        end if;
      end if;
    end for;
  end func;

const proc: addTextSoundRefs (inout archiveStats: stats,
    in string: content) is func
  local
    var string: normalizedContent is "";
    var array string: tokens is 0 times "";
    var string: token is "";
    var string: soundStem is "";
    var integer: soundPos is 0;
  begin
    normalizedContent := replace(lower(content), "\n", " ");
    normalizedContent := replace(normalizedContent, "\r", " ");
    normalizedContent := replace(normalizedContent, "\t", " ");
    tokens := noEmptyStrings(split(normalizedContent, ' '));
    for token range tokens do
      token := cleanedToken(token);
      token := normalizedAssetPath(token);
      soundPos := pos(token, "sound/");
      if soundPos <> 0 then
        token := token[soundPos ..];
        token := cleanedToken(token);
      end if;
      if isSoundRef(token) then
        soundStem := assetStem(token);
        if soundStem <> "" then
          stats.textSoundRefs +:= 1;
          appendUnique(stats.textSoundStems, soundStem);
          if stats.firstTextSoundRef = "" then
            stats.firstTextSoundRef := token;
          end if;
        end if;
      end if;
    end for;
  end func;

const proc: addSelectedMapMaterialRefs (inout archiveStats: stats,
    in string: content) is func
  local
    var string: normalizedContent is "";
    var array string: tokens is 0 times "";
    var string: token is "";
    var string: materialName is "";
  begin
    normalizedContent := replace(lower(content), "\n", " ");
    normalizedContent := replace(normalizedContent, "\r", " ");
    normalizedContent := replace(normalizedContent, "\t", " ");
    tokens := noEmptyStrings(split(normalizedContent, ' '));
    for token range tokens do
      materialName := lower(cleanedToken(token));
      if isMaterialName(materialName) then
        stats.selectedMapMaterialRefs +:= 1;
        appendUnique(stats.selectedMapMaterials, materialName);
        if stats.firstMapMaterialRef = "" then
          stats.firstMapMaterialRef := materialName;
        end if;
      end if;
    end for;
  end func;

const proc: addSurfaceMaterialToken (inout archiveStats: stats,
    in string: token, in string: sectionKind) is func
  local
    var string: materialName is "";
  begin
    materialName := lower(cleanedToken(token));
    if isMaterialName(materialName) then
      if sectionKind = "brush" then
        stats.selectedBrushMaterialRefs +:= 1;
        appendUnique(stats.selectedBrushMaterials, materialName);
      elsif sectionKind = "patch" then
        stats.selectedPatchMaterialRefs +:= 1;
        appendUnique(stats.selectedPatchMaterials, materialName);
      end if;
    end if;
  end func;

const proc: addSelectedBrushPlaneRecord (inout archiveStats: stats,
    in string: lineText) is func
  local
    var array string: tokens is 0 times "";
    var string: token is "";
    var string: cleanToken is "";
    var selectedBrushPlane: brushPlane is selectedBrushPlane.value;
    var integer: numericCount is 0;
    var boolean: parsedNumber is FALSE;
    var float: parsedValue is 0.0;
  begin
    tokens := noEmptyStrings(split(lineText, ' '));
    for token range tokens do
      cleanToken := lower(cleanedToken(token));
      if numericCount < 4 then
        parsedNumber := FALSE;
        block
          parsedValue := float(cleanToken);
          parsedNumber := TRUE;
        exception
          catch RANGE_ERROR:
            parsedNumber := FALSE;
        end block;
        if parsedNumber then
          numericCount +:= 1;
          if numericCount = 1 then
            brushPlane.normalX := parsedValue;
          elsif numericCount = 2 then
            brushPlane.normalY := parsedValue;
          elsif numericCount = 3 then
            brushPlane.normalZ := parsedValue;
          elsif numericCount = 4 then
            brushPlane.distance := parsedValue;
          end if;
        end if;
      end if;
      if brushPlane.materialName = "" and isMaterialName(cleanToken) then
        brushPlane.materialName := cleanToken;
      end if;
    end for;
    if numericCount = 4 then
      stats.selectedBrushPlanes &:= brushPlane;
    end if;
  end func;

const proc: addSelectedBrushPlaneToBounds (
    inout selectedBrushBounds: brushBounds, in string: lineText) is func
  local
    var array string: tokens is 0 times "";
    var string: token is "";
    var string: cleanToken is "";
    var selectedBrushPlane: brushPlane is selectedBrushPlane.value;
    var integer: numericCount is 0;
    var boolean: parsedNumber is FALSE;
    var float: parsedValue is 0.0;
  begin
    tokens := noEmptyStrings(split(lineText, ' '));
    for token range tokens do
      cleanToken := lower(cleanedToken(token));
      if numericCount < 4 then
        parsedNumber := FALSE;
        block
          parsedValue := float(cleanToken);
          parsedNumber := TRUE;
        exception
          catch RANGE_ERROR:
            parsedNumber := FALSE;
        end block;
        if parsedNumber then
          numericCount +:= 1;
          if numericCount = 1 then
            brushPlane.normalX := parsedValue;
          elsif numericCount = 2 then
            brushPlane.normalY := parsedValue;
          elsif numericCount = 3 then
            brushPlane.normalZ := parsedValue;
          elsif numericCount = 4 then
            brushPlane.distance := parsedValue;
          end if;
        end if;
      end if;
      if brushBounds.materialName = "" and isMaterialName(cleanToken) then
        brushBounds.materialName := cleanToken;
      end if;
    end for;
    if numericCount = 4 then
      brushBounds.planeCount +:= 1;
      if brushPlane.normalX = 1.0 and brushPlane.normalY = 0.0 and
          brushPlane.normalZ = 0.0 then
        brushBounds.maxX := -brushPlane.distance;
        brushBounds.hasMaxX := TRUE;
      elsif brushPlane.normalX = -1.0 and brushPlane.normalY = 0.0 and
          brushPlane.normalZ = 0.0 then
        brushBounds.minX := brushPlane.distance;
        brushBounds.hasMinX := TRUE;
      elsif brushPlane.normalY = 1.0 and brushPlane.normalX = 0.0 and
          brushPlane.normalZ = 0.0 then
        brushBounds.maxY := -brushPlane.distance;
        brushBounds.hasMaxY := TRUE;
      elsif brushPlane.normalY = -1.0 and brushPlane.normalX = 0.0 and
          brushPlane.normalZ = 0.0 then
        brushBounds.minY := brushPlane.distance;
        brushBounds.hasMinY := TRUE;
      elsif brushPlane.normalZ = 1.0 and brushPlane.normalX = 0.0 and
          brushPlane.normalY = 0.0 then
        brushBounds.maxZ := -brushPlane.distance;
        brushBounds.hasMaxZ := TRUE;
      elsif brushPlane.normalZ = -1.0 and brushPlane.normalX = 0.0 and
          brushPlane.normalY = 0.0 then
        brushBounds.minZ := brushPlane.distance;
        brushBounds.hasMinZ := TRUE;
      end if;
    end if;
  end func;

const func boolean: hasCompleteBrushBounds (
    in selectedBrushBounds: brushBounds) is func
  result
    var boolean: complete is FALSE;
  begin
    complete := brushBounds.hasMinX and brushBounds.hasMaxX and
        brushBounds.hasMinY and brushBounds.hasMaxY and
        brushBounds.hasMinZ and brushBounds.hasMaxZ;
  end func;

const func string: fallbackColorForMaterial (in string: materialName) is func
  result
    var string: colorText is "96 96 112";
  local
    var string: materialLower is "";
  begin
    materialLower := lower(materialName);
    if pos(materialLower, "door") <> 0 then
      colorText := "148 88 48";
    elsif pos(materialLower, "floor") <> 0 then
      colorText := "72 76 80";
    elsif pos(materialLower, "metal") <> 0 then
      colorText := "92 104 112";
    elsif pos(materialLower, "light") <> 0 then
      colorText := "144 184 192";
    elsif pos(materialLower, "wall") <> 0 then
      colorText := "80 104 84";
    elsif pos(materialLower, "trim") <> 0 then
      colorText := "112 96 72";
    end if;
  end func;

const func runtimeRenderSurface: renderSurfaceFromBrushBounds (
    in selectedBrushBounds: brushBounds) is func
  result
    var runtimeRenderSurface: surface is runtimeRenderSurface.value;
  begin
    surface.materialName := brushBounds.materialName;
    surface.fallbackColor := fallbackColorForMaterial(brushBounds.materialName);
    surface.visible := hasCompleteBrushBounds(brushBounds);
    surface.minX := brushBounds.minX;
    surface.minY := brushBounds.minY;
    surface.minZ := brushBounds.minZ;
    surface.maxX := brushBounds.maxX;
    surface.maxY := brushBounds.maxY;
    surface.maxZ := brushBounds.maxZ;
  end func;

const proc: addSelectedMapSurfaceMaterials (inout archiveStats: stats,
    in string: content) is func
  local
    var array string: lines is 0 times "";
    var array string: tokens is 0 times "";
    var string: line is "";
    var string: lineLower is "";
    var string: token is "";
    var string: sectionKind is "";
    var selectedBrushBounds: currentBrushBounds is selectedBrushBounds.value;
  begin
    lines := split(content, '\n');
    for line range lines do
      lineLower := lower(trim(line));
      if pos(lineLower, "brushdef3") <> 0 then
        sectionKind := "brush";
        currentBrushBounds := selectedBrushBounds.value;
      elsif pos(lineLower, "patchdef2") <> 0 or pos(lineLower, "patchdef3") <> 0 then
        sectionKind := "patch";
      elsif lineLower = "}" then
        if sectionKind = "brush" and currentBrushBounds.planeCount > 0 then
          stats.selectedBrushBoundsList &:= currentBrushBounds;
          if hasCompleteBrushBounds(currentBrushBounds) then
            stats.runtimeRenderSurfaces &:= renderSurfaceFromBrushBounds(
                currentBrushBounds);
          end if;
        end if;
        sectionKind := "";
      else
        if sectionKind = "brush" and pos(lineLower, "(") <> 0 then
          stats.selectedBrushPlaneLines +:= 1;
          addSelectedBrushPlaneRecord(stats, lineLower);
          addSelectedBrushPlaneToBounds(currentBrushBounds, lineLower);
        end if;
        tokens := noEmptyStrings(split(lineLower, ' '));
        for token range tokens do
          addSurfaceMaterialToken(stats, token, sectionKind);
        end for;
      end if;
    end for;
  end func;

const func string: quotedValueBetween (in string: content, in string: keyName,
    in integer: startPos, in integer: endPos) is func
  result
    var string: value is "";
  local
    var string: blockText is "";
  begin
    if startPos >= 1 and endPos >= startPos and endPos <= length(content) then
      blockText := content[startPos .. endPos];
      value := quotedValueAfter(blockText, keyName, 1);
    end if;
  end func;

const func boolean: isSpawnRelevantClass (in string: className) is func
  result
    var boolean: relevant is FALSE;
  begin
    relevant := className = "info_player_start" or className = "light" or
        startsWith(className, "light_") or className = "func_static" or
        className = "func_door" or className = "mover_door" or
        startsWith(className, "door_") or startsWith(className, "trigger_") or
        startsWith(className, "monster_") or startsWith(className, "item_") or
        startsWith(className, "ammo_") or startsWith(className, "weapon_");
  end func;

const func boolean: isBuiltInSpawnClass (in string: className) is func
  result
    var boolean: builtIn is FALSE;
  begin
    builtIn := className = "info_player_start" or className = "light" or
        className = "func_static" or className = "func_door" or
        className = "mover_door" or startsWith(className, "trigger_");
  end func;

const func boolean: hasEntityDefinition (in archiveStats: stats,
    in string: className) is func
  result
    var boolean: declared is FALSE;
  begin
    declared := isBuiltInSpawnClass(className) or
        containsString(stats.entityDefNames, className);
  end func;

const func string: runtimeKindForClass (in string: className) is func
  result
    var string: kind is "unsupported";
  begin
    if className = "info_player_start" then
      kind := "player_spawn";
    elsif className = "light" or startsWith(className, "light_") then
      kind := "light";
    elsif className = "func_static" then
      kind := "static";
    elsif className = "func_door" or className = "mover_door" or
        startsWith(className, "door_") then
      kind := "door";
    elsif startsWith(className, "trigger_") then
      kind := "trigger";
    elsif startsWith(className, "monster_") then
      kind := "monster";
    elsif startsWith(className, "item_") or startsWith(className, "ammo_") or
        startsWith(className, "weapon_") then
      kind := "pickup";
    end if;
  end func;

const func integer: runtimeInitialHealthForClass (in string: className) is func
  result
    var integer: health is 0;
  begin
    if className = "info_player_start" then
      health := 100;
    elsif startsWith(className, "monster_") then
      health := 100;
    end if;
  end func;

const func integer: entityDefHealthForClass (
    in archiveStats: stats, in string: className,
    in integer: defaultHealth) is func
  result
    var integer: health is 0;
  local
    var entityDefRecord: defRecord is entityDefRecord.value;
    var string: currentClass is "";
    var integer: inheritDepth is 0;
    var boolean: found is FALSE;
  begin
    health := defaultHealth;
    currentClass := lower(className);
    while currentClass <> "" and inheritDepth < ENTITY_DEF_INHERIT_LIMIT and
        not found do
      for defRecord range stats.entityDefRecords do
        if lower(defRecord.className) = currentClass then
          if defRecord.hasHealth then
            health := defRecord.health;
            found := TRUE;
          elsif defRecord.hasParent then
            currentClass := lower(defRecord.parentClassName);
          else
            currentClass := "";
          end if;
        end if;
      end for;
      inheritDepth +:= 1;
    end while;
  end func;

const func string: entityDefModelForClass (
    in archiveStats: stats, in string: className) is func
  result
    var string: model is "";
  local
    var entityDefRecord: defRecord is entityDefRecord.value;
    var string: currentClass is "";
    var integer: inheritDepth is 0;
    var boolean: found is FALSE;
  begin
    currentClass := lower(className);
    while currentClass <> "" and inheritDepth < ENTITY_DEF_INHERIT_LIMIT and
        not found do
      for defRecord range stats.entityDefRecords do
        if lower(defRecord.className) = currentClass then
          if defRecord.hasModel then
            model := defRecord.model;
            found := TRUE;
          elsif defRecord.hasParent then
            currentClass := lower(defRecord.parentClassName);
          else
            currentClass := "";
          end if;
        end if;
      end for;
      inheritDepth +:= 1;
    end while;
  end func;

const func string: entityDefSoundForClass (
    in archiveStats: stats, in string: className) is func
  result
    var string: sound is "";
  local
    var entityDefRecord: defRecord is entityDefRecord.value;
    var string: currentClass is "";
    var integer: inheritDepth is 0;
    var boolean: found is FALSE;
  begin
    currentClass := lower(className);
    while currentClass <> "" and inheritDepth < ENTITY_DEF_INHERIT_LIMIT and
        not found do
      for defRecord range stats.entityDefRecords do
        if lower(defRecord.className) = currentClass then
          if defRecord.hasSound then
            sound := defRecord.sound;
            found := TRUE;
          elsif defRecord.hasParent then
            currentClass := lower(defRecord.parentClassName);
          else
            currentClass := "";
          end if;
        end if;
      end for;
      inheritDepth +:= 1;
    end while;
  end func;

const func boolean: runtimeSolidForClass (in string: className) is func
  result
    var boolean: solid is FALSE;
  begin
    solid := className = "func_static" or className = "func_door" or
        className = "mover_door" or startsWith(className, "door_") or
        startsWith(className, "monster_");
  end func;

const func runtimeEntity: runtimeEntityFromMapEntity (
    in archiveStats: stats, in selectedMapEntity: mapEntity) is func
  result
    var runtimeEntity: entity is runtimeEntity.value;
  local
    var integer: fallbackHealth is 0;
  begin
    entity.className := mapEntity.className;
    entity.entityName := mapEntity.entityName;
    entity.kind := runtimeKindForClass(mapEntity.className);
    if mapEntity.model <> "" then
      entity.model := mapEntity.model;
    else
      entity.model := entityDefModelForClass(stats, mapEntity.className);
    end if;
    if mapEntity.sound <> "" then
      entity.sound := mapEntity.sound;
    else
      entity.sound := entityDefSoundForClass(stats, mapEntity.className);
    end if;
    entity.active := TRUE;
    entity.solid := runtimeSolidForClass(mapEntity.className);
    entity.trigger := startsWith(mapEntity.className, "trigger_");
    entity.hasOrigin := mapEntity.hasOrigin;
    fallbackHealth := runtimeInitialHealthForClass(mapEntity.className);
    if mapEntity.hasHealth then
      entity.health := mapEntity.health;
    else
      entity.health := entityDefHealthForClass(stats, mapEntity.className,
          fallbackHealth);
    end if;
    entity.x := mapEntity.x;
    entity.y := mapEntity.y;
    entity.z := mapEntity.z;
    entity.yaw := mapEntity.yaw;
  end func;

const proc: rebuildRuntimeEntities (inout archiveStats: stats) is func
  local
    var selectedMapEntity: mapEntity is selectedMapEntity.value;
    var runtimeEntity: entity is runtimeEntity.value;
  begin
    stats.runtimeEntities := 0 times runtimeEntity.value;
    stats.runtimeModelStems := 0 times "";
    stats.runtimeSoundStems := 0 times "";
    for mapEntity range stats.selectedEntities do
      if isSpawnRelevantClass(mapEntity.className) then
        stats.runtimeEntities &:= runtimeEntityFromMapEntity(stats, mapEntity);
      end if;
    end for;
    for entity range stats.runtimeEntities do
      if isModelRef(entity.model) then
        appendUnique(stats.runtimeModelStems, assetStem(entity.model));
      end if;
      if isSoundRef(entity.sound) then
        appendUnique(stats.runtimeSoundStems, assetStem(entity.sound));
      end if;
    end for;
  end func;

