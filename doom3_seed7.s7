const func float: renderSurfaceCenterX (
    in runtimeRenderSurface: surface) is func
  result
    var float: centerX is 0.0;
  begin
    centerX := (surface.minX + surface.maxX) / 2.0;
  end func;

const func float: renderSurfaceCenterY (
    in runtimeRenderSurface: surface) is func
  result
    var float: centerY is 0.0;
  begin
    centerY := (surface.minY + surface.maxY) / 2.0;
  end func;

const func float: renderSurfaceDistanceSquared (
    in runtimeRenderSurface: surface,
    in float: cameraX, in float: cameraY) is func
  result
    var float: distanceSquared is 0.0;
  local
    var float: deltaX is 0.0;
    var float: deltaY is 0.0;
  begin
    deltaX := renderSurfaceCenterX(surface) - cameraX;
    deltaY := renderSurfaceCenterY(surface) - cameraY;
    distanceSquared := deltaX * deltaX + deltaY * deltaY;
  end func;

const func boolean: renderSurfaceInFrontOfCamera (
    in runtimeRenderSurface: surface,
    in float: cameraX, in float: cameraY, in float: cameraYaw) is func
  result
    var boolean: inFront is FALSE;
  local
    var float: forwardX is 0.0;
    var float: forwardY is 0.0;
    var float: deltaX is 0.0;
    var float: deltaY is 0.0;
  begin
    if surface.visible then
      forwardX := cos(cameraYaw * PI / 180.0);
      forwardY := sin(cameraYaw * PI / 180.0);
      deltaX := renderSurfaceCenterX(surface) - cameraX;
      deltaY := renderSurfaceCenterY(surface) - cameraY;
      inFront := deltaX * forwardX + deltaY * forwardY > 0.0;
    end if;
  end func;

const func integer: countQueuedRenderSurfaces (
    in archiveStats: stats,
    in float: cameraX, in float: cameraY, in float: cameraYaw) is func
  result
    var integer: surfaceCount is 0;
  local
    var runtimeRenderSurface: surface is runtimeRenderSurface.value;
  begin
    for surface range stats.runtimeRenderSurfaces do
      if renderSurfaceInFrontOfCamera(surface, cameraX, cameraY, cameraYaw) then
        surfaceCount +:= 1;
      end if;
    end for;
  end func;

const func runtimeRenderSurface: nearestQueuedRenderSurface (
    in archiveStats: stats,
    in float: cameraX, in float: cameraY, in float: cameraYaw) is func
  result
    var runtimeRenderSurface: nearestSurface is runtimeRenderSurface.value;
  local
    var runtimeRenderSurface: surface is runtimeRenderSurface.value;
    var float: nearestDistance is 0.0;
    var float: surfaceDistance is 0.0;
    var boolean: found is FALSE;
  begin
    for surface range stats.runtimeRenderSurfaces do
      if renderSurfaceInFrontOfCamera(surface, cameraX, cameraY, cameraYaw) then
        surfaceDistance := renderSurfaceDistanceSquared(surface, cameraX,
            cameraY);
        if not found or surfaceDistance < nearestDistance then
          nearestSurface := surface;
          nearestDistance := surfaceDistance;
          found := TRUE;
        end if;
      end if;
    end for;
  end func;

const func float: positiveFloat (in float: value) is func
  result
    var float: positive is 0.0;
  begin
    positive := value;
    if positive < 0.0 then
      positive := -positive;
    end if;
  end func;

const func float: firstVectorComponentOrDefault (
    in string: vectorText, in float: defaultValue) is func
  result
    var float: component is 0.0;
  local
    var array string: parts is 0 times "";
  begin
    component := defaultValue;
    if vectorText <> "" then
      parts := noEmptyStrings(split(trim(vectorText), ' '));
      if length(parts) >= 1 then
        block
          component := positiveFloat(float(parts[1]));
        exception
          catch RANGE_ERROR:
            component := defaultValue;
        end block;
      end if;
    end if;
  end func;

const func boolean: lightAffectsRenderSurface (
    in selectedMapEntity: lightEntity,
    in runtimeRenderSurface: surface) is func
  result
    var boolean: affects is FALSE;
  local
    var float: deltaX is 0.0;
    var float: deltaY is 0.0;
    var float: lightRadius is 0.0;
  begin
    if (lightEntity.className = "light" or
        startsWith(lightEntity.className, "light_")) and
        lightEntity.hasOrigin and surface.visible then
      lightRadius := firstVectorComponentOrDefault(lightEntity.lightRadius,
          300.0);
      deltaX := renderSurfaceCenterX(surface) - lightEntity.x;
      deltaY := renderSurfaceCenterY(surface) - lightEntity.y;
      affects := deltaX * deltaX + deltaY * deltaY <=
          lightRadius * lightRadius;
    end if;
  end func;

const func integer: countLightsAffectingRenderSurface (
    in archiveStats: stats, in runtimeRenderSurface: surface) is func
  result
    var integer: lightCount is 0;
  local
    var selectedMapEntity: mapEntity is selectedMapEntity.value;
  begin
    if surface.visible then
      for mapEntity range stats.selectedEntities do
        if lightAffectsRenderSurface(mapEntity, surface) then
          lightCount +:= 1;
        end if;
      end for;
    end if;
  end func;

const func integer: countQueuedLitRenderSurfaces (
    in archiveStats: stats,
    in float: cameraX, in float: cameraY, in float: cameraYaw) is func
  result
    var integer: surfaceCount is 0;
  local
    var runtimeRenderSurface: surface is runtimeRenderSurface.value;
  begin
    for surface range stats.runtimeRenderSurfaces do
      if renderSurfaceInFrontOfCamera(surface, cameraX, cameraY, cameraYaw) and
          countLightsAffectingRenderSurface(stats, surface) <> 0 then
        surfaceCount +:= 1;
      end if;
    end for;
  end func;

const func string: firstLightColorAffectingRenderSurface (
    in archiveStats: stats, in runtimeRenderSurface: surface) is func
  result
    var string: colorText is "";
  local
    var selectedMapEntity: mapEntity is selectedMapEntity.value;
  begin
    if surface.visible then
      for mapEntity range stats.selectedEntities do
        if colorText = "" and lightAffectsRenderSurface(mapEntity, surface) then
          if mapEntity.lightColor <> "" then
            colorText := mapEntity.lightColor;
          else
            colorText := "1 1 1";
          end if;
        end if;
      end for;
    end if;
  end func;

const func boolean: pointInsideBrushBounds (
    in selectedBrushBounds: brushBounds,
    in float: x, in float: y, in float: z) is func
  result
    var boolean: inside is FALSE;
  begin
    if hasCompleteBrushBounds(brushBounds) then
      inside := x >= brushBounds.minX and x <= brushBounds.maxX and
          y >= brushBounds.minY and y <= brushBounds.maxY and
          z >= brushBounds.minZ and z <= brushBounds.maxZ;
    end if;
  end func;

const func integer: countBrushBoundsContainingPoint (
    in archiveStats: stats, in float: x, in float: y, in float: z) is func
  result
    var integer: boundsCount is 0;
  local
    var selectedBrushBounds: brushBounds is selectedBrushBounds.value;
  begin
    for brushBounds range stats.selectedBrushBoundsList do
      if pointInsideBrushBounds(brushBounds, x, y, z) then
        boundsCount +:= 1;
      end if;
    end for;
  end func;

const func float: degreesToRadians (in float: degrees) is func
  result
    var float: radians is 0.0;
  begin
    radians := degrees * PI / 180.0;
  end func;

const func float: forwardProbeX (in archiveStats: stats) is func
  result
    var float: probeX is 0.0;
  begin
    probeX := stats.playerStartX +
        cos(degreesToRadians(stats.playerStartYaw)) * PLAYER_PROBE_DISTANCE;
  end func;

const func float: forwardProbeY (in archiveStats: stats) is func
  result
    var float: probeY is 0.0;
  begin
    probeY := stats.playerStartY +
        sin(degreesToRadians(stats.playerStartYaw)) * PLAYER_PROBE_DISTANCE;
  end func;

const func float: forwardStepX (in archiveStats: stats,
    in float: currentX) is func
  result
    var float: stepX is 0.0;
  begin
    stepX := currentX + cos(degreesToRadians(stats.playerStartYaw)) *
        PLAYER_SIM_STEP_DISTANCE;
  end func;

const func float: forwardStepY (in archiveStats: stats,
    in float: currentY) is func
  result
    var float: stepY is 0.0;
  begin
    stepY := currentY + sin(degreesToRadians(stats.playerStartYaw)) *
        PLAYER_SIM_STEP_DISTANCE;
  end func;

const func boolean: brushBoundsIntersectsView (
    in selectedBrushBounds: brushBounds,
    in float: viewMinX, in float: viewMinY,
    in float: viewMaxX, in float: viewMaxY) is func
  result
    var boolean: intersects is FALSE;
  begin
    if hasCompleteBrushBounds(brushBounds) then
      intersects := brushBounds.maxX >= viewMinX and brushBounds.minX <= viewMaxX and
          brushBounds.maxY >= viewMinY and brushBounds.minY <= viewMaxY;
    end if;
  end func;

const func integer: countBrushBoundsInView (
    in archiveStats: stats,
    in float: viewMinX, in float: viewMinY,
    in float: viewMaxX, in float: viewMaxY) is func
  result
    var integer: boundsCount is 0;
  local
    var selectedBrushBounds: brushBounds is selectedBrushBounds.value;
  begin
    for brushBounds range stats.selectedBrushBoundsList do
      if brushBoundsIntersectsView(brushBounds, viewMinX, viewMinY,
          viewMaxX, viewMaxY) then
        boundsCount +:= 1;
      end if;
    end for;
  end func;

const func integer: debugGridCell (in float: value,
    in float: viewMinValue) is func
  result
    var integer: cell is 0;
  begin
    cell := trunc((value - viewMinValue) / DEBUG_RENDER_CELL_SIZE);
    if cell < 0 then
      cell := 0;
    elsif cell >= DEBUG_RENDER_GRID_SIZE then
      cell := pred(DEBUG_RENDER_GRID_SIZE);
    end if;
  end func;

const func integer: countBrushBoundsInDebugCell (
    in archiveStats: stats, in float: cellMinX, in float: cellMinY) is func
  result
    var integer: boundsCount is 0;
  local
    var float: cellMaxX is 0.0;
    var float: cellMaxY is 0.0;
  begin
    cellMaxX := cellMinX + DEBUG_RENDER_CELL_SIZE;
    cellMaxY := cellMinY + DEBUG_RENDER_CELL_SIZE;
    boundsCount := countBrushBoundsInView(stats, cellMinX, cellMinY,
        cellMaxX, cellMaxY);
  end func;

const func boolean: isLightEntity (in selectedMapEntity: mapEntity) is func
  result
    var boolean: lightEntity is FALSE;
  begin
    lightEntity := mapEntity.className = "light" or
        startsWith(mapEntity.className, "light_");
  end func;

const func char: entityDebugMarker (in selectedMapEntity: mapEntity) is func
  result
    var char: marker is '.';
  begin
    if mapEntity.className = "func_static" then
      marker := 'S';
    elsif mapEntity.className = "func_door" or
        mapEntity.className = "mover_door" or
        startsWith(mapEntity.className, "door_") then
      marker := 'D';
    elsif startsWith(mapEntity.className, "trigger_") then
      marker := 'T';
    elsif startsWith(mapEntity.className, "monster_") then
      marker := 'M';
    elsif startsWith(mapEntity.className, "item_") or
        startsWith(mapEntity.className, "ammo_") or
        startsWith(mapEntity.className, "weapon_") then
      marker := 'I';
    end if;
  end func;

const func char: runtimeEntityDebugMarker (in runtimeEntity: entity) is func
  result
    var char: marker is '.';
  begin
    if entity.kind = "static" then
      marker := 'S';
    elsif entity.kind = "door" then
      marker := 'D';
    elsif entity.kind = "trigger" then
      marker := 'T';
    elsif entity.kind = "monster" then
      marker := 'M';
    elsif entity.kind = "pickup" then
      marker := 'I';
    end if;
  end func;

const func boolean: isTriggerEntity (in selectedMapEntity: mapEntity) is func
  result
    var boolean: triggerEntity is FALSE;
  begin
    triggerEntity := startsWith(mapEntity.className, "trigger_");
  end func;

const func boolean: isDoorEntity (in selectedMapEntity: mapEntity) is func
  result
    var boolean: doorEntity is FALSE;
  begin
    doorEntity := mapEntity.className = "func_door" or
        mapEntity.className = "mover_door" or
        startsWith(mapEntity.className, "door_");
  end func;

const func boolean: pointTouchesEntityOrigin (
    in selectedMapEntity: mapEntity,
    in float: x, in float: y) is func
  result
    var boolean: touches is FALSE;
  local
    var float: deltaX is 0.0;
    var float: deltaY is 0.0;
  begin
    if mapEntity.hasOrigin then
      deltaX := mapEntity.x - x;
      deltaY := mapEntity.y - y;
      touches := deltaX * deltaX + deltaY * deltaY <=
          TRIGGER_TOUCH_RADIUS * TRIGGER_TOUCH_RADIUS;
    end if;
  end func;

const func boolean: touchedTriggerTargetsName (
    in archiveStats: stats, in float: x, in float: y,
    in string: targetName) is func
  result
    var boolean: targeted is FALSE;
  local
    var selectedMapEntity: mapEntity is selectedMapEntity.value;
  begin
    for mapEntity range stats.selectedEntities do
      if isTriggerEntity(mapEntity) and pointTouchesEntityOrigin(mapEntity, x, y) and
          lower(mapEntity.target) = lower(targetName) then
        targeted := TRUE;
      end if;
    end for;
  end func;

const func boolean: hasEntityNamed (in archiveStats: stats,
    in string: entityName) is func
  result
    var boolean: found is FALSE;
  local
    var selectedMapEntity: mapEntity is selectedMapEntity.value;
  begin
    for mapEntity range stats.selectedEntities do
      if lower(mapEntity.entityName) = lower(entityName) then
        found := TRUE;
      end if;
    end for;
  end func;

const func integer: countTouchedTriggers (
    in archiveStats: stats, in float: x, in float: y) is func
  result
    var integer: triggerCount is 0;
  local
    var selectedMapEntity: mapEntity is selectedMapEntity.value;
  begin
    for mapEntity range stats.selectedEntities do
      if isTriggerEntity(mapEntity) and pointTouchesEntityOrigin(mapEntity, x, y) then
        triggerCount +:= 1;
      end if;
    end for;
  end func;

const func integer: countResolvedTouchedTriggerTargets (
    in archiveStats: stats, in float: x, in float: y) is func
  result
    var integer: targetCount is 0;
  local
    var selectedMapEntity: mapEntity is selectedMapEntity.value;
  begin
    for mapEntity range stats.selectedEntities do
      if isTriggerEntity(mapEntity) and pointTouchesEntityOrigin(mapEntity, x, y) and
          mapEntity.target <> "" and hasEntityNamed(stats, mapEntity.target) then
        targetCount +:= 1;
      end if;
    end for;
  end func;

const func string: firstTouchedTriggerName (
    in archiveStats: stats, in float: x, in float: y) is func
  result
    var string: triggerName is "";
  local
    var selectedMapEntity: mapEntity is selectedMapEntity.value;
  begin
    for mapEntity range stats.selectedEntities do
      if triggerName = "" and isTriggerEntity(mapEntity) and
          pointTouchesEntityOrigin(mapEntity, x, y) then
        triggerName := mapEntity.entityName;
      end if;
    end for;
  end func;

const func string: firstTouchedTriggerTarget (
    in archiveStats: stats, in float: x, in float: y) is func
  result
    var string: targetName is "";
  local
    var selectedMapEntity: mapEntity is selectedMapEntity.value;
  begin
    for mapEntity range stats.selectedEntities do
      if targetName = "" and isTriggerEntity(mapEntity) and
          pointTouchesEntityOrigin(mapEntity, x, y) then
        targetName := mapEntity.target;
      end if;
    end for;
  end func;

const func integer: countActivatedDoors (
    in archiveStats: stats, in float: x, in float: y) is func
  result
    var integer: doorCount is 0;
  local
    var selectedMapEntity: mapEntity is selectedMapEntity.value;
  begin
    for mapEntity range stats.selectedEntities do
      if isDoorEntity(mapEntity) and mapEntity.entityName <> "" and
          touchedTriggerTargetsName(stats, x, y, mapEntity.entityName) then
        doorCount +:= 1;
      end if;
    end for;
  end func;

const func boolean: runtimeDoorActivatedAtPoint (
    in archiveStats: stats, in runtimeEntity: entity,
    in float: x, in float: y) is func
  result
    var boolean: activated is FALSE;
  begin
    if entity.kind = "door" and entity.entityName <> "" then
      activated := touchedTriggerTargetsName(stats, x, y, entity.entityName);
    end if;
  end func;

const func boolean: runtimeEntityBlocksPoint (
    in archiveStats: stats, in runtimeEntity: entity,
    in float: x, in float: y) is func
  result
    var boolean: blocks is FALSE;
  local
    var float: deltaX is 0.0;
    var float: deltaY is 0.0;
  begin
    if entity.active and entity.solid and entity.hasOrigin and
        not runtimeDoorActivatedAtPoint(stats, entity, x, y) then
      deltaX := entity.x - x;
      deltaY := entity.y - y;
      blocks := deltaX * deltaX + deltaY * deltaY <=
          RUNTIME_ENTITY_COLLISION_RADIUS * RUNTIME_ENTITY_COLLISION_RADIUS;
    end if;
  end func;

const func integer: countRuntimeSolidEntitiesBlockingPoint (
    in archiveStats: stats, in float: x, in float: y) is func
  result
    var integer: entityCount is 0;
  local
    var runtimeEntity: entity is runtimeEntity.value;
  begin
    for entity range stats.runtimeEntities do
      if runtimeEntityBlocksPoint(stats, entity, x, y) then
        entityCount +:= 1;
      end if;
    end for;
  end func;

const func integer: countActivatedRuntimeDoors (
    in archiveStats: stats, in float: x, in float: y) is func
  result
    var integer: doorCount is 0;
  local
    var runtimeEntity: entity is runtimeEntity.value;
  begin
    for entity range stats.runtimeEntities do
      if runtimeDoorActivatedAtPoint(stats, entity, x, y) then
        doorCount +:= 1;
      end if;
    end for;
  end func;

const func string: firstActivatedDoorName (
    in archiveStats: stats, in float: x, in float: y) is func
  result
    var string: doorName is "";
  local
    var selectedMapEntity: mapEntity is selectedMapEntity.value;
  begin
    for mapEntity range stats.selectedEntities do
      if doorName = "" and isDoorEntity(mapEntity) and
          mapEntity.entityName <> "" and
          touchedTriggerTargetsName(stats, x, y, mapEntity.entityName) then
        doorName := mapEntity.entityName;
      end if;
    end for;
  end func;

const func integer: countLightsInView (
    in archiveStats: stats,
    in float: viewMinX, in float: viewMinY,
    in float: viewMaxX, in float: viewMaxY) is func
  result
    var integer: lightCount is 0;
  local
    var selectedMapEntity: mapEntity is selectedMapEntity.value;
  begin
    for mapEntity range stats.selectedEntities do
      if isLightEntity(mapEntity) and mapEntity.hasOrigin and
          mapEntity.x >= viewMinX and mapEntity.x <= viewMaxX and
          mapEntity.y >= viewMinY and mapEntity.y <= viewMaxY then
        lightCount +:= 1;
      end if;
    end for;
  end func;

const func integer: countLightsInDebugCell (
    in archiveStats: stats, in float: cellMinX, in float: cellMinY) is func
  result
    var integer: lightCount is 0;
  local
    var float: cellMaxX is 0.0;
    var float: cellMaxY is 0.0;
  begin
    cellMaxX := cellMinX + DEBUG_RENDER_CELL_SIZE;
    cellMaxY := cellMinY + DEBUG_RENDER_CELL_SIZE;
    lightCount := countLightsInView(stats, cellMinX, cellMinY,
        cellMaxX, cellMaxY);
  end func;

const func integer: countGameplayEntitiesInView (
    in archiveStats: stats,
    in float: viewMinX, in float: viewMinY,
    in float: viewMaxX, in float: viewMaxY) is func
  result
    var integer: entityCount is 0;
  local
    var runtimeEntity: entity is runtimeEntity.value;
  begin
    for entity range stats.runtimeEntities do
      if runtimeEntityDebugMarker(entity) <> '.' and entity.hasOrigin and
          entity.x >= viewMinX and entity.x <= viewMaxX and
          entity.y >= viewMinY and entity.y <= viewMaxY then
        entityCount +:= 1;
      end if;
    end for;
  end func;

const func char: gameplayEntityMarkerInDebugCell (
    in archiveStats: stats, in float: cellMinX, in float: cellMinY) is func
  result
    var char: marker is '.';
  local
    var runtimeEntity: entity is runtimeEntity.value;
    var float: cellMaxX is 0.0;
    var float: cellMaxY is 0.0;
  begin
    cellMaxX := cellMinX + DEBUG_RENDER_CELL_SIZE;
    cellMaxY := cellMinY + DEBUG_RENDER_CELL_SIZE;
    for entity range stats.runtimeEntities do
      if marker = '.' and runtimeEntityDebugMarker(entity) <> '.' and
          entity.hasOrigin and entity.x >= cellMinX and
          entity.x <= cellMaxX and entity.y >= cellMinY and
          entity.y <= cellMaxY then
        marker := runtimeEntityDebugMarker(entity);
      end if;
    end for;
  end func;

const func integer: countActivatedDoorsInView (
    in archiveStats: stats,
    in float: playerX, in float: playerY,
    in float: viewMinX, in float: viewMinY,
    in float: viewMaxX, in float: viewMaxY) is func
  result
    var integer: doorCount is 0;
  local
    var selectedMapEntity: mapEntity is selectedMapEntity.value;
  begin
    for mapEntity range stats.selectedEntities do
      if isDoorEntity(mapEntity) and mapEntity.hasOrigin and
          touchedTriggerTargetsName(stats, playerX, playerY, mapEntity.entityName) and
          mapEntity.x >= viewMinX and mapEntity.x <= viewMaxX and
          mapEntity.y >= viewMinY and mapEntity.y <= viewMaxY then
        doorCount +:= 1;
      end if;
    end for;
  end func;

const func boolean: activatedDoorInDebugCell (
    in archiveStats: stats, in float: playerX, in float: playerY,
    in float: cellMinX, in float: cellMinY) is func
  result
    var boolean: found is FALSE;
  local
    var selectedMapEntity: mapEntity is selectedMapEntity.value;
    var float: cellMaxX is 0.0;
    var float: cellMaxY is 0.0;
  begin
    cellMaxX := cellMinX + DEBUG_RENDER_CELL_SIZE;
    cellMaxY := cellMinY + DEBUG_RENDER_CELL_SIZE;
    for mapEntity range stats.selectedEntities do
      if not found and isDoorEntity(mapEntity) and mapEntity.hasOrigin and
          touchedTriggerTargetsName(stats, playerX, playerY, mapEntity.entityName) and
          mapEntity.x >= cellMinX and mapEntity.x <= cellMaxX and
          mapEntity.y >= cellMinY and mapEntity.y <= cellMaxY then
        found := TRUE;
      end if;
    end for;
  end func;

const func string: debugRenderRow (
    in archiveStats: stats, in integer: rowIndex,
    in float: viewMinX, in float: viewMinY,
    in integer: playerCellX, in integer: playerCellY,
    in float: playerX, in float: playerY) is func
  result
    var string: rowText is "";
  local
    var integer: colIndex is 0;
    var integer: gridY is 0;
    var float: cellMinX is 0.0;
    var float: cellMinY is 0.0;
    var char: gameplayMarker is '.';
  begin
    gridY := pred(DEBUG_RENDER_GRID_SIZE) - rowIndex;
    for colIndex range 0 to pred(DEBUG_RENDER_GRID_SIZE) do
      cellMinX := viewMinX + float(colIndex) * DEBUG_RENDER_CELL_SIZE;
      cellMinY := viewMinY + float(gridY) * DEBUG_RENDER_CELL_SIZE;
      if colIndex = playerCellX and gridY = playerCellY then
        rowText &:= "P";
      elsif countLightsInDebugCell(stats, cellMinX, cellMinY) <> 0 then
        rowText &:= "L";
      elsif activatedDoorInDebugCell(stats, playerX, playerY, cellMinX,
          cellMinY) then
        rowText &:= "O";
      else
        gameplayMarker := gameplayEntityMarkerInDebugCell(stats, cellMinX,
            cellMinY);
        if gameplayMarker <> '.' then
          rowText &:= str(gameplayMarker);
        elsif countBrushBoundsInDebugCell(stats, cellMinX, cellMinY) <> 0 then
          rowText &:= "#";
        else
          rowText &:= ".";
        end if;
      end if;
    end for;
  end func;

const proc: addMapClassnameStats (inout archiveStats: stats,
    in string: content) is func
  local
    var string: contentLower is "";
    var string: className is "";
    var integer: searchPos is 1;
    var integer: keyPos is 0;
  begin
    contentLower := lower(content);
    keyPos := pos(contentLower, "\"classname\"", searchPos);
    while keyPos <> 0 do
      className := lower(quotedValueAfter(content, "classname", keyPos));
      if className = "light" or startsWith(className, "light_") then
        stats.mapLights +:= 1;
      elsif className = "func_static" then
        stats.mapFuncStatics +:= 1;
      elsif className = "func_door" or className = "mover_door" or
          startsWith(className, "door_") then
        stats.mapDoors +:= 1;
      elsif startsWith(className, "trigger_") then
        stats.mapTriggers +:= 1;
      elsif startsWith(className, "monster_") then
        stats.mapMonsters +:= 1;
      elsif startsWith(className, "item_") then
        stats.mapItems +:= 1;
      elsif startsWith(className, "ammo_") or startsWith(className, "weapon_") then
        stats.mapPickups +:= 1;
      elsif className = "info_player_start" then
        stats.mapPlayerStarts +:= 1;
      end if;
      searchPos := keyPos + length("\"classname\"");
      keyPos := pos(contentLower, "\"classname\"", searchPos);
    end while;
  end func;

const proc: addSelectedMapEntityInfo (inout archiveStats: stats,
    in string: content) is func
  local
    var string: contentLower is "";
    var string: className is "";
    var string: entityName is "";
    var string: origin is "";
    var string: model is "";
    var string: sound is "";
    var string: target is "";
    var string: angle is "";
    var string: health is "";
    var string: mins is "";
    var string: maxs is "";
    var string: lightRadius is "";
    var string: lightColor is "";
    var selectedMapEntity: mapEntity is selectedMapEntity.value;
    var integer: searchPos is 1;
    var integer: keyPos is 0;
    var integer: entityStart is 0;
    var integer: entityEnd is 0;
  begin
    contentLower := lower(content);
    keyPos := pos(contentLower, "\"classname\"", searchPos);
    while keyPos <> 0 do
      entityStart := rpos(content, "{", keyPos);
      if entityStart = 0 then
        entityStart := keyPos;
      end if;
      entityEnd := pos(content, "\n}", keyPos);
      if entityEnd = 0 then
        entityEnd := pos(content, "}", keyPos);
      end if;
      if entityEnd = 0 then
        entityEnd := length(content);
      end if;

      className := lower(quotedValueBetween(content, "classname", entityStart, entityEnd));
      entityName := quotedValueBetween(content, "name", entityStart, entityEnd);
      origin := quotedValueBetween(content, "origin", entityStart, entityEnd);
      model := quotedValueBetween(content, "model", entityStart, entityEnd);
      sound := quotedValueAfterKeyPrefix(content[entityStart .. entityEnd],
          "snd_", 1);
      target := quotedValueBetween(content, "target", entityStart, entityEnd);
      angle := quotedValueBetween(content, "angle", entityStart, entityEnd);
      health := quotedValueBetween(content, "health", entityStart, entityEnd);
      mins := quotedValueBetween(content, "mins", entityStart, entityEnd);
      maxs := quotedValueBetween(content, "maxs", entityStart, entityEnd);
      lightRadius := quotedValueBetween(content, "light_radius", entityStart, entityEnd);
      lightColor := quotedValueBetween(content, "_color", entityStart, entityEnd);

      if className <> "" then
        mapEntity := selectedMapEntity.value;
        mapEntity.className := className;
        mapEntity.entityName := entityName;
        mapEntity.originText := origin;
        mapEntity.model := model;
        mapEntity.sound := sound;
        mapEntity.target := target;
        mapEntity.angleText := angle;
        mapEntity.healthText := health;
        mapEntity.lightRadius := lightRadius;
        mapEntity.lightColor := lightColor;
        parseOriginIntoEntity(mapEntity);
        parseAngleIntoEntity(mapEntity);
        parseHealthIntoEntity(mapEntity);
        stats.selectedEntities &:= mapEntity;
        stats.selectedMapEntities +:= 1;
        if entityName <> "" then
          stats.selectedMapNamed +:= 1;
          appendUnique(stats.selectedEntityNames, lower(entityName));
        end if;
        if origin <> "" then
          stats.selectedMapWithOrigin +:= 1;
          addOriginToSelectedBounds(stats, origin);
        end if;
        if model <> "" then
          stats.selectedMapWithModel +:= 1;
          if isModelRef(model) then
            stats.selectedModelRefs +:= 1;
            appendUnique(stats.selectedModelStems, assetStem(model));
            if stats.firstSelectedModelRef = "" then
              stats.firstSelectedModelRef := model;
            end if;
          end if;
        end if;
        if target <> "" then
          stats.selectedMapWithTarget +:= 1;
          stats.selectedTargetRefs +:= 1;
          appendUnique(stats.selectedTargetNames, lower(target));
          if stats.firstTargetRef = "" then
            stats.firstTargetRef := target;
          end if;
        end if;
        if canParseVector3(mins) and canParseVector3(maxs) then
          stats.selectedMapWithBounds +:= 1;
        end if;
        if className = "light" or startsWith(className, "light_") then
          stats.selectedLights +:= 1;
          if canParseVector3(origin) then
            stats.selectedLightsWithOrigin +:= 1;
          end if;
          if canParseVector3(lightRadius) then
            stats.selectedLightsWithRadius +:= 1;
          end if;
          if canParseVector3(lightColor) then
            stats.selectedLightsWithColor +:= 1;
          end if;
          if stats.firstLightName = "" then
            stats.firstLightName := entityName;
            stats.firstLightOrigin := origin;
            stats.firstLightRadius := lightRadius;
            stats.firstLightColor := lightColor;
          end if;
        end if;
        if isSpawnRelevantClass(className) then
          stats.selectedMapSpawnReady +:= 1;
          appendUnique(stats.selectedSpawnClasses, className);
          if stats.firstSpawnClass = "" then
            stats.firstSpawnClass := className;
            stats.firstSpawnName := entityName;
            stats.firstSpawnOrigin := origin;
            stats.firstSpawnModel := model;
            stats.firstSpawnTarget := target;
          end if;
        end if;
      end if;
      searchPos := keyPos + length("\"classname\"");
      keyPos := pos(contentLower, "\"classname\"", searchPos);
    end while;
  end func;

const proc: parsePlayerStartNumbers (inout archiveStats: stats) is func
  local
    var array string: originParts is 0 times "";
  begin
    stats.playerStartParsed := FALSE;
    if stats.playerStartOrigin <> "" then
      originParts := noEmptyStrings(split(trim(stats.playerStartOrigin), ' '));
      if length(originParts) >= 3 then
        block
          stats.playerStartX := float(originParts[1]);
          stats.playerStartY := float(originParts[2]);
          stats.playerStartZ := float(originParts[3]);
          if stats.playerStartAngle <> "" then
            stats.playerStartYaw := float(trim(stats.playerStartAngle));
          else
            stats.playerStartYaw := 0.0;
          end if;
          stats.playerStartParsed := TRUE;
        exception
          catch RANGE_ERROR:
            stats.playerStartParsed := FALSE;
        end block;
      end if;
    end if;
  end func;

const proc: addRequestedMapInfo (inout archiveStats: stats,
    in string: filePath, in string: content) is func
  local
    var string: contentLower is "";
    var integer: playerStartPos is 0;
  begin
    stats.requestedMapFound := TRUE;
    stats.requestedMapPath := filePath;
    contentLower := lower(content);
    addSelectedMapEntityInfo(stats, content);
    addSelectedMapMaterialRefs(stats, content);
    addSelectedMapSurfaceMaterials(stats, content);
    stats.worldspawnFound := pos(contentLower, "\"classname\" \"worldspawn\"") <> 0;
    playerStartPos := pos(contentLower, "\"classname\" \"info_player_start\"");
    if playerStartPos <> 0 then
      stats.playerStartFound := TRUE;
      stats.playerStartOrigin := quotedValueAfter(content, "origin", playerStartPos);
      stats.playerStartAngle := quotedValueAfter(content, "angle", playerStartPos);
      parsePlayerStartNumbers(stats);
    end if;
  end func;

const proc: showUsage is func
  begin
    writeln("Usage:");
    writeln("  s7 doom3_seed7.s7 --doom3_data_path <doom3-root> [--doom3_start_map <map>]");
    writeln("  s7 doom3_seed7.s7 +set fs_basepath <doom3-root> +map <map>");
    writeln("");
    writeln("Required assets:");
    writeln("  A legal Doom 3 install with base/*.pk4 files. No commercial assets are bundled.");
    writeln("");
    writeln("Options:");
    writeln("  --doom3_data_path, +set fs_basepath   Doom 3 install root");
    writeln("  --doom3_base_path, +set fs_game       Base directory, default: base");
    writeln("  --doom3_start_map, +map               Map metadata target, default: game/mars_city1");
    writeln("  --doom3_render_mode                   metadata for Stage 1");
    writeln("  --doom3_save_path                     Save directory, not written in Stage 1");
    writeln("  --doom3_config_path                   Config directory, not written in Stage 1");
    writeln("  --set <name> <value>, +set <name> <value>");
    writeln("                                           Store a Doom-style console variable");
  end func;

const proc: parseArgs (inout doom3Config: config) is func
  local
    var array string: args is 0 times "";
    var integer: argIdx is 1;
  begin
    args := argv(PROGRAM);
    while argIdx <= length(args) do
      if args[argIdx] = "--help" or args[argIdx] = "-h" then
        config.showHelp := TRUE;
      elsif args[argIdx] = "--doom3_data_path" and argIdx < length(args) then
        incr(argIdx);
        config.dataPath := convDosPath(args[argIdx]);
        setCvar(config.cvars, "doom3_data_path", config.dataPath);
      elsif args[argIdx] = "--doom3_base_path" and argIdx < length(args) then
        incr(argIdx);
        config.basePath := convDosPath(args[argIdx]);
        setCvar(config.cvars, "doom3_base_path", config.basePath);
      elsif args[argIdx] = "--doom3_start_map" and argIdx < length(args) then
        incr(argIdx);
        config.startMap := args[argIdx];
        setCvar(config.cvars, "doom3_start_map", config.startMap);
      elsif args[argIdx] = "--doom3_render_mode" and argIdx < length(args) then
        incr(argIdx);
        config.renderMode := args[argIdx];
        setCvar(config.cvars, "doom3_render_mode", config.renderMode);
      elsif args[argIdx] = "--doom3_save_path" and argIdx < length(args) then
        incr(argIdx);
        config.savePath := convDosPath(args[argIdx]);
        setCvar(config.cvars, "doom3_save_path", config.savePath);
      elsif args[argIdx] = "--doom3_config_path" and argIdx < length(args) then
        incr(argIdx);
        config.configPath := convDosPath(args[argIdx]);
        setCvar(config.cvars, "doom3_config_path", config.configPath);
      elsif args[argIdx] = "--set" and argIdx + 2 <= length(args) then
        setCvar(config.cvars, args[argIdx + 1], args[argIdx + 2]);
        argIdx +:= 2;
      elsif args[argIdx] = "+set" and argIdx + 2 <= length(args) then
        setCvar(config.cvars, args[argIdx + 1], args[argIdx + 2]);
        if args[argIdx + 1] = "fs_basepath" then
          config.dataPath := convDosPath(args[argIdx + 2]);
        elsif args[argIdx + 1] = "fs_game" then
          config.basePath := convDosPath(args[argIdx + 2]);
        end if;
        argIdx +:= 2;
      elsif args[argIdx] = "+map" and argIdx < length(args) then
        incr(argIdx);
        config.startMap := args[argIdx];
      else
        logWarn("ignored argument: " <& args[argIdx]);
      end if;
      incr(argIdx);
    end while;
    if config.basePath = "" then
      config.basePath := joinPath(config.dataPath, DEFAULT_BASE_DIR);
    end if;
    setCvar(config.cvars, "doom3_data_path", config.dataPath);
    setCvar(config.cvars, "doom3_base_path", config.basePath);
    setCvar(config.cvars, "doom3_start_map", config.startMap);
    setCvar(config.cvars, "doom3_render_mode", config.renderMode);
    setCvar(config.cvars, "doom3_save_path", config.savePath);
    setCvar(config.cvars, "doom3_config_path", config.configPath);
    setCvar(config.cvars, "fs_basepath", config.dataPath);
    setCvar(config.cvars, "fs_game", config.basePath);
  end func;

const func array string: findPk4Archives (in string: basePath) is func
  result
    var array string: pk4Files is 0 times "";
  local
    var array string: names is 0 times "";
    var string: name is "";
  begin
    if fileType(basePath) = FILE_DIR then
      names := readDir(basePath);
      for name range names do
        if isPk4Name(name) and fileType(joinPath(basePath, name)) = FILE_REGULAR then
          pk4Files &:= joinPath(basePath, name);
        end if;
      end for;
    end if;
  end func;

const proc: addCompiledCompanionStats (in string: pk4File,
    in string: targetProcPath, in string: targetCmPath,
    inout integer: procAssets, inout integer: cmAssets,
    inout boolean: targetProcFound, inout boolean: targetCmFound) is func
  local
    var fileSys: zipFs is fileSys.value;
    var array string: paths is 0 times "";
    var string: path is "";
    var string: pathLower is "";
  begin
    zipFs := openZip(pk4File);
    if zipFs <> fileSys.value then
      paths := readDir(zipFs, RECURSIVE);
      for path range paths do
        pathLower := normalizedAssetPath(path);
        if endsWith(pathLower, ".proc") then
          procAssets +:= 1;
          if pathLower = targetProcPath then
            targetProcFound := TRUE;
          end if;
        elsif endsWith(pathLower, ".cm") then
          cmAssets +:= 1;
          if pathLower = targetCmPath then
            targetCmFound := TRUE;
          end if;
        end if;
      end for;
      close(zipFs);
    end if;
  end func;

const proc: addFileToStats (inout archiveStats: stats, in string: filePath) is func
  local
    var string: pathLower is "";
  begin
    pathLower := lower(filePath);
    stats.totalFiles +:= 1;
    if endsWith(pathLower, ".decl") then
      stats.declFiles +:= 1;
      if stats.firstDecl = "" then
        stats.firstDecl := filePath;
      end if;
    elsif endsWith(pathLower, ".mtr") then
      stats.materialFiles +:= 1;
      if stats.firstMaterial = "" then
        stats.firstMaterial := filePath;
      end if;
    elsif endsWith(pathLower, ".def") then
      stats.defFiles +:= 1;
      if stats.firstDef = "" then
        stats.firstDef := filePath;
      end if;
    elsif endsWith(pathLower, ".map") then
      stats.mapFiles +:= 1;
      if stats.firstMap = "" then
        stats.firstMap := filePath;
      end if;
    elsif endsWith(pathLower, ".script") then
      stats.scriptFiles +:= 1;
      if stats.firstScript = "" then
        stats.firstScript := filePath;
      end if;
    elsif isImageRef(pathLower) then
      stats.imageRefs +:= 1;
      stats.imageAssets +:= 1;
      appendUnique(stats.imageAssetStems, assetStem(pathLower));
      if stats.firstImageAsset = "" then
        stats.firstImageAsset := filePath;
      end if;
    elsif isSoundRef(pathLower) then
      stats.soundRefs +:= 1;
      stats.soundAssets +:= 1;
      appendUnique(stats.soundAssetStems, assetStem(pathLower));
      if stats.firstSoundAsset = "" then
        stats.firstSoundAsset := filePath;
      end if;
    elsif isModelRef(pathLower) then
      stats.modelAssets +:= 1;
      appendUnique(stats.modelAssetStems, assetStem(pathLower));
      if stats.firstModelAsset = "" then
        stats.firstModelAsset := filePath;
      end if;
    end if;
  end func;

const proc: addContentToStats (inout archiveStats: stats, in string: filePath,
    in string: content) is func
  local
    var string: pathLower is "";
    var string: contentLower is "";
  begin
    pathLower := lower(filePath);
    contentLower := lower(content);
    stats.imageRefs +:= countAnyAssetRefs(contentLower, ".tga", ".dds", ".jpg") +
        countOccurrences(contentLower, ".png");
    stats.soundRefs +:= countAnyAssetRefs(contentLower, ".wav", ".ogg", ".mp3");
    addTextSoundRefs(stats, content);

    if endsWith(pathLower, ".def") or endsWith(pathLower, ".decl") then
      stats.entityDefs +:= countOccurrences(contentLower, "entitydef ");
      stats.scriptSpawnargRefs +:= countOccurrences(contentLower,
          "\"scriptobject\"") + countOccurrences(contentLower, "\"call\"");
      addEntityDefNames(stats, content);
      addEntityDefRecords(stats, content);
    elsif endsWith(pathLower, ".map") then
      stats.mapEntities +:= countOccurrences(contentLower, "\"classname\"");
      stats.scriptSpawnargRefs +:= countOccurrences(contentLower,
          "\"scriptobject\"") + countOccurrences(contentLower, "\"call\"");
      addMapClassnameStats(stats, content);
      stats.mapBrushes +:= countOccurrences(contentLower, "brushdef3");
      stats.mapPatches +:= countOccurrences(contentLower, "patchdef2") +
          countOccurrences(contentLower, "patchdef3");
    elsif endsWith(pathLower, ".script") then
      stats.scriptFunctions +:= countOccurrences(contentLower, "void ");
    elsif endsWith(pathLower, ".mtr") then
      stats.materialStages +:= countOccurrences(contentLower, "{");
      stats.materialNoShadows +:= countOccurrences(contentLower, "noshadows");
      stats.materialTwoSided +:= countOccurrences(contentLower, "twosided");
      stats.materialTranslucent +:= countOccurrences(contentLower, "translucent");
      stats.materialBlendStages +:= countOccurrences(contentLower, "blend ");
      addMaterialDeclNames(stats, content);
      addMaterialTextureBindings(stats, content);
      addMaterialTextureRefs(stats, content);
    end if;
  end func;

const func archiveStats: scanArchive (in string: pk4File,
    in string: targetMapPath) is func
  result
    var archiveStats: stats is archiveStats.value;
  local
    var fileSys: zipFs is fileSys.value;
    var array string: paths is 0 times "";
    var string: path is "";
    var string: content is "";
  begin
    zipFs := openZip(pk4File);
    if zipFs = fileSys.value then
      logWarn("could not open pk4 archive: " <& pk4File);
    else
      paths := readDir(zipFs, RECURSIVE);
      for path range paths do
        addFileToStats(stats, path);
        if isTextAssetPath(path) then
          content := getFile(zipFs, path);
          addContentToStats(stats, path, content);
          if normalizedAssetPath(path) = targetMapPath then
            addRequestedMapInfo(stats, path, content);
          end if;
        end if;
      end for;
      close(zipFs);
    end if;
  end func;

const proc: mergeStats (inout archiveStats: totalStats,
    in archiveStats: archiveStatsValue) is func
  local
    var string: className is "";
    var entityDefRecord: defRecord is entityDefRecord.value;
    var selectedMapEntity: mapEntity is selectedMapEntity.value;
    var runtimeEntity: entity is runtimeEntity.value;
    var integer: bindingIndex is 1;
    var selectedBrushPlane: brushPlane is selectedBrushPlane.value;
    var selectedBrushBounds: brushBounds is selectedBrushBounds.value;
    var runtimeRenderSurface: surface is runtimeRenderSurface.value;
  begin
    totalStats.totalFiles +:= archiveStatsValue.totalFiles;
    totalStats.declFiles +:= archiveStatsValue.declFiles;
    totalStats.materialFiles +:= archiveStatsValue.materialFiles;
    totalStats.defFiles +:= archiveStatsValue.defFiles;
    totalStats.mapFiles +:= archiveStatsValue.mapFiles;
    totalStats.scriptFiles +:= archiveStatsValue.scriptFiles;
    totalStats.imageRefs +:= archiveStatsValue.imageRefs;
    totalStats.imageAssets +:= archiveStatsValue.imageAssets;
    totalStats.soundRefs +:= archiveStatsValue.soundRefs;
    totalStats.soundAssets +:= archiveStatsValue.soundAssets;
    totalStats.textSoundRefs +:= archiveStatsValue.textSoundRefs;
    totalStats.modelAssets +:= archiveStatsValue.modelAssets;
    totalStats.selectedModelRefs +:= archiveStatsValue.selectedModelRefs;
    totalStats.entityDefs +:= archiveStatsValue.entityDefs;
    totalStats.entityDefNamed +:= archiveStatsValue.entityDefNamed;
    totalStats.entityDefHealthValues +:= archiveStatsValue.entityDefHealthValues;
    totalStats.entityDefModelValues +:= archiveStatsValue.entityDefModelValues;
    totalStats.entityDefSoundValues +:= archiveStatsValue.entityDefSoundValues;
    totalStats.entityDefInheritValues +:= archiveStatsValue.entityDefInheritValues;
    totalStats.entityDefBoundsValues +:= archiveStatsValue.entityDefBoundsValues;
    totalStats.materialDecls +:= archiveStatsValue.materialDecls;
    totalStats.materialTextureBindings +:= archiveStatsValue.materialTextureBindings;
    totalStats.materialNoShadows +:= archiveStatsValue.materialNoShadows;
    totalStats.materialTwoSided +:= archiveStatsValue.materialTwoSided;
    totalStats.materialTranslucent +:= archiveStatsValue.materialTranslucent;
    totalStats.materialBlendStages +:= archiveStatsValue.materialBlendStages;
    totalStats.materialTextureRefs +:= archiveStatsValue.materialTextureRefs;
    totalStats.mapEntities +:= archiveStatsValue.mapEntities;
    totalStats.mapLights +:= archiveStatsValue.mapLights;
    totalStats.mapFuncStatics +:= archiveStatsValue.mapFuncStatics;
    totalStats.mapDoors +:= archiveStatsValue.mapDoors;
    totalStats.mapTriggers +:= archiveStatsValue.mapTriggers;
    totalStats.mapMonsters +:= archiveStatsValue.mapMonsters;
    totalStats.mapItems +:= archiveStatsValue.mapItems;
    totalStats.mapPickups +:= archiveStatsValue.mapPickups;
    totalStats.mapPlayerStarts +:= archiveStatsValue.mapPlayerStarts;
    totalStats.mapBrushes +:= archiveStatsValue.mapBrushes;
    totalStats.mapPatches +:= archiveStatsValue.mapPatches;
    totalStats.scriptFunctions +:= archiveStatsValue.scriptFunctions;
    totalStats.scriptSpawnargRefs +:= archiveStatsValue.scriptSpawnargRefs;
    totalStats.materialStages +:= archiveStatsValue.materialStages;
    if not totalStats.requestedMapFound and archiveStatsValue.requestedMapFound then
      totalStats.requestedMapFound := TRUE;
      totalStats.requestedMapPath := archiveStatsValue.requestedMapPath;
      totalStats.worldspawnFound := archiveStatsValue.worldspawnFound;
      totalStats.playerStartFound := archiveStatsValue.playerStartFound;
      totalStats.playerStartParsed := archiveStatsValue.playerStartParsed;
      totalStats.selectedMapEntities := archiveStatsValue.selectedMapEntities;
      totalStats.selectedMapNamed := archiveStatsValue.selectedMapNamed;
      totalStats.selectedMapWithOrigin := archiveStatsValue.selectedMapWithOrigin;
      totalStats.selectedMapWithModel := archiveStatsValue.selectedMapWithModel;
      totalStats.selectedMapWithTarget := archiveStatsValue.selectedMapWithTarget;
      totalStats.selectedMapWithBounds := archiveStatsValue.selectedMapWithBounds;
      totalStats.selectedTargetRefs := archiveStatsValue.selectedTargetRefs;
      totalStats.selectedModelRefs := archiveStatsValue.selectedModelRefs;
      totalStats.selectedMapSpawnReady := archiveStatsValue.selectedMapSpawnReady;
      totalStats.selectedMapMaterialRefs := archiveStatsValue.selectedMapMaterialRefs;
      totalStats.selectedBrushMaterialRefs := archiveStatsValue.selectedBrushMaterialRefs;
      totalStats.selectedPatchMaterialRefs := archiveStatsValue.selectedPatchMaterialRefs;
      totalStats.selectedBrushPlaneLines := archiveStatsValue.selectedBrushPlaneLines;
      totalStats.selectedOriginVectors := archiveStatsValue.selectedOriginVectors;
      totalStats.selectedLights := archiveStatsValue.selectedLights;
      totalStats.selectedLightsWithOrigin := archiveStatsValue.selectedLightsWithOrigin;
      totalStats.selectedLightsWithRadius := archiveStatsValue.selectedLightsWithRadius;
      totalStats.selectedLightsWithColor := archiveStatsValue.selectedLightsWithColor;
      totalStats.selectedBoundsValid := archiveStatsValue.selectedBoundsValid;
      totalStats.selectedMinX := archiveStatsValue.selectedMinX;
      totalStats.selectedMinY := archiveStatsValue.selectedMinY;
      totalStats.selectedMinZ := archiveStatsValue.selectedMinZ;
      totalStats.selectedMaxX := archiveStatsValue.selectedMaxX;
      totalStats.selectedMaxY := archiveStatsValue.selectedMaxY;
      totalStats.selectedMaxZ := archiveStatsValue.selectedMaxZ;
      totalStats.firstSpawnClass := archiveStatsValue.firstSpawnClass;
      totalStats.firstSpawnName := archiveStatsValue.firstSpawnName;
      totalStats.firstSpawnOrigin := archiveStatsValue.firstSpawnOrigin;
      totalStats.firstSpawnModel := archiveStatsValue.firstSpawnModel;
      totalStats.firstSpawnTarget := archiveStatsValue.firstSpawnTarget;
      totalStats.firstTargetRef := archiveStatsValue.firstTargetRef;
      totalStats.firstSelectedModelRef := archiveStatsValue.firstSelectedModelRef;
      totalStats.firstLightName := archiveStatsValue.firstLightName;
      totalStats.firstLightOrigin := archiveStatsValue.firstLightOrigin;
      totalStats.firstLightRadius := archiveStatsValue.firstLightRadius;
      totalStats.firstLightColor := archiveStatsValue.firstLightColor;
      totalStats.firstMapMaterialRef := archiveStatsValue.firstMapMaterialRef;
      totalStats.playerStartOrigin := archiveStatsValue.playerStartOrigin;
      totalStats.playerStartAngle := archiveStatsValue.playerStartAngle;
      totalStats.playerStartX := archiveStatsValue.playerStartX;
      totalStats.playerStartY := archiveStatsValue.playerStartY;
      totalStats.playerStartZ := archiveStatsValue.playerStartZ;
      totalStats.playerStartYaw := archiveStatsValue.playerStartYaw;
    end if;
    if totalStats.firstMap = "" then
      totalStats.firstMap := archiveStatsValue.firstMap;
    end if;
    if totalStats.firstDecl = "" then
      totalStats.firstDecl := archiveStatsValue.firstDecl;
    end if;
    if totalStats.firstMaterial = "" then
      totalStats.firstMaterial := archiveStatsValue.firstMaterial;
    end if;
    if totalStats.firstDef = "" then
      totalStats.firstDef := archiveStatsValue.firstDef;
    end if;
    if totalStats.firstScript = "" then
      totalStats.firstScript := archiveStatsValue.firstScript;
    end if;
    if totalStats.firstEntityDef = "" then
      totalStats.firstEntityDef := archiveStatsValue.firstEntityDef;
    end if;
    if totalStats.firstEntityDefHealthClass = "" then
      totalStats.firstEntityDefHealthClass :=
          archiveStatsValue.firstEntityDefHealthClass;
    end if;
    if totalStats.firstEntityDefModelClass = "" then
      totalStats.firstEntityDefModelClass :=
          archiveStatsValue.firstEntityDefModelClass;
    end if;
    if totalStats.firstEntityDefSoundClass = "" then
      totalStats.firstEntityDefSoundClass :=
          archiveStatsValue.firstEntityDefSoundClass;
    end if;
    if totalStats.firstEntityDefInheritClass = "" then
      totalStats.firstEntityDefInheritClass :=
          archiveStatsValue.firstEntityDefInheritClass;
    end if;
    if totalStats.firstEntityDefBoundsClass = "" then
      totalStats.firstEntityDefBoundsClass :=
          archiveStatsValue.firstEntityDefBoundsClass;
    end if;
    if totalStats.firstMaterialDecl = "" then
      totalStats.firstMaterialDecl := archiveStatsValue.firstMaterialDecl;
    end if;
    if totalStats.firstMaterialTextureBinding = "" then
      totalStats.firstMaterialTextureBinding :=
          archiveStatsValue.firstMaterialTextureBinding;
    end if;
    if totalStats.firstImageAsset = "" then
      totalStats.firstImageAsset := archiveStatsValue.firstImageAsset;
    end if;
    if totalStats.firstMaterialTextureRef = "" then
      totalStats.firstMaterialTextureRef := archiveStatsValue.firstMaterialTextureRef;
    end if;
    if totalStats.firstSoundAsset = "" then
      totalStats.firstSoundAsset := archiveStatsValue.firstSoundAsset;
    end if;
    if totalStats.firstTextSoundRef = "" then
      totalStats.firstTextSoundRef := archiveStatsValue.firstTextSoundRef;
    end if;
    if totalStats.firstModelAsset = "" then
      totalStats.firstModelAsset := archiveStatsValue.firstModelAsset;
    end if;
    for className range archiveStatsValue.entityDefNames do
      appendUnique(totalStats.entityDefNames, className);
    end for;
    for defRecord range archiveStatsValue.entityDefRecords do
      totalStats.entityDefRecords &:= defRecord;
    end for;
    for className range archiveStatsValue.imageAssetStems do
      appendUnique(totalStats.imageAssetStems, className);
    end for;
    for className range archiveStatsValue.materialTextureStems do
      appendUnique(totalStats.materialTextureStems, className);
    end for;
    for className range archiveStatsValue.soundAssetStems do
      appendUnique(totalStats.soundAssetStems, className);
    end for;
    for className range archiveStatsValue.textSoundStems do
      appendUnique(totalStats.textSoundStems, className);
    end for;
    for className range archiveStatsValue.modelAssetStems do
      appendUnique(totalStats.modelAssetStems, className);
    end for;
    for className range archiveStatsValue.selectedModelStems do
      appendUnique(totalStats.selectedModelStems, className);
    end for;
    for className range archiveStatsValue.runtimeModelStems do
      appendUnique(totalStats.runtimeModelStems, className);
    end for;
    for className range archiveStatsValue.runtimeSoundStems do
      appendUnique(totalStats.runtimeSoundStems, className);
    end for;
    for className range archiveStatsValue.materialNames do
      appendUnique(totalStats.materialNames, className);
    end for;
    for bindingIndex range 1 to length(archiveStatsValue.mtrBindingNames) do
      totalStats.mtrBindingNames &:=
          archiveStatsValue.mtrBindingNames[bindingIndex];
      totalStats.mtrBindingTextureStems &:=
          archiveStatsValue.mtrBindingTextureStems[bindingIndex];
    end for;
    for className range archiveStatsValue.selectedSpawnClasses do
      appendUnique(totalStats.selectedSpawnClasses, className);
    end for;
    for className range archiveStatsValue.selectedEntityNames do
      appendUnique(totalStats.selectedEntityNames, className);
    end for;
    for className range archiveStatsValue.selectedTargetNames do
      appendUnique(totalStats.selectedTargetNames, className);
    end for;
    for className range archiveStatsValue.selectedMapMaterials do
      appendUnique(totalStats.selectedMapMaterials, className);
    end for;
    for className range archiveStatsValue.selectedBrushMaterials do
      appendUnique(totalStats.selectedBrushMaterials, className);
    end for;
    for className range archiveStatsValue.selectedPatchMaterials do
      appendUnique(totalStats.selectedPatchMaterials, className);
    end for;
    for mapEntity range archiveStatsValue.selectedEntities do
      totalStats.selectedEntities &:= mapEntity;
    end for;
    for entity range archiveStatsValue.runtimeEntities do
      totalStats.runtimeEntities &:= entity;
    end for;
    for brushPlane range archiveStatsValue.selectedBrushPlanes do
      totalStats.selectedBrushPlanes &:= brushPlane;
    end for;
    for brushBounds range archiveStatsValue.selectedBrushBoundsList do
      totalStats.selectedBrushBoundsList &:= brushBounds;
    end for;
    for surface range archiveStatsValue.runtimeRenderSurfaces do
      totalStats.runtimeRenderSurfaces &:= surface;
    end for;
  end func;

const proc: printStats (in archiveStats: stats) is func
  local
    var integer: declaredSpawnClasses is 0;
    var integer: missingSpawnClasses is 0;
    var integer: declaredMapMaterials is 0;
    var integer: missingMapMaterials is 0;
    var integer: declaredBrushMaterials is 0;
    var integer: missingBrushMaterials is 0;
    var integer: declaredPatchMaterials is 0;
    var integer: missingPatchMaterials is 0;
    var integer: availableTextureRefs is 0;
    var integer: missingTextureRefs is 0;
    var integer: availableSoundRefs is 0;
    var integer: missingSoundRefs is 0;
    var integer: availableModelRefs is 0;
    var integer: missingModelRefs is 0;
    var integer: resolvedTargetRefs is 0;
    var integer: missingTargetRefs is 0;
    var integer: entityRecordsWithOrigin is 0;
    var integer: entityRecordsWithAngle is 0;
    var integer: entityRecordsWithHealth is 0;
    var integer: entityRecordsWithSound is 0;
    var integer: runtimeEntitiesWithOrigin is 0;
    var integer: runtimeActiveEntities is 0;
    var integer: runtimeSolidEntities is 0;
    var integer: runtimeTriggerEntities is 0;
    var integer: runtimeHostileEntities is 0;
    var integer: runtimeUnsupportedSelectedEntities is 0;
    var integer: runtimeCustomHealthEntities is 0;
    var integer: runtimeMapHealthOverrides is 0;
    var integer: runtimeMapSoundOverrides is 0;
    var integer: runtimeEntitiesWithModel is 0;
    var integer: runtimeEntitiesWithAvailableModel is 0;
    var integer: runtimeEntitiesWithMissingModel is 0;
    var integer: runtimeEntitiesWithSound is 0;
    var integer: runtimeEntitiesWithAvailableSound is 0;
    var integer: runtimeEntitiesWithMissingSound is 0;
    var string: firstRuntimeEntity is "";
    var string: firstRuntimeHealthEntity is "";
    var integer: firstRuntimeHealth is 0;
    var string: firstRuntimeCustomHealthEntity is "";
    var integer: firstRuntimeCustomHealthValue is 0;
    var string: firstRuntimeModelEntity is "";
    var string: firstRuntimeModel is "";
    var string: firstRuntimeSoundEntity is "";
    var string: firstRuntimeSound is "";
    var string: firstUnsupportedSelectedClass is "";
    var integer: brushPlanesWithMaterial is 0;
    var integer: completeBrushBounds is 0;
    var integer: visibleRenderSurfaces is 0;
    var integer: declaredRenderSurfaceMaterials is 0;
    var integer: fallbackRenderSurfaceMaterials is 0;
    var integer: renderSurfacesWithFallbackColor is 0;
    var string: firstRenderMaterial is "";
    var string: firstRenderFallbackColor is "";
    var string: firstRenderMaterialTexture is "";
    var boolean: firstRenderMaterialTextureAvailable is FALSE;
    var integer: queuedRenderSurfaces is 0;
    var integer: queuedLitRenderSurfaces is 0;
    var runtimeRenderSurface: nearestRenderSurface is runtimeRenderSurface.value;
    var float: nearestRenderSurfaceDistanceSquared is 0.0;
    var integer: nearestRenderSurfaceLights is 0;
    var string: nearestRenderSurfaceLightColor is "";
    var integer: playerSpawnBlockingBounds is 0;
    var integer: playerSpawnBlockingEntities is 0;
    var integer: playerProbeBlockingBounds is 0;
    var integer: playerProbeBlockingEntities is 0;
    var float: playerProbeX is 0.0;
    var float: playerProbeY is 0.0;
    var boolean: playerFirstMoveAccepted is FALSE;
    var float: playerFirstMoveX is 0.0;
    var float: playerFirstMoveY is 0.0;
    var integer: playerSimAcceptedSteps is 0;
    var integer: playerSimBlockingBounds is 0;
    var integer: playerSimBlockingEntities is 0;
    var boolean: playerSimStoppedByCollision is FALSE;
    var float: playerSimX is 0.0;
    var float: playerSimY is 0.0;
    var float: playerSimNextX is 0.0;
    var float: playerSimNextY is 0.0;
    var integer: simStep is 0;
    var float: debugViewSize is 0.0;
    var float: debugViewMinX is 0.0;
    var float: debugViewMinY is 0.0;
    var float: debugViewMaxX is 0.0;
    var float: debugViewMaxY is 0.0;
    var integer: debugVisibleBrushBounds is 0;
    var integer: debugVisibleLights is 0;
    var integer: debugVisibleGameplayEntities is 0;
    var integer: debugPlayerCellX is 0;
    var integer: debugPlayerCellY is 0;
    var boolean: debugRenderReady is FALSE;
    var integer: debugRowIndex is 0;
    var integer: touchedTriggers is 0;
    var integer: resolvedTouchedTargets is 0;
    var string: firstTouchedName is "";
    var string: firstTouchedTarget is "";
    var integer: activatedDoors is 0;
    var integer: activatedRuntimeDoors is 0;
    var integer: debugVisibleActivatedDoors is 0;
    var string: firstActivatedDoor is "";
    var string: missingClass is "";
    var string: missingMaterial is "";
    var string: missingTexture is "";
    var string: missingSound is "";
    var string: missingModel is "";
    var string: missingTarget is "";
  begin
    logInfo("files=" <& stats.totalFiles);
    logInfo("decl=" <& stats.declFiles <& " material=" <& stats.materialFiles <&
        " def=" <& stats.defFiles <& " map=" <& stats.mapFiles <&
        " script=" <& stats.scriptFiles);
    logInfo("image_refs=" <& stats.imageRefs <& " image_assets=" <&
        stats.imageAssets <& " unique_image_assets=" <&
        length(stats.imageAssetStems) <& " sound_refs=" <& stats.soundRefs <&
        " sound_assets=" <& stats.soundAssets <& " unique_sound_assets=" <&
        length(stats.soundAssetStems));
    logInfo("model_assets=" <& stats.modelAssets <& " unique_model_assets=" <&
        length(stats.modelAssetStems));
    logInfo("entity_defs=" <& stats.entityDefs <& " named_entity_defs=" <&
        stats.entityDefNamed <& " unique_entity_defs=" <&
        length(stats.entityDefNames));
    logInfo("entity_def_spawnargs health=" <& stats.entityDefHealthValues <&
        " model=" <& stats.entityDefModelValues <& " sound=" <&
        stats.entityDefSoundValues <& " inherit=" <&
        stats.entityDefInheritValues <& " bounds=" <&
        stats.entityDefBoundsValues);
    if stats.firstEntityDefHealthClass <> "" then
      logInfo("first_entity_def_health_class=" <&
          stats.firstEntityDefHealthClass);
    end if;
    if stats.firstEntityDefModelClass <> "" then
      logInfo("first_entity_def_model_class=" <&
          stats.firstEntityDefModelClass);
    end if;
    if stats.firstEntityDefSoundClass <> "" then
      logInfo("first_entity_def_sound_class=" <&
          stats.firstEntityDefSoundClass);
    end if;
    if stats.firstEntityDefInheritClass <> "" then
      logInfo("first_entity_def_inherit_class=" <&
          stats.firstEntityDefInheritClass);
    end if;
    if stats.firstEntityDefBoundsClass <> "" then
      logInfo("first_entity_def_bounds_class=" <&
          stats.firstEntityDefBoundsClass);
    end if;
    logInfo("material_decls=" <& stats.materialDecls <& " unique_materials=" <&
        length(stats.materialNames));
    logInfo("material_texture_bindings=" <& stats.materialTextureBindings <&
        " material_records=" <& length(stats.mtrBindingNames));
    if stats.firstMaterialTextureBinding <> "" then
      logInfo("first_material_texture_binding=" <&
          stats.firstMaterialTextureBinding);
    end if;
    logInfo("material_flags noshadows=" <& stats.materialNoShadows <&
        " twosided=" <& stats.materialTwoSided <& " translucent=" <&
        stats.materialTranslucent <& " blend_stages=" <&
        stats.materialBlendStages);
    availableTextureRefs := countAvailableTextureRefs(stats);
    missingTextureRefs := countMissingTextureRefs(stats);
    missingTexture := firstMissingTextureRef(stats);
    logInfo("material_texture_refs=" <& stats.materialTextureRefs <&
        " unique=" <& length(stats.materialTextureStems) <& " available=" <&
        availableTextureRefs <& " missing=" <& missingTextureRefs);
    if stats.firstImageAsset <> "" then
      logInfo("first_image_asset=" <& stats.firstImageAsset);
    end if;
    if stats.firstMaterialTextureRef <> "" then
      logInfo("first_material_texture_ref=" <& stats.firstMaterialTextureRef);
    end if;
    if missingTexture <> "" then
      logWarn("first material texture without image asset: " <& missingTexture);
    end if;
    availableSoundRefs := countAvailableSoundRefs(stats);
    missingSoundRefs := countMissingSoundRefs(stats);
    missingSound := firstMissingSoundRef(stats);
    logInfo("text_sound_refs=" <& stats.textSoundRefs <& " unique=" <&
        length(stats.textSoundStems) <& " available=" <& availableSoundRefs <&
        " missing=" <& missingSoundRefs);
    if stats.firstSoundAsset <> "" then
      logInfo("first_sound_asset=" <& stats.firstSoundAsset);
    end if;
    if stats.firstTextSoundRef <> "" then
      logInfo("first_text_sound_ref=" <& stats.firstTextSoundRef);
    end if;
    if missingSound <> "" then
      logWarn("first sound reference without sound asset: " <& missingSound);
    end if;
    availableModelRefs := countAvailableModelRefs(stats);
    missingModelRefs := countMissingModelRefs(stats);
    missingModel := firstMissingModelRef(stats);
    logInfo("selected_model_refs=" <& stats.selectedModelRefs <& " unique=" <&
        length(stats.selectedModelStems) <& " available=" <& availableModelRefs <&
        " missing=" <& missingModelRefs);
    if stats.firstModelAsset <> "" then
      logInfo("first_model_asset=" <& stats.firstModelAsset);
    end if;
    if stats.firstSelectedModelRef <> "" then
      logInfo("first_selected_model_ref=" <& stats.firstSelectedModelRef);
    end if;
    if missingModel <> "" then
      logWarn("first selected model without model asset: " <& missingModel);
    end if;
    logInfo("map_entities=" <&
        stats.mapEntities <& " script_functions=" <& stats.scriptFunctions <&
        " script_spawnargs=" <& stats.scriptSpawnargRefs <&
        " material_stages=" <& stats.materialStages);
    logInfo("map_classes light=" <& stats.mapLights <& " func_static=" <&
        stats.mapFuncStatics <& " door=" <& stats.mapDoors <&
        " trigger=" <& stats.mapTriggers <& " monster=" <& stats.mapMonsters);
    logInfo("map_classes item=" <& stats.mapItems <& " pickup=" <&
        stats.mapPickups <& " player_start=" <& stats.mapPlayerStarts);
    logInfo("map_brushes=" <& stats.mapBrushes <& " map_patches=" <& stats.mapPatches);
    if stats.firstMap <> "" then
      logInfo("first_map=" <& stats.firstMap);
    end if;
    if stats.firstDecl <> "" then
      logInfo("first_decl=" <& stats.firstDecl);
    end if;
    if stats.firstMaterial <> "" then
      logInfo("first_material=" <& stats.firstMaterial);
    end if;
    if stats.firstDef <> "" then
      logInfo("first_def=" <& stats.firstDef);
    end if;
    if stats.firstScript <> "" then
      logInfo("first_script=" <& stats.firstScript);
    end if;
    if stats.firstEntityDef <> "" then
      logInfo("first_entity_def=" <& stats.firstEntityDef);
    end if;
    if stats.firstMaterialDecl <> "" then
      logInfo("first_material_decl=" <& stats.firstMaterialDecl);
    end if;
    if stats.requestedMapFound then
      declaredSpawnClasses := countDeclaredSpawnClasses(stats);
      missingSpawnClasses := countMissingSpawnClasses(stats);
      missingClass := firstMissingSpawnClass(stats);
      declaredMapMaterials := countDeclaredMapMaterials(stats);
      missingMapMaterials := countMissingMapMaterials(stats);
      missingMaterial := firstMissingMapMaterial(stats);
      declaredBrushMaterials := countDeclaredMaterials(stats, stats.selectedBrushMaterials);
      missingBrushMaterials := countMissingMaterials(stats, stats.selectedBrushMaterials);
      declaredPatchMaterials := countDeclaredMaterials(stats, stats.selectedPatchMaterials);
      missingPatchMaterials := countMissingMaterials(stats, stats.selectedPatchMaterials);
      resolvedTargetRefs := countResolvedTargetRefs(stats);
      missingTargetRefs := countMissingTargetRefs(stats);
      missingTarget := firstMissingTargetRef(stats);
      entityRecordsWithOrigin := countSelectedEntityRecordsWithOrigin(stats);
      entityRecordsWithAngle := countSelectedEntityRecordsWithAngle(stats);
      entityRecordsWithHealth := countSelectedEntityRecordsWithHealth(stats);
      entityRecordsWithSound := countSelectedEntityRecordsWithSound(stats);
      runtimeEntitiesWithOrigin := countRuntimeEntitiesWithOrigin(stats);
      runtimeActiveEntities := countActiveRuntimeEntities(stats);
      runtimeSolidEntities := countSolidRuntimeEntities(stats);
      runtimeTriggerEntities := countTriggerRuntimeEntities(stats);
      runtimeHostileEntities := countHostileRuntimeEntities(stats);
      runtimeUnsupportedSelectedEntities := countUnsupportedSelectedEntities(stats);
      runtimeCustomHealthEntities := countRuntimeEntitiesWithCustomHealth(stats);
      runtimeMapHealthOverrides := countRuntimeEntitiesWithMapHealthOverride(stats);
      runtimeMapSoundOverrides := countRuntimeEntitiesWithMapSoundOverride(stats);
      runtimeEntitiesWithModel := countRuntimeEntitiesWithModel(stats);
      runtimeEntitiesWithAvailableModel := countRuntimeEntitiesWithAvailableModel(stats);
      runtimeEntitiesWithMissingModel := countRuntimeEntitiesWithMissingModel(stats);
      runtimeEntitiesWithSound := countRuntimeEntitiesWithSound(stats);
      runtimeEntitiesWithAvailableSound := countRuntimeEntitiesWithAvailableSound(stats);
      runtimeEntitiesWithMissingSound := countRuntimeEntitiesWithMissingSound(stats);
      firstRuntimeEntity := firstRuntimeEntityName(stats);
      firstRuntimeHealthEntity := firstRuntimeEntityWithHealth(stats);
      firstRuntimeHealth := firstRuntimeEntityHealth(stats);
      firstRuntimeCustomHealthEntity := firstRuntimeEntityWithCustomHealth(stats);
      firstRuntimeCustomHealthValue := firstRuntimeCustomHealth(stats);
      firstRuntimeModelEntity := firstRuntimeEntityWithModel(stats);
      firstRuntimeModel := firstRuntimeEntityModel(stats);
      firstRuntimeSoundEntity := firstRuntimeEntityWithSound(stats);
      firstRuntimeSound := firstRuntimeEntitySound(stats);
      firstUnsupportedSelectedClass := firstUnsupportedSelectedEntityClass(stats);
      brushPlanesWithMaterial := countSelectedBrushPlanesWithMaterial(stats);
      completeBrushBounds := countCompleteSelectedBrushBounds(stats);
      visibleRenderSurfaces := countVisibleRenderSurfaces(stats);
      declaredRenderSurfaceMaterials := countDeclaredRenderSurfaceMaterials(stats);
      fallbackRenderSurfaceMaterials := countFallbackRenderSurfaceMaterials(stats);
      renderSurfacesWithFallbackColor := countRenderSurfacesWithFallbackColor(stats);
      firstRenderMaterial := firstRenderSurfaceMaterial(stats);
      firstRenderFallbackColor := firstRenderSurfaceFallbackColor(stats);
      firstRenderMaterialTexture := firstRenderSurfaceMaterialTexture(stats);
      firstRenderMaterialTextureAvailable :=
          containsString(stats.imageAssetStems, firstRenderMaterialTexture);
      if stats.playerStartParsed then
        playerSpawnBlockingBounds := countBrushBoundsContainingPoint(stats,
            stats.playerStartX, stats.playerStartY, stats.playerStartZ);
        playerSpawnBlockingEntities := countRuntimeSolidEntitiesBlockingPoint(stats,
            stats.playerStartX, stats.playerStartY);
        playerProbeX := forwardProbeX(stats);
        playerProbeY := forwardProbeY(stats);
        playerProbeBlockingBounds := countBrushBoundsContainingPoint(stats,
            playerProbeX, playerProbeY, stats.playerStartZ);
        playerProbeBlockingEntities := countRuntimeSolidEntitiesBlockingPoint(stats,
            playerProbeX, playerProbeY);
        playerFirstMoveAccepted := playerSpawnBlockingBounds = 0 and
            playerSpawnBlockingEntities = 0 and playerProbeBlockingBounds = 0 and
            playerProbeBlockingEntities = 0;
        if playerFirstMoveAccepted then
          playerFirstMoveX := playerProbeX;
          playerFirstMoveY := playerProbeY;
        else
          playerFirstMoveX := stats.playerStartX;
          playerFirstMoveY := stats.playerStartY;
        end if;
        playerSimX := stats.playerStartX;
        playerSimY := stats.playerStartY;
        if playerSpawnBlockingBounds <> 0 or playerSpawnBlockingEntities <> 0 then
          playerSimStoppedByCollision := TRUE;
          playerSimBlockingBounds := playerSpawnBlockingBounds;
          playerSimBlockingEntities := playerSpawnBlockingEntities;
        else
          for simStep range 1 to PLAYER_SIM_STEPS do
            if not playerSimStoppedByCollision then
              playerSimNextX := forwardStepX(stats, playerSimX);
              playerSimNextY := forwardStepY(stats, playerSimY);
              playerSimBlockingBounds := countBrushBoundsContainingPoint(stats,
                  playerSimNextX, playerSimNextY, stats.playerStartZ);
              playerSimBlockingEntities := countRuntimeSolidEntitiesBlockingPoint(stats,
                  playerSimNextX, playerSimNextY);
              if playerSimBlockingBounds = 0 and playerSimBlockingEntities = 0 then
                playerSimX := playerSimNextX;
                playerSimY := playerSimNextY;
                playerSimAcceptedSteps +:= 1;
              else
                playerSimStoppedByCollision := TRUE;
              end if;
            end if;
          end for;
        end if;
        debugViewSize := float(DEBUG_RENDER_GRID_SIZE) * DEBUG_RENDER_CELL_SIZE;
        debugViewMinX := playerSimX - debugViewSize / 2.0;
        debugViewMinY := playerSimY - debugViewSize / 2.0;
        debugViewMaxX := debugViewMinX + debugViewSize;
        debugViewMaxY := debugViewMinY + debugViewSize;
        debugVisibleBrushBounds := countBrushBoundsInView(stats,
            debugViewMinX, debugViewMinY, debugViewMaxX, debugViewMaxY);
        debugVisibleLights := countLightsInView(stats, debugViewMinX,
            debugViewMinY, debugViewMaxX, debugViewMaxY);
        debugVisibleGameplayEntities := countGameplayEntitiesInView(stats,
            debugViewMinX, debugViewMinY, debugViewMaxX, debugViewMaxY);
        debugPlayerCellX := debugGridCell(playerSimX, debugViewMinX);
        debugPlayerCellY := debugGridCell(playerSimY, debugViewMinY);
        debugRenderReady := completeBrushBounds > 0;
        touchedTriggers := countTouchedTriggers(stats, playerSimX, playerSimY);
        resolvedTouchedTargets := countResolvedTouchedTriggerTargets(stats,
            playerSimX, playerSimY);
        firstTouchedName := firstTouchedTriggerName(stats, playerSimX, playerSimY);
        firstTouchedTarget := firstTouchedTriggerTarget(stats, playerSimX, playerSimY);
        activatedDoors := countActivatedDoors(stats, playerSimX, playerSimY);
        activatedRuntimeDoors := countActivatedRuntimeDoors(stats, playerSimX, playerSimY);
        firstActivatedDoor := firstActivatedDoorName(stats, playerSimX, playerSimY);
        debugVisibleActivatedDoors := countActivatedDoorsInView(stats,
            playerSimX, playerSimY, debugViewMinX, debugViewMinY,
            debugViewMaxX, debugViewMaxY);
        queuedRenderSurfaces := countQueuedRenderSurfaces(stats,
            playerSimX, playerSimY, stats.playerStartYaw);
        queuedLitRenderSurfaces := countQueuedLitRenderSurfaces(stats,
            playerSimX, playerSimY, stats.playerStartYaw);
        nearestRenderSurface := nearestQueuedRenderSurface(stats,
            playerSimX, playerSimY, stats.playerStartYaw);
        if nearestRenderSurface.visible then
          nearestRenderSurfaceDistanceSquared := renderSurfaceDistanceSquared(
              nearestRenderSurface, playerSimX, playerSimY);
          nearestRenderSurfaceLights := countLightsAffectingRenderSurface(stats,
              nearestRenderSurface);
          nearestRenderSurfaceLightColor := firstLightColorAffectingRenderSurface(
              stats, nearestRenderSurface);
        end if;
      end if;
      logInfo("requested_map=" <& stats.requestedMapPath);
      logInfo("selected_map_entities=" <& stats.selectedMapEntities <&
          " spawn_ready=" <& stats.selectedMapSpawnReady <& " named=" <&
          stats.selectedMapNamed);
      logInfo("selected_entity_records=" <& length(stats.selectedEntities) <&
          " parsed_origin=" <& entityRecordsWithOrigin <&
          " parsed_angle=" <& entityRecordsWithAngle <&
          " parsed_health=" <& entityRecordsWithHealth <&
          " parsed_sound=" <& entityRecordsWithSound);
      logInfo("runtime_entities=" <& length(stats.runtimeEntities) <&
          " active=" <& runtimeActiveEntities <& " origin=" <&
          runtimeEntitiesWithOrigin <& " solid=" <& runtimeSolidEntities <&
          " trigger=" <& runtimeTriggerEntities <& " hostile=" <&
          runtimeHostileEntities);
      logInfo("runtime_entity_kinds player_spawn=" <&
          countRuntimeEntitiesByKind(stats, "player_spawn") <& " light=" <&
          countRuntimeEntitiesByKind(stats, "light") <& " static=" <&
          countRuntimeEntitiesByKind(stats, "static") <& " door=" <&
          countRuntimeEntitiesByKind(stats, "door") <& " trigger=" <&
          countRuntimeEntitiesByKind(stats, "trigger") <& " monster=" <&
          countRuntimeEntitiesByKind(stats, "monster") <& " pickup=" <&
          countRuntimeEntitiesByKind(stats, "pickup"));
      logInfo("runtime_unsupported_selected_entities=" <&
          runtimeUnsupportedSelectedEntities);
      logInfo("runtime_custom_health_entities=" <&
          runtimeCustomHealthEntities);
      logInfo("runtime_map_overrides health=" <& runtimeMapHealthOverrides <&
          " sound=" <& runtimeMapSoundOverrides);
      logInfo("runtime_model_refs=" <& runtimeEntitiesWithModel <&
          " unique=" <& length(stats.runtimeModelStems) <& " available=" <&
          runtimeEntitiesWithAvailableModel <& " missing=" <&
          runtimeEntitiesWithMissingModel);
      logInfo("runtime_sound_refs=" <& runtimeEntitiesWithSound <&
          " unique=" <& length(stats.runtimeSoundStems) <& " available=" <&
          runtimeEntitiesWithAvailableSound <& " missing=" <&
          runtimeEntitiesWithMissingSound);
      if firstRuntimeEntity <> "" then
        logInfo("first_runtime_entity=" <& firstRuntimeEntity);
      end if;
      if firstRuntimeHealthEntity <> "" then
        logInfo("first_runtime_health_entity=" <& firstRuntimeHealthEntity);
        logInfo("first_runtime_health=" <& firstRuntimeHealth);
      end if;
      if firstRuntimeCustomHealthEntity <> "" then
        logInfo("first_runtime_custom_health_entity=" <&
            firstRuntimeCustomHealthEntity);
        logInfo("first_runtime_custom_health=" <&
            firstRuntimeCustomHealthValue);
      end if;
      if firstRuntimeModelEntity <> "" then
        logInfo("first_runtime_model_entity=" <& firstRuntimeModelEntity);
        logInfo("first_runtime_model=" <& firstRuntimeModel);
      end if;
      if firstRuntimeSoundEntity <> "" then
        logInfo("first_runtime_sound_entity=" <& firstRuntimeSoundEntity);
        logInfo("first_runtime_sound=" <& firstRuntimeSound);
      end if;
      if firstUnsupportedSelectedClass <> "" then
        logWarn("first selected entity without runtime spawn support: " <&
            firstUnsupportedSelectedClass);
      end if;
      if length(stats.selectedEntities) >= 1 then
        logInfo("first_entity_record_class=" <&
            stats.selectedEntities[1].className);
        if stats.selectedEntities[1].entityName <> "" then
          logInfo("first_entity_record_name=" <&
              stats.selectedEntities[1].entityName);
        end if;
      end if;
      logInfo("selected_spawn_classes=" <& length(stats.selectedSpawnClasses) <&
          " declared_or_builtin=" <& declaredSpawnClasses <&
          " missing_decl=" <& missingSpawnClasses);
      if missingClass <> "" then
        logWarn("first spawn class without entityDef: " <& missingClass);
      end if;
      logInfo("selected_map_material_refs=" <& stats.selectedMapMaterialRefs <&
          " unique=" <& length(stats.selectedMapMaterials) <&
          " declared=" <& declaredMapMaterials <& " missing=" <&
          missingMapMaterials);
      if stats.firstMapMaterialRef <> "" then
        logInfo("first_map_material_ref=" <& stats.firstMapMaterialRef);
      end if;
      if missingMaterial <> "" then
        logWarn("first map material without declaration: " <& missingMaterial);
      end if;
      logInfo("surface_materials brush_refs=" <& stats.selectedBrushMaterialRefs <&
          " brush_unique=" <& length(stats.selectedBrushMaterials) <&
          " brush_declared=" <& declaredBrushMaterials <&
          " brush_missing=" <& missingBrushMaterials);
      logInfo("surface_materials patch_refs=" <& stats.selectedPatchMaterialRefs <&
          " patch_unique=" <& length(stats.selectedPatchMaterials) <&
          " patch_declared=" <& declaredPatchMaterials <&
          " patch_missing=" <& missingPatchMaterials);
      logInfo("selected_brush_plane_lines=" <& stats.selectedBrushPlaneLines);
      logInfo("selected_brush_plane_records=" <&
          length(stats.selectedBrushPlanes) <& " with_material=" <&
          brushPlanesWithMaterial);
      if length(stats.selectedBrushPlanes) >= 1 then
        logInfo("first_brush_plane=" <& stats.selectedBrushPlanes[1].normalX <&
            " " <& stats.selectedBrushPlanes[1].normalY <& " " <&
            stats.selectedBrushPlanes[1].normalZ <& " " <&
            stats.selectedBrushPlanes[1].distance);
        if stats.selectedBrushPlanes[1].materialName <> "" then
          logInfo("first_brush_plane_material=" <&
              stats.selectedBrushPlanes[1].materialName);
        end if;
      end if;
      logInfo("selected_brush_bounds=" <&
          length(stats.selectedBrushBoundsList) <& " complete=" <&
          completeBrushBounds);
      logInfo("render_surfaces=" <& length(stats.runtimeRenderSurfaces) <&
          " visible=" <& visibleRenderSurfaces <& " declared_material=" <&
          declaredRenderSurfaceMaterials <& " fallback_material=" <&
          fallbackRenderSurfaceMaterials <& " fallback_color=" <&
          renderSurfacesWithFallbackColor);
      if firstRenderMaterial <> "" then
        logInfo("first_render_surface_material=" <& firstRenderMaterial);
      end if;
      if firstRenderMaterialTexture <> "" then
        logInfo("first_render_surface_texture=" <& firstRenderMaterialTexture);
        logInfo("first_render_surface_texture_available=" <&
            firstRenderMaterialTextureAvailable);
      end if;
      if firstRenderFallbackColor <> "" then
        logInfo("first_render_surface_fallback_color=" <&
            firstRenderFallbackColor);
      end if;
      if length(stats.selectedBrushBoundsList) >= 1 and
          hasCompleteBrushBounds(stats.selectedBrushBoundsList[1]) then
        logInfo("first_brush_bounds_min=" <&
            stats.selectedBrushBoundsList[1].minX <& " " <&
            stats.selectedBrushBoundsList[1].minY <& " " <&
            stats.selectedBrushBoundsList[1].minZ);
        logInfo("first_brush_bounds_max=" <&
            stats.selectedBrushBoundsList[1].maxX <& " " <&
            stats.selectedBrushBoundsList[1].maxY <& " " <&
            stats.selectedBrushBoundsList[1].maxZ);
        if stats.selectedBrushBoundsList[1].materialName <> "" then
          logInfo("first_brush_bounds_material=" <&
              stats.selectedBrushBoundsList[1].materialName);
        end if;
      end if;
      logInfo("selected_origin_vectors=" <& stats.selectedOriginVectors);
      if stats.selectedBoundsValid then
        logInfo("selected_origin_bounds_min=" <& stats.selectedMinX <& " " <&
            stats.selectedMinY <& " " <& stats.selectedMinZ);
        logInfo("selected_origin_bounds_max=" <& stats.selectedMaxX <& " " <&
            stats.selectedMaxY <& " " <& stats.selectedMaxZ);
      end if;
      logInfo("selected_lights=" <& stats.selectedLights <& " origin=" <&
          stats.selectedLightsWithOrigin <& " radius=" <&
          stats.selectedLightsWithRadius <& " color=" <&
          stats.selectedLightsWithColor);
      if stats.firstLightName <> "" then
        logInfo("first_light_name=" <& stats.firstLightName);
      end if;
      if stats.firstLightOrigin <> "" then
        logInfo("first_light_origin=" <& stats.firstLightOrigin);
      end if;
      if stats.firstLightRadius <> "" then
        logInfo("first_light_radius=" <& stats.firstLightRadius);
      end if;
      if stats.firstLightColor <> "" then
        logInfo("first_light_color=" <& stats.firstLightColor);
      end if;
      logInfo("selected_map_keys origin=" <& stats.selectedMapWithOrigin <&
          " model=" <& stats.selectedMapWithModel <& " target=" <&
          stats.selectedMapWithTarget <& " bounds=" <&
          stats.selectedMapWithBounds);
      logInfo("selected_target_refs=" <& stats.selectedTargetRefs <&
          " unique=" <& length(stats.selectedTargetNames) <&
          " named_entities=" <& length(stats.selectedEntityNames) <&
          " resolved=" <& resolvedTargetRefs <& " missing=" <&
          missingTargetRefs);
      if stats.firstTargetRef <> "" then
        logInfo("first_target_ref=" <& stats.firstTargetRef);
      end if;
      if missingTarget <> "" then
        logWarn("first selected target without entity name: " <& missingTarget);
      end if;
      if stats.firstSpawnClass <> "" then
        logInfo("first_spawn_class=" <& stats.firstSpawnClass);
        if stats.firstSpawnName <> "" then
          logInfo("first_spawn_name=" <& stats.firstSpawnName);
        end if;
        if stats.firstSpawnOrigin <> "" then
          logInfo("first_spawn_origin=" <& stats.firstSpawnOrigin);
        end if;
        if stats.firstSpawnModel <> "" then
          logInfo("first_spawn_model=" <& stats.firstSpawnModel);
        end if;
        if stats.firstSpawnTarget <> "" then
          logInfo("first_spawn_target=" <& stats.firstSpawnTarget);
        end if;
      end if;
      logInfo("worldspawn_found=" <& stats.worldspawnFound);
      logInfo("player_start_found=" <& stats.playerStartFound);
      logInfo("player_start_parsed=" <& stats.playerStartParsed);
      if stats.playerStartOrigin <> "" then
        logInfo("player_start_origin=" <& stats.playerStartOrigin);
      end if;
      if stats.playerStartAngle <> "" then
        logInfo("player_start_angle=" <& stats.playerStartAngle);
      end if;
      if stats.playerStartParsed then
        logInfo("player_spawn_x=" <& stats.playerStartX);
        logInfo("player_spawn_y=" <& stats.playerStartY);
        logInfo("player_spawn_z=" <& stats.playerStartZ);
        logInfo("player_spawn_yaw=" <& stats.playerStartYaw);
        logInfo("player_spawn_blocking_bounds=" <& playerSpawnBlockingBounds);
        logInfo("player_spawn_blocking_runtime_entities=" <&
            playerSpawnBlockingEntities);
        logInfo("player_spawn_clear=" <&
            (playerSpawnBlockingBounds = 0 and playerSpawnBlockingEntities = 0));
        logInfo("player_forward_probe_x=" <& playerProbeX);
        logInfo("player_forward_probe_y=" <& playerProbeY);
        logInfo("player_forward_probe_blocking_bounds=" <&
            playerProbeBlockingBounds);
        logInfo("player_forward_probe_blocking_runtime_entities=" <&
            playerProbeBlockingEntities);
        logInfo("player_forward_probe_clear=" <&
            (playerProbeBlockingBounds = 0 and playerProbeBlockingEntities = 0));
        logInfo("player_first_move_accepted=" <& playerFirstMoveAccepted);
        logInfo("player_first_move_x=" <& playerFirstMoveX);
        logInfo("player_first_move_y=" <& playerFirstMoveY);
        logInfo("player_sim_requested_steps=" <& PLAYER_SIM_STEPS);
        logInfo("player_sim_accepted_steps=" <& playerSimAcceptedSteps);
        logInfo("player_sim_stopped_by_collision=" <&
            playerSimStoppedByCollision);
        logInfo("player_sim_blocking_bounds=" <& playerSimBlockingBounds);
        logInfo("player_sim_blocking_runtime_entities=" <&
            playerSimBlockingEntities);
        logInfo("player_sim_final_x=" <& playerSimX);
        logInfo("player_sim_final_y=" <& playerSimY);
        logInfo("trigger_touch_radius=" <& TRIGGER_TOUCH_RADIUS);
        logInfo("touched_triggers=" <& touchedTriggers);
        logInfo("resolved_touched_trigger_targets=" <& resolvedTouchedTargets);
        if firstTouchedName <> "" then
          logInfo("first_touched_trigger=" <& firstTouchedName);
        end if;
        if firstTouchedTarget <> "" then
          logInfo("first_touched_trigger_target=" <& firstTouchedTarget);
          logInfo("first_touched_trigger_target_resolved=" <&
              hasEntityNamed(stats, firstTouchedTarget));
        end if;
        logInfo("activated_doors=" <& activatedDoors);
        logInfo("activated_runtime_doors=" <& activatedRuntimeDoors);
        if firstActivatedDoor <> "" then
          logInfo("first_activated_door=" <& firstActivatedDoor);
        end if;
        logInfo("debug_render_grid=" <& DEBUG_RENDER_GRID_SIZE <& "x" <&
            DEBUG_RENDER_GRID_SIZE);
        logInfo("debug_render_view_min=" <& debugViewMinX <& " " <&
            debugViewMinY);
        logInfo("debug_render_view_max=" <& debugViewMaxX <& " " <&
            debugViewMaxY);
        logInfo("debug_render_player_cell=" <& debugPlayerCellX <& " " <&
            debugPlayerCellY);
        logInfo("debug_render_visible_brush_bounds=" <&
            debugVisibleBrushBounds);
        logInfo("debug_render_visible_lights=" <& debugVisibleLights);
        logInfo("debug_render_visible_gameplay_entities=" <&
            debugVisibleGameplayEntities);
        logInfo("debug_render_visible_activated_doors=" <&
            debugVisibleActivatedDoors);
        logInfo("render_queue_surfaces=" <& queuedRenderSurfaces);
        logInfo("render_queue_lit_surfaces=" <& queuedLitRenderSurfaces);
        logInfo("render_queue_ready=" <& (queuedRenderSurfaces <> 0));
        if nearestRenderSurface.visible then
          logInfo("nearest_render_surface_material=" <&
              nearestRenderSurface.materialName);
          logInfo("nearest_render_surface_fallback_color=" <&
              nearestRenderSurface.fallbackColor);
          logInfo("nearest_render_surface_distance_sq=" <&
              nearestRenderSurfaceDistanceSquared);
          logInfo("nearest_render_surface_lights=" <&
              nearestRenderSurfaceLights);
          if nearestRenderSurfaceLightColor <> "" then
            logInfo("nearest_render_surface_light_color=" <&
                nearestRenderSurfaceLightColor);
          end if;
        end if;
        logInfo("debug_render_ready=" <& debugRenderReady);
        if debugRenderReady then
          for debugRowIndex range 0 to pred(DEBUG_RENDER_GRID_SIZE) do
            logInfo("debug_render_row_" <& debugRowIndex <& "=" <&
                debugRenderRow(stats, debugRowIndex, debugViewMinX,
                debugViewMinY, debugPlayerCellX, debugPlayerCellY,
                playerSimX, playerSimY));
          end for;
        end if;
        logInfo("world_init_ready=" <& stats.worldspawnFound);
      else
        logWarn("player start exists but origin/angle could not be parsed as numbers");
      end if;
    else
      logWarn("requested map was not found in mounted pk4 archives");
    end if;
  end func;

const proc: main is func
  local
    var doom3Config: config is doom3Config.value;
    var array string: pk4Files is 0 times "";
    var string: pk4File is "";
    var string: targetMapPath is "";
    var string: targetProcPath is "";
    var string: targetCmPath is "";
    var integer: procAssets is 0;
    var integer: cmAssets is 0;
    var boolean: targetProcFound is FALSE;
    var boolean: targetCmFound is FALSE;
    var archiveStats: stats is archiveStats.value;
    var archiveStats: totalStats is archiveStats.value;
  begin
    parseArgs(config);
    if config.showHelp then
      showUsage;
    else
      logInfo(VERSION);
      logInfo("doom3_data_path=" <& config.dataPath);
      logInfo("doom3_base_path=" <& config.basePath);
      logInfo("doom3_start_map=" <& config.startMap);
      logInfo("doom3_render_mode=" <& config.renderMode);
      logInfo("doom3_save_path=" <& config.savePath);
      logInfo("doom3_config_path=" <& config.configPath);
      logInfo("cvars_registered=" <& length(config.cvars));
      if length(config.cvars) <> 0 then
        logInfo("first_cvar=" <& config.cvars[1].name <& "=" <&
            config.cvars[1].value);
      end if;
      logInfo("custom_cvars=" <& countCustomCvars(config.cvars));
      if firstCustomCvarName(config.cvars) <> "" then
        logInfo("first_custom_cvar=" <& firstCustomCvarName(config.cvars) <&
            "=" <& cvarValueForName(config.cvars,
            firstCustomCvarName(config.cvars)));
      end if;
      logInfo("cvar_fs_basepath=" <& cvarValueForName(config.cvars,
          "fs_basepath"));
      logInfo("cvar_fs_game=" <& cvarValueForName(config.cvars, "fs_game"));
      targetMapPath := mapNameToAssetPath(config.startMap);
      targetProcPath := compiledSiblingPath(targetMapPath, ".proc");
      targetCmPath := compiledSiblingPath(targetMapPath, ".cm");
      logInfo("target_map_asset=" <& targetMapPath);
      logInfo("target_compiled_assets proc=" <& targetProcPath <&
          " cm=" <& targetCmPath);
      logInfo("commercial Doom 3 assets are external and must not be committed");

      if fileType(config.basePath) <> FILE_DIR then
        logError("Doom 3 base directory not found: " <& config.basePath);
        logError("Expected a legal install path containing base/*.pk4");
      else
        pk4Files := findPk4Archives(config.basePath);
        if length(pk4Files) = 0 then
          logError("No .pk4 archives found in: " <& config.basePath);
        else
          logInfo("pk4_archives=" <& length(pk4Files));
          for pk4File range sort(pk4Files) do
            logInfo("mount=" <& pk4File);
            addCompiledCompanionStats(pk4File, targetProcPath, targetCmPath,
                procAssets, cmAssets, targetProcFound, targetCmFound);
            stats := scanArchive(pk4File, targetMapPath);
            mergeStats(totalStats, stats);
          end for;
          logInfo("compiled_assets proc=" <& procAssets <& " cm=" <&
              cmAssets);
          logInfo("selected_compiled_map proc_found=" <& targetProcFound <&
              " cm_found=" <& targetCmFound);
          rebuildRuntimeEntities(totalStats);
          printStats(totalStats);
          if totalStats.mapFiles = 0 then
            logWarn("No .map metadata found yet; renderer/gameplay stages will need map data.");
          end if;
          logInfo("Stage 1 asset pipeline complete.");
        end if;
      end if;
    end if;
  end func;
