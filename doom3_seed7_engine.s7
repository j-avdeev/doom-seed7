(********************************************************************)
(*  doom3_seed7_engine.s7                                           *)
(*                                                                  *)
(*  Seed7-core id Tech 4 compatibility shell for the browser path.  *)
(*  It uses generated replacement assets and a projected surface     *)
(*  renderer. The old simple DDA demo remains separate and is not    *)
(*  the default runtime entry.                                      *)
(********************************************************************)

$ include "seed7_05.s7i";
$ include "draw.s7i";
$ include "keybd.s7i";
$ include "float.s7i";
$ include "math.s7i";
$ include "duration.s7i";

const integer: SCREEN_WIDTH  is 960;
const integer: SCREEN_HEIGHT is 540;
const integer: VIEW_CENTER_X is SCREEN_WIDTH mdiv 2;
const integer: VIEW_CENTER_Y is SCREEN_HEIGHT mdiv 2;
const float:   FOCAL_LENGTH  is 390.0;
const float:   NEAR_PLANE    is 0.18;
const float:   FAR_DEPTH     is 38.0;
const float:   MOVE_SPEED    is 0.10;
const float:   ROT_SPEED     is 0.050;

const color: BLACK_VOID      is color(100, 130, 150);
const color: CEILING_DARK    is color(600, 850, 1050);
const color: FLOOR_DARK      is color(1550, 1300, 1050);
const color: METAL_RED       is color(15500, 3700, 2300);
const color: METAL_GREEN     is color(4300, 12800, 9900);
const color: METAL_BLUE      is color(3300, 6000, 14500);
const color: METAL_GREY      is color(11600, 11900, 11300);
const color: PANEL_BLACK     is color(650, 760, 830);
const color: EMISSIVE_AMBER  is color(53000, 24000, 4200);
const color: EMISSIVE_CYAN   is color(11500, 43000, 52000);
const color: HUD_RED         is color(47000, 4600, 2500);
const color: HUD_GREEN       is color(11500, 46000, 32000);
const color: HUD_AMBER       is color(54500, 27000, 4200);
const color: HUD_PANEL       is color(1600, 2100, 2500);
const color: HUD_PANEL_LIGHT is color(9800, 10600, 11200);
const color: HUD_TEXT        is color(61000, 52000, 15000);
const color: HUD_FACE        is color(43500, 24500, 13200);
const color: HUD_FACE_DARK   is color(14600, 6800, 4200);
const color: WEAPON_DARK     is color(1700, 2100, 2400);
const color: WEAPON_MID      is color(11200, 11600, 10800);
const color: MONSTER_BODY    is color(26000, 6200, 3400);
const color: MONSTER_HOT     is color(61000, 11500, 3600);

const type: engineConfig is new struct
    var boolean: showHelp is FALSE;
    var integer: smokeFrames is 0;
    var integer: visualSmokeFrames is 0;
    var string: engineMode is "generated";
    var string: dataPath is "";
    var string: startMap is "game/mars_city1";
    var string: generatedAssetRoot is "generated/doom3_seed7";
  end struct;

const type: vec3 is new struct
    var float: x is 0.0;
    var float: y is 0.0;
    var float: z is 0.0;
  end struct;

const type: screenPoint is new struct
    var integer: x is 0;
    var integer: y is 0;
    var float: depth is 0.0;
    var boolean: visible is FALSE;
  end struct;

const type: renderSurface is new struct
    var vec3: a is vec3.value;
    var vec3: b is vec3.value;
    var vec3: c is vec3.value;
    var vec3: d is vec3.value;
    var integer: materialId is 0;
    var integer: detailId is 0;
    var boolean: emissive is FALSE;
    var string: name is "";
  end struct;

const type: renderActor is new struct
    var float: x is 0.0;
    var float: y is 0.0;
    var float: z is 0.0;
    var boolean: alive is TRUE;
    var integer: kind is 1;
    var string: name is "";
  end struct;

const type: engineState is new struct
    var float: camX is 0.0;
    var float: camY is 1.34;
    var float: camZ is -1.45;
    var float: yaw is 0.0;
    var char: lastKey is ' ';
    var integer: health is 100;
    var integer: armor is 32;
    var integer: ammo is 28;
    var integer: shotCooldown is 0;
    var integer: shotFlash is 0;
    var integer: frameNo is 0;
    var boolean: monsterA is TRUE;
    var boolean: monsterB is TRUE;
    var boolean: pickupHealth is FALSE;
    var boolean: pickupAmmo is FALSE;
  end struct;

const type: visualStats is new struct
    var integer: surfacesSubmitted is 0;
    var integer: surfacesProjected is 0;
    var integer: trianglesSubmitted is 0;
    var integer: depthWrites is 0;
    var integer: emissiveSurfaces is 0;
    var integer: textureSamples is 0;
    var integer: lightSamples is 0;
    var integer: actorsSubmitted is 0;
    var integer: actorsVisible is 0;
    var integer: hudElements is 0;
    var integer: entropy is 0;
    var boolean: flatColumnRegression is FALSE;
    var boolean: mainDocumentCanvasExpected is TRUE;
  end struct;

const func vec3: v3 (in float: x, in float: y, in float: z) is func
  result
    var vec3: outVec is vec3.value;
  begin
    outVec.x := x;
    outVec.y := y;
    outVec.z := z;
  end func;

const func renderSurface: surf (in string: name, in vec3: a, in vec3: b,
    in vec3: c, in vec3: d, in integer: materialId, in integer: detailId,
    in boolean: emissive) is func
  result
    var renderSurface: outSurf is renderSurface.value;
  begin
    outSurf.name := name;
    outSurf.a := a;
    outSurf.b := b;
    outSurf.c := c;
    outSurf.d := d;
    outSurf.materialId := materialId;
    outSurf.detailId := detailId;
    outSurf.emissive := emissive;
  end func;

const func renderActor: actor (in string: name, in float: x, in float: y,
    in float: z, in integer: kind) is func
  result
    var renderActor: outActor is renderActor.value;
  begin
    outActor.name := name;
    outActor.x := x;
    outActor.y := y;
    outActor.z := z;
    outActor.kind := kind;
    outActor.alive := TRUE;
  end func;

const func integer: clampInt (in integer: value, in integer: lo,
    in integer: hi) is func
  result
    var integer: outValue is 0;
  begin
    outValue := value;
    if outValue < lo then
      outValue := lo;
    elsif outValue > hi then
      outValue := hi;
    end if;
  end func;

const func color: scaledColor (in color: col, in integer: percent) is func
  result
    var color: outCol is color.value;
  begin
    outCol.redLight   := col.redLight   * percent mdiv 100;
    outCol.greenLight := col.greenLight * percent mdiv 100;
    outCol.blueLight  := col.blueLight  * percent mdiv 100;
  end func;

const func color: materialBase (in integer: materialId) is func
  result
    var color: col is color.value;
  begin
    case materialId of
      when {1}: col := METAL_RED;
      when {2}: col := METAL_GREEN;
      when {3}: col := METAL_BLUE;
      when {4}: col := METAL_GREY;
      when {5}: col := PANEL_BLACK;
      when {6}: col := EMISSIVE_AMBER;
      when {7}: col := EMISSIVE_CYAN;
      otherwise: col := METAL_GREY;
    end case;
  end func;

const func color: litMaterial (in integer: materialId, in integer: detailId,
    in boolean: emissive, in float: depth, in integer: screenX,
    in integer: screenY) is func
  result
    var color: col is color.value;
  local
    var integer: percent is 100;
    var integer: centerDist is 0;
    var integer: texturePulse is 0;
  begin
    col := materialBase(materialId);
    if depth > 24.0 then
      percent := 14;
    elsif depth > 18.0 then
      percent := 22;
    elsif depth > 12.0 then
      percent := 34;
    elsif depth > 7.0 then
      percent := 48;
    elsif depth > 4.0 then
      percent := 66;
    else
      percent := 88;
    end if;
    centerDist := abs(screenX - VIEW_CENTER_X) + abs(screenY - VIEW_CENTER_Y);
    if centerDist < 74 then
      percent +:= 42;
    elsif centerDist < 150 then
      percent +:= 22;
    elsif centerDist < 235 then
      percent +:= 9;
    end if;
    texturePulse := ((screenX * 3 + screenY * 5 + detailId * 17) rem 29);
    if texturePulse < 4 then
      percent +:= 16;
    elsif texturePulse > 24 then
      percent -:= 10;
    end if;
    if emissive then
      percent +:= 46;
    end if;
    percent := clampInt(percent, 8, 142);
    col := scaledColor(col, percent);
  end func;

const proc: drawDigit (in integer: x, in integer: y, in integer: scale,
    in integer: digit, in color: col) is func
  local
    var integer: hWidth is 0;
    var integer: hHeight is 0;
    var integer: vWidth is 0;
    var integer: vHeight is 0;
  begin
    hWidth := scale * 9;
    hHeight := scale * 2;
    vWidth := scale * 2;
    vHeight := scale * 8;
    if digit = 0 or digit = 2 or digit = 3 or digit = 5 or
        digit = 6 or digit = 7 or digit = 8 or digit = 9 then
      rect(x + vWidth, y, hWidth, hHeight, col);
    end if;
    if digit = 0 or digit = 1 or digit = 2 or digit = 3 or
        digit = 4 or digit = 7 or digit = 8 or digit = 9 then
      rect(x + vWidth + hWidth, y + hHeight, vWidth, vHeight, col);
    end if;
    if digit = 0 or digit = 1 or digit = 3 or digit = 4 or
        digit = 5 or digit = 6 or digit = 7 or digit = 8 or digit = 9 then
      rect(x + vWidth + hWidth, y + hHeight * 2 + vHeight,
          vWidth, vHeight, col);
    end if;
    if digit = 0 or digit = 2 or digit = 3 or digit = 5 or
        digit = 6 or digit = 8 or digit = 9 then
      rect(x + vWidth, y + hHeight * 2 + vHeight * 2,
          hWidth, hHeight, col);
    end if;
    if digit = 0 or digit = 2 or digit = 6 or digit = 8 then
      rect(x, y + hHeight * 2 + vHeight, vWidth, vHeight, col);
    end if;
    if digit = 0 or digit = 4 or digit = 5 or digit = 6 or
        digit = 8 or digit = 9 then
      rect(x, y + hHeight, vWidth, vHeight, col);
    end if;
    if digit = 2 or digit = 3 or digit = 4 or digit = 5 or
        digit = 6 or digit = 8 or digit = 9 then
      rect(x + vWidth, y + hHeight + vHeight, hWidth, hHeight, col);
    end if;
  end func;

const proc: drawNumber3 (in integer: value, in integer: x, in integer: y,
    in integer: scale, in color: col) is func
  local
    var integer: shown is 0;
    var integer: spacing is 0;
  begin
    shown := clampInt(value, 0, 999);
    spacing := scale * 17;
    drawDigit(x, y, scale, shown mdiv 100, col);
    drawDigit(x + spacing, y, scale, (shown mdiv 10) rem 10, col);
    drawDigit(x + spacing * 2, y, scale, shown rem 10, col);
  end func;

const proc: drawStatusFace (in engineState: state, in integer: x,
    in integer: y) is func
  local
    var color: faceCol is color.value;
    var color: eyeCol is color.value;
  begin
    faceCol := HUD_FACE;
    eyeCol := HUD_TEXT;
    if state.health < 35 then
      faceCol := scaledColor(HUD_FACE, 66);
      eyeCol := MONSTER_HOT;
    elsif state.shotFlash > 0 then
      eyeCol := EMISSIVE_CYAN;
    end if;
    rect(x, y, 104, 78, scaledColor(HUD_PANEL_LIGHT, 50));
    rect(x + 7, y + 7, 90, 64, HUD_PANEL);
    rect(x + 24, y + 9, 56, 15, WEAPON_DARK);
    rect(x + 18, y + 22, 68, 48, HUD_FACE_DARK);
    rect(x + 24, y + 20, 56, 43, faceCol);
    rect(x + 28, y + 31, 15, 9, WEAPON_DARK);
    rect(x + 61, y + 31, 15, 9, WEAPON_DARK);
    rect(x + 33, y + 34, 6, 4, eyeCol);
    rect(x + 66, y + 34, 6, 4, eyeCol);
    rect(x + 49, y + 38, 7, 15, scaledColor(faceCol, 70));
    if state.health < 35 then
      rect(x + 36, y + 56, 32, 6, MONSTER_HOT);
    elsif state.shotFlash > 0 then
      rect(x + 36, y + 55, 32, 5, HUD_TEXT);
    else
      rect(x + 39, y + 56, 26, 5, HUD_FACE_DARK);
    end if;
    rect(x + 13, y + 23, 9, 39, WEAPON_DARK);
    rect(x + 82, y + 23, 9, 39, WEAPON_DARK);
  end func;

