(********************************************************************)
(*  doom3_seed7_script.s7                                           *)
(*                                                                  *)
(*  Focused Doom 3 / id Tech 4 script binding probe for Seed7.      *)
(*  It reads user-owned pk4 archives, scans script declarations,     *)
(*  resolves entityDef scriptobject values and map call hooks, and   *)
(*  reports readiness for a future game-frame script subset. No      *)
(*  commercial data is bundled.                                      *)
(********************************************************************)

$ include "seed7_05.s7i";
$ include "osfiles.s7i";
$ include "zip.s7i";

const string: DEFAULT_DATA_PATH is ".";
const string: DEFAULT_BASE_DIR is "base";
const string: DEFAULT_START_MAP is "game/mars_city1";

const type: scriptConfig is new struct
    var string: dataPath is DEFAULT_DATA_PATH;
    var string: basePath is "";
    var string: startMap is DEFAULT_START_MAP;
    var boolean: showHelp is FALSE;
  end struct;

const type: scriptStats is new struct
    var integer: pk4Archives is 0;
    var integer: scriptFiles is 0;
    var integer: scriptFunctions is 0;
    var integer: scriptObjects is 0;
    var integer: executableFunctions is 0;
    var integer: scriptPrintEvents is 0;
    var integer: scriptTriggerEvents is 0;
    var integer: scriptWaitEvents is 0;
    var integer: scriptObjectiveEvents is 0;
    var integer: resolvedMapCallEventFunctions is 0;
    var integer: entityDefs is 0;
    var integer: entityScriptObjects is 0;
    var integer: resolvedEntityScriptObjects is 0;
    var integer: missingEntityScriptObjects is 0;
    var integer: mapEntities is 0;
    var integer: mapCallRefs is 0;
    var integer: resolvedMapCallRefs is 0;
    var integer: missingMapCallRefs is 0;
    var boolean: requestedMapFound is FALSE;
    var string: requestedMapPath is "";
    var string: firstScriptFile is "";
    var string: firstScriptFunction is "";
    var string: firstScriptObject is "";
    var string: firstExecutableFunction is "";
    var string: firstScriptEventPath is "";
    var string: firstEntityScriptObject is "";
    var string: firstMissingEntityScriptObject is "";
    var string: firstMapCallRef is "";
    var string: firstMissingMapCallRef is "";
    var array string: scriptFunctionNames is 0 times "";
    var array string: scriptObjectNames is 0 times "";
    var array string: scriptEventFunctionNames is 0 times "";
    var array string: scriptEventPaths is 0 times "";
  end struct;

const proc: logInfo (in string: msg) is func
  begin
    writeln("[script] " <& msg);
  end func;

const proc: logError (in string: msg) is func
  begin
    writeln("[script-error] " <& msg);
  end func;

const func string: joinPath (in string: leftPath, in string: rightPath) is func
  result
    var string: joined is "";
  begin
    if leftPath = "" then
      joined := rightPath;
    elsif endsWith(leftPath, "/") or endsWith(leftPath, "\\") then
      joined := leftPath <& rightPath;
    else
      joined := leftPath <& "/" <& rightPath;
    end if;
  end func;

const func boolean: isPk4Name (in string: fileName) is
    return endsWith(lower(fileName), ".pk4");

const func string: normalizedAssetPath (in string: filePath) is
    return replace(lower(filePath), "\\", "/");

const func string: mapNameToAssetPath (in string: mapName) is func
  result
    var string: assetPath is "";
  begin
    assetPath := normalizedAssetPath(mapName);
    if not startsWith(assetPath, "maps/") then
      assetPath := "maps/" <& assetPath;
    end if;
    if not endsWith(assetPath, ".map") then
      assetPath &:= ".map";
    end if;
  end func;

const func boolean: containsString (in array string: values,
    in string: value) is func
  result
    var boolean: found is FALSE;
  local
    var string: current is "";
  begin
    for current range values do
      if current = value then
        found := TRUE;
      end if;
    end for;
  end func;

const proc: appendUnique (inout array string: values, in string: value) is func
  begin
    if value <> "" and not containsString(values, value) then
      values &:= value;
    end if;
  end func;

const func string: cleanedToken (in string: token) is func
  result
    var string: clean is "";
  local
    var integer: idx is 1;
    var char: ch is ' ';
  begin
    clean := token;
    while idx <= length(clean) do
      ch := clean[idx];
      if ch = '"' or ch = '(' or ch = ')' or ch = '{' or ch = '}' or
          ch = ',' or ch = ';' or ch = ':' then
        clean := clean[.. pred(idx)] & clean[succ(idx) ..];
      else
        incr(idx);
      end if;
    end while;
  end func;

const func string: quotedValueAfter (in string: content, in string: keyName) is func
  result
    var string: value is "";
  local
    var string: keyText is "";
    var integer: keyPos is 0;
    var integer: keyEnd is 0;
    var integer: valueStart is 0;
    var integer: valueEnd is 0;
  begin
    keyText := "\"" <& keyName <& "\"";
    keyPos := pos(lower(content), lower(keyText), 1);
    if keyPos <> 0 then
      keyEnd := pos(content, "\"", succ(keyPos));
      if keyEnd <> 0 then
        valueStart := pos(content, "\"", succ(keyEnd));
        if valueStart <> 0 then
          valueEnd := pos(content, "\"", succ(valueStart));
          if valueEnd <> 0 then
            value := content[succ(valueStart) .. pred(valueEnd)];
          end if;
        end if;
      end if;
    end if;
  end func;

const func integer: matchingBlockEnd (in string: content,
    in integer: blockStart) is func
  result
    var integer: blockEnd is 0;
  local
    var integer: idx is 0;
    var integer: depth is 0;
  begin
    if blockStart <> 0 then
      idx := blockStart;
      while idx <= length(content) and blockEnd = 0 do
        if content[idx] = '{' then
          incr(depth);
        elsif content[idx] = '}' then
          decr(depth);
          if depth = 0 then
            blockEnd := idx;
          end if;
        end if;
        incr(idx);
      end while;
    end if;
  end func;

const func string: eventPathForFunctionBody (in string: functionBody) is func
  result
    var string: eventPath is "";
  local
    var string: bodyLower is "";
  begin
    bodyLower := lower(functionBody);
    if pos(bodyLower, "sys.", 1) <> 0 then
      eventPath &:= "print";
    end if;
    if pos(bodyLower, "trigger", 1) <> 0 or pos(bodyLower, "activate", 1) <> 0 then
      if eventPath <> "" then
        eventPath &:= ">";
      end if;
      eventPath &:= "trigger";
    end if;
    if pos(bodyLower, "wait", 1) <> 0 then
      if eventPath <> "" then
        eventPath &:= ">";
      end if;
      eventPath &:= "wait";
    end if;
    if pos(bodyLower, "objective_complete", 1) <> 0 or
        pos(bodyLower, "completeobjective", 1) <> 0 then
      if eventPath <> "" then
        eventPath &:= ">";
      end if;
      eventPath &:= "objective";
    end if;
  end func;

const func string: eventPathForFunctionName (in scriptStats: stats,
    in string: functionName) is func
  result
    var string: eventPath is "";
  local
    var integer: idx is 1;
  begin
    while idx <= length(stats.scriptEventFunctionNames) and eventPath = "" do
      if stats.scriptEventFunctionNames[idx] = lower(functionName) then
        eventPath := stats.scriptEventPaths[idx];
      end if;
      incr(idx);
    end while;
  end func;

const proc: inspectScriptEventFunctions (inout scriptStats: stats,
    in string: content) is func
  local
    var string: contentLower is "";
    var integer: searchPos is 1;
    var integer: voidPos is 0;
    var integer: nameStart is 0;
    var integer: nameEnd is 0;
    var integer: blockStart is 0;
    var integer: blockEnd is 0;
    var integer: semicolonPos is 0;
    var string: functionName is "";
    var string: functionBody is "";
    var string: eventPath is "";
  begin
    contentLower := lower(content);
    voidPos := pos(contentLower, "void ", searchPos);
    while voidPos <> 0 do
      nameStart := voidPos + length("void ");
      while nameStart <= length(content) and
          (content[nameStart] = ' ' or content[nameStart] = '\t' or
          content[nameStart] = '\n' or content[nameStart] = '\r') do
        incr(nameStart);
      end while;
      nameEnd := nameStart;
      while nameEnd <= length(content) and content[nameEnd] <> ' ' and
          content[nameEnd] <> '\t' and content[nameEnd] <> '\n' and
          content[nameEnd] <> '\r' and content[nameEnd] <> '(' do
        incr(nameEnd);
      end while;
      functionName := cleanedToken(content[nameStart .. pred(nameEnd)]);
      blockStart := pos(content, "{", nameEnd);
      semicolonPos := pos(content, ";", nameEnd);
      if functionName <> "" and blockStart <> 0 and
          (semicolonPos = 0 or blockStart < semicolonPos) then
        blockEnd := matchingBlockEnd(content, blockStart);
        if blockEnd <> 0 then
          functionBody := content[blockStart .. blockEnd];
          eventPath := eventPathForFunctionBody(functionBody);
          if eventPath <> "" then
            stats.executableFunctions +:= 1;
            appendUnique(stats.scriptEventFunctionNames, lower(functionName));
            stats.scriptEventPaths &:= eventPath;
            if stats.firstExecutableFunction = "" then
              stats.firstExecutableFunction := functionName;
              stats.firstScriptEventPath := functionName <& ":" <& eventPath;
            end if;
            if pos(eventPath, "print", 1) <> 0 then
              stats.scriptPrintEvents +:= 1;
            end if;
            if pos(eventPath, "trigger", 1) <> 0 then
              stats.scriptTriggerEvents +:= 1;
            end if;
            if pos(eventPath, "wait", 1) <> 0 then
              stats.scriptWaitEvents +:= 1;
            end if;
            if pos(eventPath, "objective", 1) <> 0 then
              stats.scriptObjectiveEvents +:= 1;
            end if;
          end if;
          searchPos := succ(blockEnd);
        else
          searchPos := nameEnd;
        end if;
      else
        searchPos := nameEnd;
      end if;
      voidPos := pos(contentLower, "void ", searchPos);
    end while;
  end func;

const proc: inspectScriptText (inout scriptStats: stats,
    in string: path, in string: content) is func
  local
    var string: normalizedText is "";
    var array string: tokens is 0 times "";
    var integer: tokenIndex is 1;
    var string: token is "";
    var string: nextToken is "";
  begin
    stats.scriptFiles +:= 1;
    if stats.firstScriptFile = "" then
      stats.firstScriptFile := normalizedAssetPath(path);
    end if;
    normalizedText := replace(content, "\n", " ");
    normalizedText := replace(normalizedText, "\r", " ");
    normalizedText := replace(normalizedText, "\t", " ");
    tokens := noEmptyStrings(split(normalizedText, ' '));
    while tokenIndex < length(tokens) do
      token := lower(cleanedToken(tokens[tokenIndex]));
      nextToken := cleanedToken(tokens[succ(tokenIndex)]);
      if token = "void" and nextToken <> "" then
        stats.scriptFunctions +:= 1;
        appendUnique(stats.scriptFunctionNames, lower(nextToken));
        if stats.firstScriptFunction = "" then
          stats.firstScriptFunction := nextToken;
        end if;
      elsif token = "object" and nextToken <> "" then
        stats.scriptObjects +:= 1;
        appendUnique(stats.scriptObjectNames, lower(nextToken));
        if stats.firstScriptObject = "" then
          stats.firstScriptObject := nextToken;
        end if;
      end if;
      incr(tokenIndex);
    end while;
    inspectScriptEventFunctions(stats, content);
  end func;

const proc: inspectDefText (inout scriptStats: stats,
    in string: content) is func
  local
    var string: contentLower is "";
    var integer: searchPos is 1;
    var integer: defPos is 0;
    var integer: blockStart is 0;
    var integer: blockEnd is 0;
    var string: scriptObject is "";
  begin
    contentLower := lower(content);
    defPos := pos(contentLower, "entitydef ", searchPos);
    while defPos <> 0 do
      stats.entityDefs +:= 1;
      blockStart := pos(content, "{", defPos);
      blockEnd := matchingBlockEnd(content, blockStart);
      if blockStart <> 0 and blockEnd <> 0 then
        scriptObject := quotedValueAfter(content[blockStart .. blockEnd],
            "scriptobject");
        if scriptObject <> "" then
          stats.entityScriptObjects +:= 1;
          if stats.firstEntityScriptObject = "" then
            stats.firstEntityScriptObject := scriptObject;
          end if;
          if containsString(stats.scriptObjectNames, lower(scriptObject)) then
            stats.resolvedEntityScriptObjects +:= 1;
          else
            stats.missingEntityScriptObjects +:= 1;
            if stats.firstMissingEntityScriptObject = "" then
              stats.firstMissingEntityScriptObject := scriptObject;
            end if;
          end if;
        end if;
      end if;
      searchPos := defPos + length("entitydef ");
      defPos := pos(contentLower, "entitydef ", searchPos);
    end while;
  end func;

const proc: inspectMapText (inout scriptStats: stats,
    in string: content) is func
  local
    var integer: searchPos is 1;
    var integer: blockStart is 0;
    var integer: blockEnd is 0;
    var string: callRef is "";
  begin
    blockStart := pos(content, "{", searchPos);
    while blockStart <> 0 do
      blockEnd := matchingBlockEnd(content, blockStart);
      if blockEnd <> 0 then
        stats.mapEntities +:= 1;
        callRef := quotedValueAfter(content[blockStart .. blockEnd], "call");
        if callRef <> "" then
          stats.mapCallRefs +:= 1;
          if stats.firstMapCallRef = "" then
            stats.firstMapCallRef := callRef;
          end if;
          if containsString(stats.scriptFunctionNames, lower(callRef)) then
            stats.resolvedMapCallRefs +:= 1;
            if eventPathForFunctionName(stats, callRef) <> "" then
              stats.resolvedMapCallEventFunctions +:= 1;
            end if;
          else
            stats.missingMapCallRefs +:= 1;
            if stats.firstMissingMapCallRef = "" then
              stats.firstMissingMapCallRef := callRef;
            end if;
          end if;
        end if;
        searchPos := succ(blockEnd);
      else
        searchPos := succ(blockStart);
      end if;
      blockStart := pos(content, "{", searchPos);
    end while;
  end func;

const func array string: findPk4Archives (in string: basePath) is func
  result
    var array string: pk4Files is 0 times "";
  local
    var array string: names is 0 times "";
    var string: name is "";
  begin
    if fileType(basePath) = FILE_DIR then
      names := readDir(basePath);
      for name range names do
        if isPk4Name(name) and fileType(joinPath(basePath, name)) = FILE_REGULAR then
          pk4Files &:= joinPath(basePath, name);
        end if;
      end for;
    end if;
  end func;

const proc: scanArchive (inout scriptStats: stats,
    in string: pk4File, in string: requestedMapPath) is func
  local
    var fileSys: zipFs is fileSys.value;
    var array string: paths is 0 times "";
    var string: path is "";
    var string: pathLower is "";
    var string: content is "";
  begin
    zipFs := openZip(pk4File);
    if zipFs = fileSys.value then
      logError("could not open pk4 archive: " <& pk4File);
    else
      paths := readDir(zipFs, RECURSIVE);
      for path range paths do
        pathLower := normalizedAssetPath(path);
        if endsWith(pathLower, ".script") then
          inspectScriptText(stats, path, getFile(zipFs, path));
        end if;
      end for;
      for path range paths do
        pathLower := normalizedAssetPath(path);
        if endsWith(pathLower, ".def") or endsWith(pathLower, ".decl") then
          inspectDefText(stats, getFile(zipFs, path));
        elsif pathLower = requestedMapPath then
          stats.requestedMapFound := TRUE;
          inspectMapText(stats, getFile(zipFs, path));
        end if;
      end for;
      close(zipFs);
    end if;
  end func;

const proc: parseArgs (inout scriptConfig: config) is func
  local
    var array string: args is 0 times "";
    var integer: argIdx is 1;
  begin
    args := argv(PROGRAM);
    while argIdx <= length(args) do
      if args[argIdx] = "--help" or args[argIdx] = "-h" then
        config.showHelp := TRUE;
      elsif args[argIdx] = "--doom3_data_path" and argIdx < length(args) then
        incr(argIdx);
        config.dataPath := convDosPath(args[argIdx]);
      elsif args[argIdx] = "--doom3_base_path" and argIdx < length(args) then
        incr(argIdx);
        config.basePath := convDosPath(args[argIdx]);
      elsif args[argIdx] = "--doom3_start_map" and argIdx < length(args) then
        incr(argIdx);
        config.startMap := args[argIdx];
      elsif args[argIdx] = "+map" and argIdx < length(args) then
        incr(argIdx);
        config.startMap := args[argIdx];
      elsif args[argIdx] = "+set" and argIdx + 2 <= length(args) then
        if args[argIdx + 1] = "fs_basepath" then
          config.dataPath := convDosPath(args[argIdx + 2]);
        elsif args[argIdx + 1] = "fs_game" then
          config.basePath := convDosPath(args[argIdx + 2]);
        end if;
        argIdx +:= 2;
      end if;
      incr(argIdx);
    end while;
    if config.basePath = "" then
      config.basePath := joinPath(config.dataPath, DEFAULT_BASE_DIR);
    end if;
  end func;

const proc: showUsage is func
  begin
    writeln("Usage:");
    writeln("  s7 doom3_seed7_script.s7 --doom3_data_path <doom3-root>");
    writeln("  s7 doom3_seed7_script.s7 +set fs_basepath <doom3-root> +map <map>");
    writeln("");
    writeln("Scans user-owned Doom 3 pk4 files for script binding readiness.");
  end func;

const proc: printStats (in scriptStats: stats) is func
  begin
    logInfo("pk4_archives=" <& stats.pk4Archives);
    logInfo("requested_map=" <& stats.requestedMapPath);
    logInfo("requested_map_found=" <& stats.requestedMapFound);
    logInfo("script_files=" <& stats.scriptFiles);
    logInfo("script_functions=" <& stats.scriptFunctions <&
        " unique=" <& length(stats.scriptFunctionNames));
    logInfo("script_objects=" <& stats.scriptObjects <&
        " unique=" <& length(stats.scriptObjectNames));
    logInfo("script_events executable_functions=" <&
        stats.executableFunctions <& " print=" <& stats.scriptPrintEvents <&
        " trigger=" <& stats.scriptTriggerEvents <& " wait=" <&
        stats.scriptWaitEvents <& " objective=" <&
        stats.scriptObjectiveEvents);
    logInfo("entity_defs=" <& stats.entityDefs <&
        " scriptobjects=" <& stats.entityScriptObjects);
    logInfo("entity_scriptobject_resolution resolved=" <&
        stats.resolvedEntityScriptObjects <& " missing=" <&
        stats.missingEntityScriptObjects);
    logInfo("map_entities=" <& stats.mapEntities <&
        " call_refs=" <& stats.mapCallRefs);
    logInfo("map_call_resolution resolved=" <&
        stats.resolvedMapCallRefs <& " missing=" <&
        stats.missingMapCallRefs);
    logInfo("map_call_event_resolution executable=" <&
        stats.resolvedMapCallEventFunctions);
    if stats.firstScriptFile <> "" then
      logInfo("first_script_file=" <& stats.firstScriptFile);
    end if;
    if stats.firstScriptFunction <> "" then
      logInfo("first_script_function=" <& stats.firstScriptFunction);
    end if;
    if stats.firstScriptObject <> "" then
      logInfo("first_script_object=" <& stats.firstScriptObject);
    end if;
    if stats.firstExecutableFunction <> "" then
      logInfo("first_executable_function=" <& stats.firstExecutableFunction);
    end if;
    if stats.firstScriptEventPath <> "" then
      logInfo("first_script_event_path=" <& stats.firstScriptEventPath);
    end if;
    if stats.firstEntityScriptObject <> "" then
      logInfo("first_entity_scriptobject=" <& stats.firstEntityScriptObject);
    end if;
    if stats.firstMapCallRef <> "" then
      logInfo("first_map_call_ref=" <& stats.firstMapCallRef);
    end if;
    if stats.firstMissingEntityScriptObject <> "" then
      logInfo("first_missing_entity_scriptobject=" <&
          stats.firstMissingEntityScriptObject);
    end if;
    if stats.firstMissingMapCallRef <> "" then
      logInfo("first_missing_map_call_ref=" <& stats.firstMissingMapCallRef);
    end if;
    logInfo("script_probe_ready=" <& (stats.scriptFunctions <> 0 and
        stats.resolvedEntityScriptObjects <> 0 and
        stats.resolvedMapCallRefs <> 0 and
        stats.resolvedMapCallEventFunctions <> 0));
  end func;

const proc: main is func
  local
    var scriptConfig: config is scriptConfig.value;
    var scriptStats: stats is scriptStats.value;
    var array string: pk4Files is 0 times "";
    var string: pk4File is "";
  begin
    parseArgs(config);
    if config.showHelp then
      showUsage;
    else
      stats.requestedMapPath := mapNameToAssetPath(config.startMap);
      if fileType(config.basePath) <> FILE_DIR then
        logError("Doom 3 base directory not found: " <& config.basePath);
      else
        pk4Files := sort(findPk4Archives(config.basePath));
        stats.pk4Archives := length(pk4Files);
        if length(pk4Files) = 0 then
          logError("No .pk4 archives found in: " <& config.basePath);
        else
          for pk4File range pk4Files do
            scanArchive(stats, pk4File, stats.requestedMapPath);
          end for;
          printStats(stats);
        end if;
      end if;
    end if;
  end func;
