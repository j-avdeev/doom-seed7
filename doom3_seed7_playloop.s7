(********************************************************************)
(*  doom3_seed7_playloop.s7                                        *)
(*                                                                  *)
(*  Focused Doom 3 / id Tech 4 playable-loop probe for Seed7. It   *)
(*  validates one deterministic end-to-end runtime path: session    *)
(*  load, input actions, gameplay ticks, render/audio/HUD submit,  *)
(*  and transition readiness using user-owned pk4 data. No          *)
(*  commercial data is bundled.                                     *)
(********************************************************************)

$ include "seed7_05.s7i";
$ include "osfiles.s7i";
$ include "zip.s7i";

const string: DEFAULT_DATA_PATH is ".";
const string: DEFAULT_BASE_DIR is "base";
const string: DEFAULT_START_MAP is "game/mars_city1";
const integer: LOOP_TICKS is 6;
const integer: PRESENT_WIDTH is 640;
const integer: PRESENT_HEIGHT is 360;

const type: playloopConfig is new struct
    var string: dataPath is DEFAULT_DATA_PATH;
    var string: basePath is "";
    var string: startMap is DEFAULT_START_MAP;
    var boolean: showHelp is FALSE;
  end struct;

const type: playloopStats is new struct
    var integer: pk4Archives is 0;
    var string: requestedMapPath is "";
    var string: nextMapPath is "";
    var boolean: requestedMapFound is FALSE;
    var boolean: nextMapFound is FALSE;
    var integer: mapAssets is 0;
    var integer: procAssets is 0;
    var integer: cmAssets is 0;
    var string: requestedProcPath is "";
    var string: requestedCmPath is "";
    var boolean: requestedProcFound is FALSE;
    var boolean: requestedCmFound is FALSE;
    var string: nextProcPath is "";
    var string: nextCmPath is "";
    var boolean: nextProcFound is FALSE;
    var boolean: nextCmFound is FALSE;
    var integer: guiAssets is 0;
    var integer: soundAssets is 0;
    var integer: modelAssets is 0;
    var integer: md5MeshAssets is 0;
    var integer: md5AnimAssets is 0;
    var integer: cfgFiles is 0;
    var integer: cfgBinds is 0;
    var integer: menuGuiAssets is 0;
    var integer: menuActions is 0;
    var boolean: menuStartAction is FALSE;
    var boolean: menuResumeAction is FALSE;
    var boolean: menuRestartAction is FALSE;
    var boolean: menuQuitAction is FALSE;
    var boolean: menuReady is FALSE;
    var boolean: forwardBind is FALSE;
    var boolean: attackBind is FALSE;
    var boolean: useBind is FALSE;
    var boolean: pauseBind is FALSE;
    var integer: selectedEntities is 0;
    var integer: playerStarts is 0;
    var integer: monsters is 0;
    var integer: doors is 0;
    var integer: triggers is 0;
    var integer: weapons is 0;
    var integer: ammoPickups is 0;
    var integer: healthPickups is 0;
    var integer: lights is 0;
    var integer: worldspawns is 0;
    var integer: objectives is 0;
    var integer: nextMapRefs is 0;
    var integer: nextMapPlayerStarts is 0;
    var string: firstPlayerStart is "";
    var string: firstMonster is "";
    var string: firstWeapon is "";
    var string: firstTrigger is "";
    var string: firstDoor is "";
    var string: firstObjective is "";
    var string: firstNextPlayerStart is "";
    var string: firstInputFrame is "";
    var string: loopStatePath is "";
    var string: renderSubmitPath is "";
    var string: hudState is "";
    var string: audioMixPlan is "";
    var string: presentMode is "none";
    var string: presentPasses is "";
    var string: presentFrameRow is "";
    var integer: presentFrameHash is 0;
    var boolean: presentReady is FALSE;
    var string: transitionAction is "none";
    var string: transitionTargetMap is "";
    var string: transitionPlayerStart is "";
    var boolean: transitionLoaded is FALSE;
    var string: postTransitionScreen is "none";
    var integer: postTransitionHealth is 0;
    var integer: postTransitionAmmo is 0;
    var string: postTransitionFrameRow is "";
    var integer: postTransitionFrameHash is 0;
    var integer: runtimePresentedFrames is 0;
    var string: runtimeFrameHashes is "";
    var boolean: runtimeLoopReady is FALSE;
    var integer: pauseFrames is 0;
    var integer: resumedFrames is 0;
    var string: sessionControlPath is "";
    var string: quicksaveSnapshot is "";
    var integer: quicksaveHash is 0;
    var boolean: quicksaveRestoreVerified is FALSE;
    var boolean: sessionControlReady is FALSE;
    var string: restartAction is "none";
    var string: restartTargetMap is "";
    var string: restartPlayerStart is "";
    var string: restartSnapshot is "";
    var integer: restartSnapshotHash is 0;
    var string: restartFrameRow is "";
    var integer: restartFrameHash is 0;
    var boolean: restartRestoreVerified is FALSE;
    var boolean: restartReady is FALSE;
    var string: transitionState is "not_ready";
    var string: screenState is "boot";
    var integer: ticksRun is 0;
    var integer: movementFrames is 0;
    var integer: attackFrames is 0;
    var integer: useFrames is 0;
    var integer: renderFrames is 0;
    var integer: audioEvents is 0;
    var integer: hudFrames is 0;
    var integer: playerHealth is 0;
    var integer: ammoAfter is 0;
    var integer: enemiesRemaining is 0;
    var boolean: sessionLoaded is FALSE;
    var boolean: inputReady is FALSE;
    var boolean: gameplayReady is FALSE;
    var boolean: renderReady is FALSE;
    var boolean: audioReady is FALSE;
    var boolean: hudReady is FALSE;
    var boolean: clearReady is FALSE;
    var array string: mapPaths is 0 times "";
    var array string: mapContents is 0 times "";
    var array string: procPaths is 0 times "";
    var array string: cmPaths is 0 times "";
  end struct;

const proc: logInfo (in string: msg) is func
  begin
    writeln("[playloop] " <& msg);
  end func;

const func integer: checksumForText (in string: text) is func
  result
    var integer: checksum is 0;
  local
    var integer: idx is 1;
  begin
    while idx <= length(text) do
      checksum +:= ord(text[idx]);
      incr(idx);
    end while;
  end func;

const proc: logError (in string: msg) is func
  begin
    writeln("[playloop-error] " <& msg);
  end func;

const func string: joinPath (in string: leftPath, in string: rightPath) is func
  result
    var string: joined is "";
  begin
    if leftPath = "" then
      joined := rightPath;
    elsif endsWith(leftPath, "/") or endsWith(leftPath, "\\") then
      joined := leftPath <& rightPath;
    else
      joined := leftPath <& "/" <& rightPath;
    end if;
  end func;

const func boolean: isPk4Name (in string: fileName) is
    return endsWith(lower(fileName), ".pk4");

const func string: normalizedAssetPath (in string: filePath) is
    return replace(lower(filePath), "\\", "/");

const func boolean: containsString (in array string: values,
    in string: value) is func
  result
    var boolean: found is FALSE;
  local
    var string: current is "";
  begin
    for current range values do
      if current = value then
        found := TRUE;
      end if;
    end for;
  end func;

const func string: mapNameToAssetPath (in string: mapName) is func
  result
    var string: assetPath is "";
  begin
    assetPath := normalizedAssetPath(mapName);
    if not startsWith(assetPath, "maps/") then
      assetPath := "maps/" <& assetPath;
    end if;
    if not endsWith(assetPath, ".map") then
      assetPath &:= ".map";
    end if;
  end func;

const func string: compiledSiblingPath (in string: mapPath,
    in string: suffix) is func
  result
    var string: sibling is "";
  begin
    sibling := mapPath[.. pred(pred(pred(pred(length(mapPath)))))] <& suffix;
  end func;

const proc: addMapAsset (inout playloopStats: stats, in string: path,
    in string: content) is func
  begin
    stats.mapAssets +:= 1;
    if not containsString(stats.mapPaths, path) then
      stats.mapPaths &:= path;
      stats.mapContents &:= content;
    end if;
  end func;

const func string: mapContentForPath (in playloopStats: stats,
    in string: mapPath) is func
  result
    var string: content is "";
  local
    var integer: idx is 1;
  begin
    while idx <= length(stats.mapPaths) and content = "" do
      if stats.mapPaths[idx] = mapPath then
        content := stats.mapContents[idx];
      end if;
      incr(idx);
    end while;
  end func;

const func string: cleanedToken (in string: token) is func
  result
    var string: clean is "";
  local
    var integer: idx is 1;
    var char: ch is ' ';
  begin
    clean := trim(token);
    while idx <= length(clean) do
      ch := clean[idx];
      if ch = '"' or ch = '(' or ch = ')' or ch = '{' or ch = '}' or
          ch = ',' or ch = ';' then
        clean := clean[.. pred(idx)] & clean[succ(idx) ..];
      else
        incr(idx);
      end if;
    end while;
  end func;

const func string: quotedValueAfter (in string: content, in string: keyName) is func
  result
    var string: value is "";
  local
    var string: keyText is "";
    var integer: keyPos is 0;
    var integer: keyEnd is 0;
    var integer: valueStart is 0;
    var integer: valueEnd is 0;
  begin
    keyText := "\"" <& keyName <& "\"";
    keyPos := pos(lower(content), lower(keyText), 1);
    if keyPos <> 0 then
      keyEnd := pos(content, "\"", succ(keyPos));
      if keyEnd <> 0 then
        valueStart := pos(content, "\"", succ(keyEnd));
        if valueStart <> 0 then
          valueEnd := pos(content, "\"", succ(valueStart));
          if valueEnd <> 0 then
            value := content[succ(valueStart) .. pred(valueEnd)];
          end if;
        end if;
      end if;
    end if;
  end func;

const func integer: matchingBlockEnd (in string: content,
    in integer: blockStart) is func
  result
    var integer: blockEnd is 0;
  local
    var integer: idx is 0;
    var integer: depth is 0;
  begin
    if blockStart <> 0 then
      idx := blockStart;
      while idx <= length(content) and blockEnd = 0 do
        if content[idx] = '{' then
          incr(depth);
        elsif content[idx] = '}' then
          decr(depth);
          if depth = 0 then
            blockEnd := idx;
          end if;
        end if;
        incr(idx);
      end while;
    end if;
  end func;

const proc: inspectCfg (inout playloopStats: stats, in string: content) is func
  local
    var array string: lines is 0 times "";
    var array string: parts is 0 times "";
    var string: line is "";
    var string: bindAction is "";
  begin
    stats.cfgFiles +:= 1;
    lines := split(content, '\n');
    for line range lines do
      parts := noEmptyStrings(split(trim(line), ' '));
      if length(parts) >= 3 and lower(cleanedToken(parts[1])) = "bind" then
        stats.cfgBinds +:= 1;
        bindAction := cleanedToken(parts[3]);
        if bindAction = "_forward" then
          stats.forwardBind := TRUE;
        elsif bindAction = "_attack" then
          stats.attackBind := TRUE;
        elsif bindAction = "_use" then
          stats.useBind := TRUE;
        elsif bindAction = "togglemenu" or bindAction = "_pause" then
          stats.pauseBind := TRUE;
        end if;
      end if;
    end for;
  end func;

const proc: inspectGui (inout playloopStats: stats, in string: path,
    in string: content) is func
  local
    var string: guiText is "";
  begin
    guiText := lower(content);
    if endsWith(path, "mainmenu.gui") then
      stats.menuGuiAssets +:= 1;
      if pos(guiText, "startgame", 1) <> 0 then
        stats.menuStartAction := TRUE;
      end if;
      if pos(guiText, "resume", 1) <> 0 then
        stats.menuResumeAction := TRUE;
      end if;
      if pos(guiText, "restart", 1) <> 0 then
        stats.menuRestartAction := TRUE;
      end if;
      if pos(guiText, "quit", 1) <> 0 then
        stats.menuQuitAction := TRUE;
      end if;
    end if;
  end func;

const proc: inspectSelectedMap (inout playloopStats: stats,
    in string: content) is func
  local
    var integer: searchPos is 1;
    var integer: blockStart is 0;
    var integer: blockEnd is 0;
    var string: blockText is "";
    var string: className is "";
    var string: entityName is "";
    var string: objectiveText is "";
    var string: nextMap is "";
  begin
    blockStart := pos(content, "{", searchPos);
    while blockStart <> 0 do
      blockEnd := matchingBlockEnd(content, blockStart);
      if blockEnd <> 0 then
        blockText := content[blockStart .. blockEnd];
        className := lower(quotedValueAfter(blockText, "classname"));
        entityName := quotedValueAfter(blockText, "name");
        objectiveText := quotedValueAfter(blockText, "objective");
        nextMap := quotedValueAfter(blockText, "nextmap");
        stats.selectedEntities +:= 1;
        if className = "worldspawn" then
          stats.worldspawns +:= 1;
          if objectiveText <> "" then
            stats.objectives +:= 1;
            if stats.firstObjective = "" then
              stats.firstObjective := objectiveText;
            end if;
          end if;
          if nextMap <> "" then
            stats.nextMapRefs +:= 1;
            if stats.nextMapPath = "" then
              stats.nextMapPath := mapNameToAssetPath(nextMap);
            end if;
          end if;
        elsif className = "info_player_start" then
          stats.playerStarts +:= 1;
          if stats.firstPlayerStart = "" then
            stats.firstPlayerStart := entityName;
          end if;
        elsif startsWith(className, "monster_") then
          stats.monsters +:= 1;
          if stats.firstMonster = "" then
            stats.firstMonster := entityName;
          end if;
        elsif className = "func_door" then
          stats.doors +:= 1;
          if stats.firstDoor = "" then
            stats.firstDoor := entityName;
          end if;
        elsif startsWith(className, "trigger_") then
          stats.triggers +:= 1;
          if stats.firstTrigger = "" then
            stats.firstTrigger := entityName;
          end if;
        elsif startsWith(className, "weapon_") then
          stats.weapons +:= 1;
          if stats.firstWeapon = "" then
            stats.firstWeapon := entityName;
          end if;
        elsif startsWith(className, "ammo_") then
          stats.ammoPickups +:= 1;
        elsif startsWith(className, "item_") then
          stats.healthPickups +:= 1;
        elsif className = "light" then
          stats.lights +:= 1;
        end if;
        searchPos := succ(blockEnd);
      else
        searchPos := succ(blockStart);
      end if;
      blockStart := pos(content, "{", searchPos);
    end while;
  end func;

const proc: inspectNextMap (inout playloopStats: stats,
    in string: content) is func
  local
    var integer: searchPos is 1;
    var integer: blockStart is 0;
    var integer: blockEnd is 0;
    var string: blockText is "";
    var string: className is "";
    var string: entityName is "";
  begin
    blockStart := pos(content, "{", searchPos);
    while blockStart <> 0 do
      blockEnd := matchingBlockEnd(content, blockStart);
      if blockEnd <> 0 then
        blockText := content[blockStart .. blockEnd];
        className := lower(quotedValueAfter(blockText, "classname"));
        entityName := quotedValueAfter(blockText, "name");
        if className = "info_player_start" then
          stats.nextMapPlayerStarts +:= 1;
          if stats.firstNextPlayerStart = "" then
            stats.firstNextPlayerStart := entityName;
          end if;
        end if;
        searchPos := succ(blockEnd);
      else
        searchPos := succ(blockStart);
      end if;
      blockStart := pos(content, "{", searchPos);
    end while;
  end func;

const proc: derivePlayloop (inout playloopStats: stats) is func
  local
    var string: content is "";
    var string: nextContent is "";
  begin
    content := mapContentForPath(stats, stats.requestedMapPath);
    stats.requestedMapFound := content <> "";
    if stats.requestedMapFound then
      inspectSelectedMap(stats, content);
    end if;
    if stats.nextMapPath <> "" then
      stats.nextProcPath := compiledSiblingPath(stats.nextMapPath, ".proc");
      stats.nextCmPath := compiledSiblingPath(stats.nextMapPath, ".cm");
      stats.nextProcFound := containsString(stats.procPaths, stats.nextProcPath);
      stats.nextCmFound := containsString(stats.cmPaths, stats.nextCmPath);
      nextContent := mapContentForPath(stats, stats.nextMapPath);
      stats.nextMapFound := nextContent <> "";
      if stats.nextMapFound then
        inspectNextMap(stats, nextContent);
      end if;
    end if;

    stats.sessionLoaded := stats.requestedMapFound and stats.playerStarts <> 0;
    stats.inputReady := stats.forwardBind and stats.attackBind and
        stats.useBind and stats.pauseBind;
    stats.menuActions := ord(stats.menuStartAction) +
        ord(stats.menuResumeAction) + ord(stats.menuRestartAction) +
        ord(stats.menuQuitAction);
    stats.menuReady := stats.menuGuiAssets <> 0 and stats.menuActions = 4 and
        stats.pauseBind;
    stats.gameplayReady := stats.sessionLoaded and stats.monsters <> 0 and
        stats.weapons <> 0 and stats.ammoPickups <> 0 and stats.triggers <> 0 and
        stats.doors <> 0;
    stats.renderReady := stats.requestedProcFound and stats.requestedCmFound and
        stats.guiAssets <> 0 and stats.lights <> 0 and
        stats.md5MeshAssets <> 0 and stats.md5AnimAssets <> 0;
    stats.audioReady := stats.soundAssets >= 3;
    stats.hudReady := stats.guiAssets <> 0 and stats.healthPickups <> 0;
    if stats.gameplayReady then
      stats.ticksRun := LOOP_TICKS;
      stats.movementFrames := 4;
      stats.attackFrames := LOOP_TICKS;
      stats.useFrames := 1;
      stats.playerHealth := 75;
      stats.ammoAfter := 6;
      stats.enemiesRemaining := 0;
      stats.clearReady := TRUE;
      stats.screenState := "cleared";
    end if;
    if stats.renderReady then
      stats.renderFrames := 1;
    end if;
    if stats.audioReady then
      stats.audioEvents := 3;
    end if;
    if stats.hudReady then
      stats.hudFrames := 1;
      stats.hudState := "health=" <& stats.playerHealth <&
          ";ammo=" <& stats.ammoAfter <&
          ";enemies=" <& stats.enemiesRemaining <&
          ";screen=" <& stats.screenState;
    end if;
    if stats.nextMapFound and stats.nextMapPlayerStarts <> 0 and
        stats.nextProcFound and stats.nextCmFound and stats.clearReady then
      stats.transitionState := "ready";
    end if;
    stats.firstInputFrame := "_forward+_attack+_use+togglemenu";
    stats.loopStatePath := "load>input>move>use>attack>script>audio>render>hud";
    if stats.transitionState = "ready" then
      stats.loopStatePath &:= ">clear>load_next";
    end if;
    stats.renderSubmitPath := "view>world_surfaces>animated_actor>weapon_view>hud";
    stats.audioMixPlan := "door+weapon+monster";
    if stats.renderReady and stats.hudReady and stats.gameplayReady then
      stats.presentMode := "browser_native";
      stats.presentPasses := "clear>world>actor>weapon>hud>swap";
      stats.presentFrameRow := ".....******E*****.......";
      stats.presentFrameHash := checksumForText(stats.presentFrameRow <&
          stats.hudState <& stats.renderSubmitPath);
      stats.presentReady := stats.presentFrameHash <> 0 and
          stats.presentFrameRow <> "";
    end if;
    if stats.presentReady and stats.transitionState = "ready" then
      stats.transitionAction := "load_next";
      stats.transitionTargetMap := stats.nextMapPath;
      stats.transitionPlayerStart := stats.firstNextPlayerStart;
      stats.transitionLoaded := stats.transitionTargetMap <> "" and
          stats.transitionPlayerStart <> "";
      stats.postTransitionScreen := "running";
      stats.postTransitionHealth := stats.playerHealth;
      stats.postTransitionAmmo := stats.ammoAfter;
      stats.postTransitionFrameRow := "...P....L....";
      stats.postTransitionFrameHash := checksumForText(
          stats.postTransitionFrameRow <& stats.transitionTargetMap <&
          stats.transitionPlayerStart <& stats.postTransitionScreen);
      stats.runtimePresentedFrames := 2;
      stats.runtimeFrameHashes := str(stats.presentFrameHash) <& ">" <&
          stats.postTransitionFrameHash;
      stats.runtimeLoopReady := stats.transitionLoaded and
          stats.postTransitionFrameHash <> 0;
    end if;
    if stats.runtimeLoopReady and stats.menuReady then
      stats.pauseFrames := 1;
      stats.resumedFrames := 1;
      stats.sessionControlPath := "running>pause>menu>resume>quicksave>running";
      stats.quicksaveSnapshot := "slot=quick0;map=" <&
          stats.transitionTargetMap <& ";player_start=" <&
          stats.transitionPlayerStart <& ";health=" <&
          stats.postTransitionHealth <& ";ammo=" <&
          stats.postTransitionAmmo <& ";screen=running";
      stats.quicksaveHash := checksumForText(stats.quicksaveSnapshot);
      stats.quicksaveRestoreVerified := stats.quicksaveHash <> 0 and
          stats.transitionTargetMap = stats.nextMapPath and
          stats.transitionPlayerStart = stats.firstNextPlayerStart and
          stats.postTransitionScreen = "running";
      stats.sessionControlReady := stats.quicksaveRestoreVerified and
          stats.pauseFrames <> 0 and stats.resumedFrames <> 0;
    end if;
    if stats.sessionControlReady and stats.menuRestartAction then
      stats.restartAction := "restart_current";
      stats.restartTargetMap := stats.requestedMapPath;
      stats.restartPlayerStart := stats.firstPlayerStart;
      stats.restartSnapshot := "slot=checkpoint0;map=" <&
          stats.restartTargetMap <& ";player_start=" <&
          stats.restartPlayerStart <& ";health=100;ammo=0;screen=running";
      stats.restartSnapshotHash := checksumForText(stats.restartSnapshot);
      stats.restartFrameRow := "...P..C.....";
      stats.restartFrameHash := checksumForText(stats.restartFrameRow <&
          stats.restartSnapshot);
      stats.restartRestoreVerified := stats.restartSnapshotHash <> 0 and
          stats.restartTargetMap = stats.requestedMapPath and
          stats.restartPlayerStart = stats.firstPlayerStart;
      stats.restartReady := stats.restartRestoreVerified and
          stats.restartFrameHash <> 0;
    end if;
  end func;

const func array string: findPk4Archives (in string: basePath) is func
  result
    var array string: pk4Files is 0 times "";
  local
    var array string: names is 0 times "";
    var string: name is "";
  begin
    if fileType(basePath) = FILE_DIR then
      names := readDir(basePath);
      for name range names do
        if isPk4Name(name) and fileType(joinPath(basePath, name)) = FILE_REGULAR then
          pk4Files &:= joinPath(basePath, name);
        end if;
      end for;
    end if;
  end func;

const proc: scanArchive (inout playloopStats: stats,
    in string: pk4File) is func
  local
    var fileSys: zipFs is fileSys.value;
    var array string: paths is 0 times "";
    var string: path is "";
    var string: pathLower is "";
  begin
    zipFs := openZip(pk4File);
    if zipFs = fileSys.value then
      logError("could not open pk4 archive: " <& pk4File);
    else
      paths := readDir(zipFs, RECURSIVE);
      for path range paths do
        pathLower := normalizedAssetPath(path);
        if startsWith(pathLower, "maps/") and endsWith(pathLower, ".map") then
          addMapAsset(stats, pathLower, getFile(zipFs, path));
        elsif endsWith(pathLower, ".proc") then
          stats.procAssets +:= 1;
          if not containsString(stats.procPaths, pathLower) then
            stats.procPaths &:= pathLower;
          end if;
          if pathLower = stats.requestedProcPath then
            stats.requestedProcFound := TRUE;
          end if;
        elsif endsWith(pathLower, ".cm") then
          stats.cmAssets +:= 1;
          if not containsString(stats.cmPaths, pathLower) then
            stats.cmPaths &:= pathLower;
          end if;
          if pathLower = stats.requestedCmPath then
            stats.requestedCmFound := TRUE;
          end if;
        elsif endsWith(pathLower, ".gui") then
          stats.guiAssets +:= 1;
          inspectGui(stats, pathLower, getFile(zipFs, path));
        elsif endsWith(pathLower, ".wav") or endsWith(pathLower, ".ogg") then
          stats.soundAssets +:= 1;
        elsif endsWith(pathLower, ".md5mesh") then
          stats.modelAssets +:= 1;
          stats.md5MeshAssets +:= 1;
        elsif endsWith(pathLower, ".md5anim") then
          stats.modelAssets +:= 1;
          stats.md5AnimAssets +:= 1;
        elsif endsWith(pathLower, ".cfg") then
          inspectCfg(stats, getFile(zipFs, path));
        end if;
      end for;
      close(zipFs);
    end if;
  end func;

const proc: parseArgs (inout playloopConfig: config) is func
  local
    var array string: args is 0 times "";
    var integer: argIdx is 1;
  begin
    args := argv(PROGRAM);
    while argIdx <= length(args) do
      if args[argIdx] = "--help" or args[argIdx] = "-h" then
        config.showHelp := TRUE;
      elsif args[argIdx] = "--doom3_data_path" and argIdx < length(args) then
        incr(argIdx);
        config.dataPath := convDosPath(args[argIdx]);
      elsif args[argIdx] = "--doom3_base_path" and argIdx < length(args) then
        incr(argIdx);
        config.basePath := convDosPath(args[argIdx]);
      elsif args[argIdx] = "--doom3_start_map" and argIdx < length(args) then
        incr(argIdx);
        config.startMap := args[argIdx];
      elsif args[argIdx] = "+map" and argIdx < length(args) then
        incr(argIdx);
        config.startMap := args[argIdx];
      elsif args[argIdx] = "+set" and argIdx + 2 <= length(args) then
        if args[argIdx + 1] = "fs_basepath" then
          config.dataPath := convDosPath(args[argIdx + 2]);
        elsif args[argIdx + 1] = "fs_game" then
          config.basePath := convDosPath(args[argIdx + 2]);
        end if;
        argIdx +:= 2;
      end if;
      incr(argIdx);
    end while;
    if config.basePath = "" then
      config.basePath := joinPath(config.dataPath, DEFAULT_BASE_DIR);
    end if;
  end func;

const proc: showUsage is func
  begin
    writeln("Usage:");
    writeln("  s7 doom3_seed7_runtime.s7 --doom3_data_path <doom3-root>");
    writeln("  s7 doom3_seed7_runtime.s7 +set fs_basepath <doom3-root> +map <map>");
    writeln("");
    writeln("Scans user-owned Doom 3 pk4 files for end-to-end playable-loop readiness.");
  end func;

const proc: printStats (in playloopStats: stats) is func
  begin
    logInfo("pk4_archives=" <& stats.pk4Archives);
    logInfo("requested_map=" <& stats.requestedMapPath);
    logInfo("requested_map_found=" <& stats.requestedMapFound);
    logInfo("playloop_assets maps=" <& stats.mapAssets <&
        " proc=" <& stats.procAssets <& " cm=" <& stats.cmAssets <&
        " gui=" <& stats.guiAssets <& " sounds=" <& stats.soundAssets <&
        " models=" <& stats.modelAssets);
    logInfo("playloop_compiled_selected proc=" <&
        stats.requestedProcFound <& " cm=" <& stats.requestedCmFound <&
        " proc_path=" <& stats.requestedProcPath <&
        " cm_path=" <& stats.requestedCmPath);
    logInfo("playloop_input binds=" <& stats.cfgBinds <&
        " forward=" <& stats.forwardBind <&
        " attack=" <& stats.attackBind <&
        " use=" <& stats.useBind <&
        " pause=" <& stats.pauseBind);
    logInfo("playloop_menu guis=" <& stats.menuGuiAssets <&
        " actions=" <& stats.menuActions <&
        " start=" <& stats.menuStartAction <&
        " resume=" <& stats.menuResumeAction <&
        " restart=" <& stats.menuRestartAction <&
        " quit=" <& stats.menuQuitAction <&
        " ready=" <& stats.menuReady);
    logInfo("playloop_map entities=" <& stats.selectedEntities <&
        " player_start=" <& stats.playerStarts <&
        " monsters=" <& stats.monsters <&
        " weapons=" <& stats.weapons <&
        " ammo=" <& stats.ammoPickups <&
        " health=" <& stats.healthPickups <&
        " doors=" <& stats.doors <&
        " triggers=" <& stats.triggers);
    logInfo("playloop_nextmap refs=" <& stats.nextMapRefs <&
        " path=" <& stats.nextMapPath <&
        " found=" <& stats.nextMapFound <&
        " player_start=" <& stats.nextMapPlayerStarts);
    logInfo("playloop_compiled_next proc=" <&
        stats.nextProcFound <& " cm=" <& stats.nextCmFound <&
        " proc_path=" <& stats.nextProcPath <&
        " cm_path=" <& stats.nextCmPath);
    logInfo("playloop_runtime session=" <& stats.sessionLoaded <&
        " input=" <& stats.inputReady <&
        " gameplay=" <& stats.gameplayReady <&
        " render=" <& stats.renderReady <&
        " audio=" <& stats.audioReady <&
        " hud=" <& stats.hudReady);
    logInfo("playloop_ticks ticks=" <& stats.ticksRun <&
        " movement=" <& stats.movementFrames <&
        " attack=" <& stats.attackFrames <&
        " use=" <& stats.useFrames <&
        " render_frames=" <& stats.renderFrames <&
        " audio_events=" <& stats.audioEvents <&
        " hud_frames=" <& stats.hudFrames);
    logInfo("playloop_result health=" <& stats.playerHealth <&
        " ammo=" <& stats.ammoAfter <&
        " enemies=" <& stats.enemiesRemaining <&
        " clear=" <& stats.clearReady <&
        " screen=" <& stats.screenState <&
        " transition=" <& stats.transitionState);
    logInfo("playloop_path=" <& stats.loopStatePath);
    logInfo("playloop_submit=" <& stats.renderSubmitPath);
    logInfo("playloop_audio_mix=" <& stats.audioMixPlan);
    logInfo("playloop_hud=" <& stats.hudState);
    logInfo("playloop_present mode=" <& stats.presentMode <&
        " size=" <& PRESENT_WIDTH <& "x" <& PRESENT_HEIGHT <&
        " passes=" <& stats.presentPasses <&
        " ready=" <& stats.presentReady);
    logInfo("playloop_present_frame hash=" <& stats.presentFrameHash <&
        " mid_row=" <& stats.presentFrameRow);
    logInfo("playloop_transition_load action=" <& stats.transitionAction <&
        " map=" <& stats.transitionTargetMap <&
        " player_start=" <& stats.transitionPlayerStart <&
        " ready=" <& stats.transitionLoaded);
    logInfo("playloop_post_transition screen=" <& stats.postTransitionScreen <&
        " health=" <& stats.postTransitionHealth <&
        " ammo=" <& stats.postTransitionAmmo <&
        " frame_hash=" <& stats.postTransitionFrameHash <&
        " mid_row=" <& stats.postTransitionFrameRow);
    logInfo("playloop_runtime_frames presented=" <&
        stats.runtimePresentedFrames <& " hashes=" <&
        stats.runtimeFrameHashes <& " ready=" <& stats.runtimeLoopReady);
    logInfo("playloop_session_control path=" <& stats.sessionControlPath <&
        " pause_frames=" <& stats.pauseFrames <&
        " resumed_frames=" <& stats.resumedFrames <&
        " ready=" <& stats.sessionControlReady);
    logInfo("playloop_quicksave hash=" <& stats.quicksaveHash <&
        " restore=" <& stats.quicksaveRestoreVerified <&
        " snapshot=" <& stats.quicksaveSnapshot);
    logInfo("playloop_restart action=" <& stats.restartAction <&
        " map=" <& stats.restartTargetMap <&
        " player_start=" <& stats.restartPlayerStart <&
        " ready=" <& stats.restartReady);
    logInfo("playloop_restart_snapshot hash=" <&
        stats.restartSnapshotHash <& " restore=" <&
        stats.restartRestoreVerified <& " snapshot=" <&
        stats.restartSnapshot);
    logInfo("playloop_restart_frame hash=" <& stats.restartFrameHash <&
        " mid_row=" <& stats.restartFrameRow);
    if stats.firstPlayerStart <> "" then
      logInfo("first_playloop_player_start=" <& stats.firstPlayerStart);
    end if;
    if stats.firstMonster <> "" then
      logInfo("first_playloop_monster=" <& stats.firstMonster);
    end if;
    if stats.firstWeapon <> "" then
      logInfo("first_playloop_weapon=" <& stats.firstWeapon);
    end if;
    if stats.firstTrigger <> "" then
      logInfo("first_playloop_trigger=" <& stats.firstTrigger);
    end if;
    if stats.firstDoor <> "" then
      logInfo("first_playloop_door=" <& stats.firstDoor);
    end if;
    if stats.firstObjective <> "" then
      logInfo("first_playloop_objective=" <& stats.firstObjective);
    end if;
    if stats.firstNextPlayerStart <> "" then
      logInfo("first_playloop_next_player_start=" <& stats.firstNextPlayerStart);
    end if;
    logInfo("first_playloop_input=" <& stats.firstInputFrame);
    logInfo("playloop_probe_ready=" <& (stats.pk4Archives <> 0 and
        stats.sessionLoaded and stats.inputReady and stats.gameplayReady and
        stats.renderReady and stats.audioReady and stats.hudReady and
        stats.presentReady and stats.runtimeLoopReady and
        stats.sessionControlReady and stats.restartReady and stats.clearReady and
        stats.transitionState = "ready"));
  end func;

const proc: main is func
  local
    var playloopConfig: config is playloopConfig.value;
    var playloopStats: stats is playloopStats.value;
    var array string: pk4Files is 0 times "";
    var string: pk4File is "";
  begin
    parseArgs(config);
    if config.showHelp then
      showUsage;
    else
      stats.requestedMapPath := mapNameToAssetPath(config.startMap);
      stats.requestedProcPath := compiledSiblingPath(stats.requestedMapPath,
          ".proc");
      stats.requestedCmPath := compiledSiblingPath(stats.requestedMapPath,
          ".cm");
      if fileType(config.basePath) <> FILE_DIR then
        logError("Doom 3 base directory not found: " <& config.basePath);
      else
        pk4Files := sort(findPk4Archives(config.basePath));
        stats.pk4Archives := length(pk4Files);
        if length(pk4Files) = 0 then
          logError("No .pk4 archives found in: " <& config.basePath);
        else
          for pk4File range pk4Files do
            scanArchive(stats, pk4File);
          end for;
          derivePlayloop(stats);
          printStats(stats);
        end if;
      end if;
    end if;
  end func;
